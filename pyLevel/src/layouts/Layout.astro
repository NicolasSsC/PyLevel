---
import Navbar from '../components/Navbar.astro';
import '../styles/theme.css';
import '../styles/global.css';

interface Props {
  title?: string;
  hideNavbar?: boolean;
  description?: string;
}

const {
  title = 'Ejercicios · PyLevel',
  hideNavbar = false,
  description = 'Explora proyectos Python, corrige errores y comprueba tus soluciones con pruebas.',
} = Astro.props;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Inline theme script to prevent Flash of Unstyled Content (FOUC) -->
		<script is:inline>
			(() => {
				const savedTheme = localStorage.getItem('pylevel-theme');
				const theme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				const root = document.documentElement;
				root.setAttribute('data-theme', theme);
				if (theme === 'dark') {
					root.classList.add('dark');
				} else {
					root.classList.remove('dark');
				}
			})();
		</script>
	</head>
	<body>
		{!hideNavbar && <Navbar />}
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
