---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { currentUser } from '../../lib/session';
import { getDbExercises } from '../../lib/exercises-db';

const user = await currentUser(Astro.cookies);
const isAuthorized = user && user.role === 'admin';

const allExercises = isAuthorized ? await getDbExercises({ onlyActive: false }) : [];
const classicCount = allExercises.filter(e => e.mode === 'classic').length;
const contextualCount = allExercises.filter(e => e.mode === 'contextual').length;
const activeCount = allExercises.filter(e => e.is_active).length;
const inactiveCount = allExercises.filter(e => !e.is_active).length;
---

<Layout title="Panel Administrativo de Ejercicios · PyLevel">
  {!isAuthorized ? (
    <main class="admin-unauthorized">
      <div class="unauth-card">
        <div class="unauth-icon">
          <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h1>Acceso Restringido</h1>
        <p>Este panel es exclusivo para administradores de PyLevel.</p>
        {user ? (
          <div class="user-info-box">
            <p>Has iniciado sesión como <strong>{user.email}</strong>, pero tu cuenta no cuenta con rol de administrador.</p>
            <p class="hint-text">Si eres el administrador o desarrollador principal, inicia sesión con la cuenta administradora autorizada o solicita asignación de rol.</p>
          </div>
        ) : (
          <div class="user-info-box">
            <p>Debes iniciar sesión con una cuenta de administrador para acceder a esta sección.</p>
          </div>
        )}
        <div class="unauth-actions">
          <a href="/login?role=admin&redirect=/admin/" class="btn-primary">Iniciar sesión como admin</a>
          <a href="/" class="btn-secondary">Volver al Inicio</a>
        </div>
      </div>
    </main>
  ) : (
    <main class="admin-page">
      <!-- Encabezado del Panel -->
      <header class="admin-header">
        <div class="header-breadcrumb">
          <a href="/" class="back-link">← Volver al inicio</a>
          <span class="sep">/</span>
          <span class="current">Administración</span>
        </div>
        <div class="header-main-row">
          <div>
            <div class="admin-badge">PANEL DE CONTROL ADMINISTRATIVO</div>
            <h1 class="admin-title">Gestión de Ejercicios y Retos</h1>
            <p class="admin-subtitle">Crea, edita, desactiva o elimina desafíos clásicos y proyectos multi-archivo en tiempo real.</p>
          </div>
          <div class="header-actions">
            <a href="/manuales/" class="btn-outline-manual">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
              <span>Ver Manuales</span>
            </a>
            <button type="button" id="btn-create-exercise" class="btn-create">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>Crear Nuevo Ejercicio</span>
            </button>
          </div>
        </div>
      </header>

      <!-- Métricas / Estadísticas rápidas -->
      <section class="stats-grid" aria-label="Métricas del catálogo">
        <div class="stat-card">
          <div class="stat-number" id="stat-total">{allExercises.length}</div>
          <div class="stat-label">Total Ejercicios</div>
        </div>
        <div class="stat-card">
          <div class="stat-number highlight-blue" id="stat-classic">{classicCount}</div>
          <div class="stat-label">Desafíos Clásicos</div>
        </div>
        <div class="stat-card">
          <div class="stat-number highlight-purple" id="stat-contextual">{contextualCount}</div>
          <div class="stat-label">Proyectos Multi-archivo</div>
        </div>
        <div class="stat-card">
          <div class="stat-number highlight-green" id="stat-active">{activeCount}</div>
          <div class="stat-label">Activos (Visibles)</div>
        </div>
        <div class="stat-card">
          <div class="stat-number highlight-amber" id="stat-inactive">{inactiveCount}</div>
          <div class="stat-label">Desactivados (Ocultos)</div>
        </div>
      </section>

      <!-- Barra de Filtros y Búsqueda -->
      <section class="toolbar-section">
        <div class="filter-group">
          <label for="filter-mode" class="filter-label">Modalidad:</label>
          <select id="filter-mode" class="admin-select">
            <option value="all">Todas las modalidades</option>
            <option value="classic">Desafíos Clásicos</option>
            <option value="contextual">Proyectos Multi-archivo</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-status" class="filter-label">Estado:</label>
          <select id="filter-status" class="admin-select">
            <option value="all">Todos los estados</option>
            <option value="active">Solo Activos</option>
            <option value="inactive">Solo Desactivados</option>
          </select>
        </div>

        <div class="filter-group search-group">
          <svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input type="text" id="search-input" class="admin-input-search" placeholder="Buscar por título, ID o tema..." />
        </div>
      </section>

      <!-- Tabla / Lista de Ejercicios -->
      <section class="table-container">
        <table class="admin-table" id="exercises-table">
          <thead>
            <tr>
              <th>Ejercicio</th>
              <th>Modalidad</th>
              <th>Dificultad</th>
              <th>Temas</th>
              <th>Estado</th>
              <th class="text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="exercises-tbody">
            {allExercises.map(ex => {
              const isClassic = ex.mode === 'classic';
              const diffClass = ex.difficulty === 'Fácil' ? 'diff-easy' : (ex.difficulty === 'Medio' ? 'diff-medium' : 'diff-hard');
              const linkUrl = isClassic ? `/ejercicios/clasicos/${ex.id}` : `/ejercicios/contextualizados/${ex.id}`;

              return (
                <tr class="exercise-row" data-id={ex.id} data-mode={ex.mode} data-status={ex.is_active ? 'active' : 'inactive'} data-title={ex.title.toLowerCase()} data-topics={ex.topics.join(' ').toLowerCase()}>
                  <td class="col-title">
                    <div class="ex-title-wrap">
                      <strong class="ex-title-text">{ex.title}</strong>
                      <span class="ex-id-code">ID: {ex.id}</span>
                      <p class="ex-desc-excerpt">{ex.description}</p>
                    </div>
                  </td>
                  <td class="col-mode">
                    <span class={`badge-mode ${isClassic ? 'badge-classic' : 'badge-contextual'}`}>
                      {isClassic ? 'Clásico' : 'Proyecto'}
                    </span>
                  </td>
                  <td class="col-diff">
                    <span class={`pill-diff ${diffClass}`}>{ex.difficulty}</span>
                  </td>
                  <td class="col-topics">
                    <div class="topics-wrap">
                      {ex.topics.map(t => (
                        <span class="topic-chip">#{t}</span>
                      ))}
                    </div>
                  </td>
                  <td class="col-status">
                    <button
                      type="button"
                      class={`btn-toggle-status ${ex.is_active ? 'status-active' : 'status-inactive'}`}
                      data-id={ex.id}
                      title={ex.is_active ? 'Clic para desactivar' : 'Clic para activar'}
                    >
                      <span class="status-indicator"></span>
                      <span class="status-text">{ex.is_active ? 'Activo' : 'Desactivado'}</span>
                    </button>
                  </td>
                  <td class="col-actions text-right">
                    <div class="actions-group">
                      <a href={linkUrl} target="_blank" rel="noopener noreferrer" class="btn-action btn-view" title="Probar ejercicio en vivo">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        <span>Ver</span>
                      </a>
                      <button type="button" class="btn-action btn-edit" data-id={ex.id} title="Editar contenido y pruebas">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        <span>Editar</span>
                      </button>
                      <button type="button" class="btn-action btn-delete" data-id={ex.id} data-title={ex.title} title="Eliminar ejercicio">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        <span>Borrar</span>
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <div id="no-results-msg" class="no-results-box" style="display: none;">
          <p>No se encontraron ejercicios con los filtros seleccionados.</p>
        </div>
      </section>

      <!-- Modal de Creación / Edición de Ejercicio -->
      <dialog id="exercise-modal" class="admin-modal">
        <form method="dialog" id="exercise-form" class="modal-form">
          <div class="modal-header">
            <div>
              <h2 id="modal-title">Crear Nuevo Ejercicio</h2>
              <p class="modal-subtitle">Define el contenido, código inicial y pruebas unitarias que validarán el ejercicio.</p>
            </div>
            <button type="button" id="modal-close-btn" class="modal-close-x" aria-label="Cerrar modal">&times;</button>
          </div>

          <div class="modal-body">
            <input type="hidden" id="form-is-edit" value="false" />
            <input type="hidden" id="form-original-id" value="" />

            <!-- Selector de Modalidad -->
            <div class="form-row">
              <div class="form-group flex-1">
                <label for="form-mode">Modalidad del Ejercicio <span class="req">*</span></label>
                <select id="form-mode" class="admin-input" required>
                  <option value="classic">Desafío Clásico (Un archivo main.py + tests)</option>
                  <option value="contextual">Proyecto Multi-archivo (Arquitectura modular)</option>
                </select>
              </div>

              <div class="form-group flex-1">
                <label for="form-id">Identificador único (ID) <span class="req">*</span></label>
                <input type="text" id="form-id" class="admin-input" placeholder="ej. clasico_fibonacci o 10_tienda_poo" required />
                <small class="field-hint">Solo letras minúsculas, números y guiones bajos.</small>
              </div>
            </div>

            <!-- Datos Generales -->
            <div class="form-row">
              <div class="form-group flex-2">
                <label for="form-title">Título del Ejercicio <span class="req">*</span></label>
                <input type="text" id="form-title" class="admin-input" placeholder="ej. Invertir una Cadena de Texto" required />
              </div>

              <div class="form-group flex-1">
                <label for="form-difficulty">Dificultad <span class="req">*</span></label>
                <select id="form-difficulty" class="admin-input" required>
                  <option value="Fácil">Fácil</option>
                  <option value="Medio">Medio</option>
                  <option value="Difícil">Difícil</option>
                </select>
              </div>

              <div class="form-group flex-1">
                <label for="form-level">Nivel Académico</label>
                <select id="form-level" class="admin-input">
                  <option value="Inicial">Inicial</option>
                  <option value="Intermedio">Intermedio</option>
                  <option value="Avanzado">Avanzado</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="form-topics">Temas o Etiquetas (separados por coma)</label>
              <input type="text" id="form-topics" class="admin-input" placeholder="ej. bucles, cadenas, algoritmos, poo" />
            </div>

            <div class="form-group">
              <label for="form-desc">Descripción Breve (se muestra en las tarjetas del catálogo) <span class="req">*</span></label>
              <textarea id="form-desc" class="admin-input" rows="2" placeholder="Resumen conciso del objetivo del ejercicio..." required></textarea>
            </div>

            <div class="form-group">
              <label for="form-statement">Enunciado Detallado (Markdown soportado) <span class="req">*</span></label>
              <textarea id="form-statement" class="admin-input code-font" rows="5" placeholder="Instrucciones paso a paso, especificaciones y ejemplos..." required></textarea>
            </div>

            <div class="form-group">
              <label for="form-expected">Salida Esperada (Texto o ejemplos de salida)</label>
              <textarea id="form-expected" class="admin-input code-font" rows="2" placeholder="Ejemplo de salida esperada en consola..."></textarea>
            </div>

            <!-- Código Base y Pruebas Unitarias -->
            <div class="form-subheading">
              <h3>Archivos Python del Ejercicio</h3>
              <p>Escribe el código inicial que verá el estudiante y las pruebas unitarias que evaluará el ejecutor.</p>
            </div>

            <div class="form-group">
              <label for="form-main-py">Código Inicial: <code>main.py</code> <span class="req">*</span></label>
              <textarea id="form-main-py" class="admin-input code-font" rows="6" spellcheck="false" required></textarea>
            </div>

            <div class="form-group">
              <label for="form-test-py">Pruebas Unitarias: <code>tests/test_publico.py</code> <span class="req">*</span></label>
              <textarea id="form-test-py" class="admin-input code-font" rows="6" spellcheck="false" required></textarea>
              <small class="field-hint">Debe importar unittest y los métodos de main. Al pulsar «Probar», el alumno debe superar estas pruebas.</small>
            </div>

            <!-- Opciones extra para Clásicos -->
            <div id="classic-extras" class="extra-panel">
              <h4>Ayudas Pedagógicas (Para Retos Clásicos)</h4>
              <div class="form-group">
                <label for="form-hint">Pista Pedagógica</label>
                <input type="text" id="form-hint" class="admin-input" placeholder="Guía orientadora para destrabar al estudiante sin dar la solución..." />
              </div>
              <div class="form-group">
                <label for="form-solution">Solución Oficial de Referencia</label>
                <textarea id="form-solution" class="admin-input code-font" rows="4" placeholder="# Solución óptima comentada..." spellcheck="false"></textarea>
              </div>
            </div>

            <div class="form-group checkbox-group">
              <label class="checkbox-label">
                <input type="checkbox" id="form-is-active" checked />
                <span>Ejercicio Activo (visible inmediatamente en el catálogo de estudiantes)</span>
              </label>
            </div>
          </div>

          <div class="modal-footer">
            <span id="form-error-msg" class="form-error"></span>
            <div class="footer-btn-row">
              <button type="button" id="modal-cancel-btn" class="btn-secondary">Cancelar</button>
              <button type="submit" id="modal-save-btn" class="btn-primary">Guardar Ejercicio</button>
            </div>
          </div>
        </form>
      </dialog>

      <!-- Modal de Confirmación de Eliminación -->
      <dialog id="delete-modal" class="admin-modal confirm-modal">
        <div class="modal-content">
          <div class="confirm-icon">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="#FBBF24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <h3>¿Eliminar este ejercicio?</h3>
          <p id="delete-target-text">Esta acción no se puede deshacer y borrará el ejercicio de la base de datos.</p>
          <div class="confirm-actions">
            <button type="button" id="btn-cancel-delete" class="btn-secondary">Cancelar</button>
            <button type="button" id="btn-confirm-delete" class="btn-danger">Sí, eliminar ejercicio</button>
          </div>
        </div>
      </dialog>

      </main>
  )}
</Layout>

<style>
  .admin-page {
    max-width: 1380px;
    margin: 0 auto;
    padding: 2rem 1.5rem 5rem;
    color: var(--color-text-primary, #F8FAFC);
  }

  .admin-unauthorized {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .unauth-card {
    background: var(--color-surface, #1E293B);
    border: 1px solid var(--color-border, #334155);
    border-radius: 16px;
    padding: 3rem 2rem;
    max-width: 540px;
    text-align: center;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }

  .unauth-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .user-info-box {
    background: rgba(15, 23, 42, 0.6);
    border-radius: 8px;
    padding: 1rem;
    margin: 1.5rem 0;
    font-size: 0.9rem;
    color: var(--color-text-secondary, #94A3B8);
  }

  .hint-text {
    font-size: 0.8rem;
    margin-top: 0.5rem;
    color: #64748B;
  }

  .unauth-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .admin-header {
    margin-bottom: 2rem;
  }

  .header-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary, #94A3B8);
    margin-bottom: 0.75rem;
  }

  .back-link {
    color: #38BDF8;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .header-main-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .admin-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #38BDF8;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    margin-bottom: 0.5rem;
  }

  .admin-title {
    font-size: 2.1rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .admin-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary, #94A3B8);
    margin: 0;
    max-width: 680px;
  }

  .header-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .btn-create {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #2563EB, #1D4ED8);
    color: #FFFFFF;
    font-weight: 600;
    padding: 0.75rem 1.25rem;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
    transition: all 0.2s ease;
  }

  .btn-create:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5);
  }

  .btn-outline-manual {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(30, 41, 59, 0.6);
    color: var(--color-text-primary, #E2E8F0);
    border: 1px solid var(--color-border, #334155);
    padding: 0.75rem 1.1rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .btn-outline-manual:hover {
    border-color: #38BDF8;
    color: #38BDF8;
    background: rgba(56, 189, 248, 0.08);
  }

  /* Stats grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .stat-card {
    background: var(--color-surface, #1E293B);
    border: 1px solid var(--color-border, #334155);
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
  }

  .stat-number {
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .highlight-blue { color: #38BDF8; }
  .highlight-purple { color: #C084FC; }
  .highlight-green { color: #4ADE80; }
  .highlight-amber { color: #FBBF24; }

  .stat-label {
    font-size: 0.85rem;
    color: var(--color-text-secondary, #94A3B8);
    font-weight: 500;
  }

  /* Toolbar */
  .toolbar-section {
    display: flex;
    gap: 1rem;
    align-items: center;
    background: var(--color-surface, #1E293B);
    border: 1px solid var(--color-border, #334155);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-label {
    font-size: 0.85rem;
    color: var(--color-text-secondary, #94A3B8);
    font-weight: 500;
  }

  .admin-select {
    background: #0F172A;
    border: 1px solid #334155;
    color: #E2E8F0;
    padding: 0.5rem 0.85rem;
    border-radius: 8px;
    font-size: 0.88rem;
    cursor: pointer;
  }

  .search-group {
    flex: 1;
    min-width: 250px;
    position: relative;
  }

  .search-icon {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    color: #64748B;
    pointer-events: none;
  }

  .admin-input-search {
    width: 100%;
    background: #0F172A;
    border: 1px solid #334155;
    color: #E2E8F0;
    padding: 0.5rem 0.85rem 0.5rem 2.25rem;
    border-radius: 8px;
    font-size: 0.88rem;
    box-sizing: border-box;
  }

  .admin-input-search:focus, .admin-select:focus, .admin-input:focus {
    outline: none;
    border-color: #38BDF8;
