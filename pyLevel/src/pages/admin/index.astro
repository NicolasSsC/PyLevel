</style>

<script>
  // Script interactivo del panel administrativo
  const modal = document.getElementById('exercise-modal') as HTMLDialogElement;
  const deleteModal = document.getElementById('delete-modal') as HTMLDialogElement;
  const exerciseForm = document.getElementById('exercise-form') as HTMLFormElement;
  const modalTitle = document.getElementById('modal-title') as HTMLElement;
  const formIsEdit = document.getElementById('form-is-edit') as HTMLInputElement;
  const formOriginalId = document.getElementById('form-original-id') as HTMLInputElement;
  const formId = document.getElementById('form-id') as HTMLInputElement;
  const formMode = document.getElementById('form-mode') as HTMLSelectElement;
  const formTitle = document.getElementById('form-title') as HTMLInputElement;
  const formDifficulty = document.getElementById('form-difficulty') as HTMLSelectElement;
  const formLevel = document.getElementById('form-level') as HTMLSelectElement;
  const formTopics = document.getElementById('form-topics') as HTMLInputElement;
  const formDesc = document.getElementById('form-desc') as HTMLTextAreaElement;
  const formStatement = document.getElementById('form-statement') as HTMLTextAreaElement;
  const formExpected = document.getElementById('form-expected') as HTMLTextAreaElement;
  const formMainPy = document.getElementById('form-main-py') as HTMLTextAreaElement;
  const formTestPy = document.getElementById('form-test-py') as HTMLTextAreaElement;
  const formHint = document.getElementById('form-hint') as HTMLInputElement;
  const formSolution = document.getElementById('form-solution') as HTMLTextAreaElement;
  const formIsActive = document.getElementById('form-is-active') as HTMLInputElement;
  const formErrorMsg = document.getElementById('form-error-msg') as HTMLElement;
  const classicExtras = document.getElementById('classic-extras') as HTMLElement;

  let pendingDeleteId: string | null = null;

  // Actualizar visibilidad de extras según modalidad
  formMode?.addEventListener('change', () => {
    if (classicExtras) {
      classicExtras.style.display = formMode.value === 'classic' ? 'flex' : 'none';
    }
  });

  // Botón Abrir modal para Crear
  document.getElementById('btn-create-exercise')?.addEventListener('click', () => {
    formIsEdit.value = 'false';
    formOriginalId.value = '';
    modalTitle.textContent = 'Crear Nuevo Ejercicio';
    formId.disabled = false;
    formId.value = '';
    formMode.value = 'classic';
    formTitle.value = '';
    formDifficulty.value = 'Fácil';
    formLevel.value = 'Inicial';
    formTopics.value = '';
    formDesc.value = '';
    formStatement.value = '# Título del Ejercicio\n\nDescribe las instrucciones detalladas aquí...';
    formExpected.value = '';
    formMainPy.value = 'def resolver_problema():\n    # Implementa tu solución aquí\n    pass\n';
    formTestPy.value = `import unittest\nfrom main import resolver_problema\n\nclass TestCasos(unittest.TestCase):\n    def test_caso_base(self):\n        self.assertEqual(resolver_problema(), None)\n`;
    formHint.value = '';
    formSolution.value = '';
    formIsActive.checked = true;
    formErrorMsg.textContent = '';
    classicExtras.style.display = 'flex';

    modal.showModal();
  });

  // Cerrar modal
  document.getElementById('modal-close-btn')?.addEventListener('click', () => modal.close());
  document.getElementById('modal-cancel-btn')?.addEventListener('click', () => modal.close());

  // Manejar Editar Ejercicio
  document.querySelectorAll('.btn-edit').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = (e.currentTarget as HTMLElement);
      const id = target.dataset.id;
      if (!id) return;

      try {
        const res = await fetch(`/api/admin/exercises/${id}`);
        const data = await res.json();
        if (!res.ok || !data.exercise) {
          alert(data.error || 'No se pudo cargar el ejercicio para editar.');
          return;
        }

        const ex = data.exercise;
        formIsEdit.value = 'true';
        formOriginalId.value = ex.id;
        modalTitle.textContent = `Editar Ejercicio: ${ex.title}`;
        formId.value = ex.id;
        formId.disabled = true; // No cambiar ID en edición
        formMode.value = ex.mode;
        formTitle.value = ex.title;
        formDifficulty.value = ex.difficulty;
        formLevel.value = ex.level || 'Inicial';
        formTopics.value = Array.isArray(ex.topics) ? ex.topics.join(', ') : '';
        formDesc.value = ex.description;
        formStatement.value = ex.statement;
        formExpected.value = ex.expected || '';
        formMainPy.value = (ex.files && ex.files['main.py']) || '';
        formTestPy.value = (ex.files && (ex.files['tests/test_publico.py'] || Object.entries(ex.files).find(([k]) => k.includes('test'))?.[1])) || '';
        formHint.value = (ex.hints && ex.hints[0]) || '';
        formSolution.value = ex.solution || '';
        formIsActive.checked = Boolean(ex.is_active);
        formErrorMsg.textContent = '';

        classicExtras.style.display = ex.mode === 'classic' ? 'flex' : 'none';
        modal.showModal();
      } catch (err) {
        alert('Error al conectar con el servidor.');
      }
    });
  });

  // Guardar formulario (Crear o Editar)
  exerciseForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    formErrorMsg.textContent = 'Guardando...';

    const isEdit = formIsEdit.value === 'true';
    const id = isEdit ? formOriginalId.value : formId.value.trim().toLowerCase().replace(/[^a-z0-9_]/g, '_');
    const mode = formMode.value;
    const title = formTitle.value.trim();
    const difficulty = formDifficulty.value;
    const level = formLevel.value;
    const topics = formTopics.value.split(',').map(s => s.trim()).filter(Boolean);
    const description = formDesc.value.trim();
    const statement = formStatement.value.trim();
    const expected = formExpected.value;
    const is_active = formIsActive.checked;

    const files: Record<string, string> = {
      'main.py': formMainPy.value,
      'tests/test_publico.py': formTestPy.value,
    };

    const payload: any = {
      id,
      mode,
      title,
      difficulty,
      level,
      topics,
      description,
      statement,
      expected,
      files,
      hints: formHint.value ? [formHint.value] : [],
      solution: formSolution.value,
      is_active,
    };

    try {
      const url = isEdit ? `/api/admin/exercises/${id}` : '/api/admin/exercises';
      const method = isEdit ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const data = await res.json();
      if (!res.ok) {
        formErrorMsg.textContent = data.error || 'Error al guardar el ejercicio.';
        return;
      }

      modal.close();
      window.location.reload();
    } catch (err) {
      formErrorMsg.textContent = 'Error de conexión con el servidor.';
    }
  });

  // Toggle Estado Activo / Inactivo en 1-click
  document.querySelectorAll('.btn-toggle-status').forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const target = (e.currentTarget as HTMLElement);
      const id = target.dataset.id;
      if (!id) return;

      target.style.opacity = '0.5';
      try {
        const res = await fetch(`/api/admin/exercises/${id}/toggle`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();
        if (!res.ok) {
          alert(data.error || 'No se pudo cambiar el estado.');
          target.style.opacity = '1';
          return;
        }

        const row = target.closest('tr');
        if (row) {
          row.dataset.status = data.is_active ? 'active' : 'inactive';
        }

        if (data.is_active) {
          target.className = 'btn-toggle-status status-active';
          target.querySelector('.status-text')!.textContent = 'Activo';
          target.title = 'Clic para desactivar';
        } else {
          target.className = 'btn-toggle-status status-inactive';
          target.querySelector('.status-text')!.textContent = 'Desactivado';
          target.title = 'Clic para activar';
        }

        target.style.opacity = '1';
        updateStats();
      } catch (err) {
        alert('Error de conexión al cambiar estado.');
        target.style.opacity = '1';
      }
    });
  });

  // Manejar Eliminación con Modal
  document.querySelectorAll('.btn-delete').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = (e.currentTarget as HTMLElement);
      pendingDeleteId = target.dataset.id || null;
      const title = target.dataset.title || pendingDeleteId;
      document.getElementById('delete-target-text')!.textContent = `¿Estás seguro de que deseas eliminar permanentemente "${title}" (${pendingDeleteId})? Esta acción no se puede deshacer.`;
      deleteModal.showModal();
    });
  });

  document.getElementById('btn-cancel-delete')?.addEventListener('click', () => {
    pendingDeleteId = null;
    deleteModal.close();
  });

  document.getElementById('btn-confirm-delete')?.addEventListener('click', async () => {
    if (!pendingDeleteId) return;

    try {
      const res = await fetch(`/api/admin/exercises/${pendingDeleteId}`, {
        method: 'DELETE',
      });
      const data = await res.json();
      if (!res.ok) {
        alert(data.error || 'No se pudo eliminar el ejercicio.');
        return;
      }

      const row = document.querySelector(`tr[data-id="${pendingDeleteId}"]`);
      if (row) row.remove();

      deleteModal.close();
      pendingDeleteId = null;
      updateStats();
    } catch (err) {
      alert('Error de conexión al eliminar.');
    }
  });

  // Filtros y Búsqueda en vivo
  const filterMode = document.getElementById('filter-mode') as HTMLSelectElement;
  const filterStatus = document.getElementById('filter-status') as HTMLSelectElement;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const tbody = document.getElementById('exercises-tbody');
  const noResultsMsg = document.getElementById('no-results-msg');

  function applyFilters() {
    const mode = filterMode.value;
    const status = filterStatus.value;
    const query = searchInput.value.toLowerCase().trim();

    let visibleCount = 0;
    const rows = document.querySelectorAll('.exercise-row');

    rows.forEach(r => {
      const row = r as HTMLElement;
      const rowMode = row.dataset.mode;
      const rowStatus = row.dataset.status;
      const rowTitle = row.dataset.title || '';
      const rowTopics = row.dataset.topics || '';
      const rowId = row.dataset.id || '';

      const matchMode = mode === 'all' || rowMode === mode;
      const matchStatus = status === 'all' || rowStatus === status;
      const matchQuery = !query || rowTitle.includes(query) || rowTopics.includes(query) || rowId.includes(query);

      if (matchMode && matchStatus && matchQuery) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    if (noResultsMsg) {
      noResultsMsg.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  function updateStats() {
    const rows = Array.from(document.querySelectorAll('.exercise-row')) as HTMLElement[];
    const total = rows.length;
    const classic = rows.filter(r => r.dataset.mode === 'classic').length;
    const contextual = rows.filter(r => r.dataset.mode === 'contextual').length;
    const active = rows.filter(r => r.dataset.status === 'active').length;
    const inactive = rows.filter(r => r.dataset.status === 'inactive').length;

    const elTotal = document.getElementById('stat-total');
    const elClassic = document.getElementById('stat-classic');
    const elContextual = document.getElementById('stat-contextual');
    const elActive = document.getElementById('stat-active');
    const elInactive = document.getElementById('stat-inactive');

    if (elTotal) elTotal.textContent = String(total);
    if (elClassic) elClassic.textContent = String(classic);
    if (elContextual) elContextual.textContent = String(contextual);
    if (elActive) elActive.textContent = String(active);
    if (elInactive) elInactive.textContent = String(inactive);
  }

  filterMode?.addEventListener('change', applyFilters);
  filterStatus?.addEventListener('change', applyFilters);
  searchInput?.addEventListener('input', applyFilters);

  </script>

