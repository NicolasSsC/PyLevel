---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout
  title="Iniciar Sesión · PyLevel"
  description="Acceso de estudiantes a PyLevel mediante autenticación con PostgreSQL Render y hash seguro."
>
  <div class="auth-page">
    <div class="auth-card">

      <!-- Encabezado del Card -->
      <div class="auth-header">
        <div class="auth-logo-badge">
          <svg width="24" height="24" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 4C13 4 10 9 10 16v4h14v2H8C4 22 4 28 4 32c0 7 3 12 12 12h4v-6h-2c-4 0-6-2-6-6v-4h28v4c0 4-2 6-6 6h-2v6h4c9 0 12-5 12-12V20c0-8-3-16-16-16zM18 14a2 2 0 110-4 2 2 0 010 4z" fill="#3776AB"/>
            <path d="M24 44c11 0 14-5 14-12v-4H24v-2h16c4 0 4-6 4-10 0-7-3-12-12-12h-4v6h2c4 0 6 2 6 6v4H8v-4c0-4 2-6 6-6h2V4H12C3 4 0 9 0 16v12c0 8 3 16 16 16zM30 34a2 2 0 110 4 2 2 0 010-4z" fill="#FFD43B"/>
          </svg>
        </div>
        <h1>Acceso de Estudiante</h1>
        <p class="auth-sub">Conéctate a tu entorno de evaluación en PyLevel.</p>
      </div>

      <!-- Alerta de Error / Éxito -->
      <div id="auth-alert" class="auth-alert" style="display: none;" role="alert">
        <span id="auth-alert-msg"></span>
      </div>

      <!-- Formulario de Login -->
      <form id="login-form" class="auth-form" novalidate>
        <div class="form-group">
          <label for="email">Correo Institucional / Estudiante</label>
          <div class="input-wrapper">
            <input
              type="email"
              id="email"
              name="email"
              placeholder="estudiante@pylevel.dev"
              required
              autocomplete="email"
            />
          </div>
        </div>

        <div class="form-group">
          <label for="password">Contraseña</label>
          <div class="input-wrapper">
            <input
              type="password"
              id="password"
              name="password"
              placeholder="••••••••"
              required
              autocomplete="current-password"
            />
          </div>
        </div>

        <button type="submit" id="submit-btn" class="btn-submit">
          <span id="btn-text">Iniciar Sesión</span>
          <span id="btn-spinner" class="spinner" style="display: none;" aria-hidden="true"></span>
        </button>
      </form>

      <!-- Pie del Card -->
      <div class="auth-footer">
        <p>¿No tienes cuenta aún? <a href="/registro">Regístrate como nuevo estudiante →</a></p>
      </div>

      <!-- Nota de Integración Técnica -->
      <div class="db-notice">
        <span class="db-dot"></span>
        <span>Autenticación validada en producción con PostgreSQL (Render) y bcrypt.</span>
      </div>

    </div>
  </div>
</AppLayout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const alertEl = document.getElementById('auth-alert');
  const alertMsg = document.getElementById('auth-alert-msg');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');

  function showAlert(msg: string, isError = true) {
    if (!alertEl || !alertMsg) return;
    alertMsg.textContent = msg;
    alertEl.className = isError ? 'auth-alert auth-alert--error' : 'auth-alert auth-alert--success';
    alertEl.style.display = 'block';
  }

  function setLoading(loading: boolean) {
    if (!submitBtn || !btnText || !btnSpinner) return;
    submitBtn.disabled = loading;
    btnText.style.display = loading ? 'none' : 'inline';
    btnSpinner.style.display = loading ? 'inline-block' : 'none';
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (document.getElementById('email') as HTMLInputElement).value.trim();
      const password = (document.getElementById('password') as HTMLInputElement).value;

      if (!email || !password) {
        showAlert('Por favor ingresa tu correo y contraseña.');
        return;
      }

      setLoading(true);
      if (alertEl) alertEl.style.display = 'none';

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        const data = await res.json();

        if (!res.ok) {
          showAlert(data.error || 'Credenciales incorrectas.');
          setLoading(false);
          return;
        }

        showAlert('¡Sesión iniciada con éxito! Redirigiendo...', false);
        localStorage.setItem('pylevel:current_user', JSON.stringify(data.user));

        setTimeout(() => {
          window.location.href = '/perfil';
        }, 800);
      } catch (err: any) {
        showAlert('Error de conexión con el servidor de autenticación.');
        setLoading(false);
      }
    });
  }
</script>

<style>
  .auth-page {
    min-height: calc(100vh - 56px);
    display: grid;
    place-items: center;
    padding: 40px 20px;
    background: radial-gradient(circle at 50% 20%, rgba(55,118,171,0.08) 0%, transparent 60%);
  }

  .auth-card {
    width: 100%;
    max-width: 440px;
    background: #111827;
    border: 1px solid #1E293B;
    border-radius: 14px;
    padding: 36px 32px;
    box-shadow: 0 16px 48px rgba(0,0,0,0.4);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 24px;
  }

  .auth-logo-badge {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    background: #0B1120;
    border: 1px solid #1E293B;
    border-radius: 12px;
    margin-bottom: 16px;
  }

  .auth-header h1 {
    font-size: 22px;
    letter-spacing: -0.5px;
    color: #E2E8F0;
    margin: 0 0 6px;
    font-weight: 700;
  }

  .auth-sub {
    font-size: 13px;
    color: #64748B;
    margin: 0;
  }

  /* Alerta */
  .auth-alert {
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 12px;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .auth-alert--error {
    background: rgba(244,63,94,0.1);
    border: 1px solid rgba(244,63,94,0.3);
    color: #F43F5E;
  }

  .auth-alert--success {
    background: rgba(16,185,129,0.1);
    border: 1px solid rgba(16,185,129,0.3);
    color: #10B981;
  }

  /* Form */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font: 600 11px ui-monospace, monospace;
    color: #94A3B8;
    letter-spacing: 0.5px;
  }

  .input-wrapper input {
    width: 100%;
    padding: 10px 14px;
    background: #0B1120;
    border: 1px solid #1E293B;
    border-radius: 7px;
    color: #E2E8F0;
    font-size: 13px;
    box-sizing: border-box;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .input-wrapper input:focus {
    outline: none;
    border-color: #3776AB;
    box-shadow: 0 0 0 3px rgba(55,118,171,0.2);
  }

  .btn-submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    background: #3776AB;
    color: #fff;
    border: none;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 650;
    cursor: pointer;
    transition: background 0.15s;
    margin-top: 6px;
  }

  .btn-submit:hover:not(:disabled) {
    background: #2d6496;
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .spinner {
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255,255,255,0.3);
    border-radius: 50%;
    border-top-color: #fff;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .auth-footer {
    text-align: center;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid #1E293B;
  }

  .auth-footer p {
    font-size: 12px;
    color: #64748B;
    margin: 0;
  }

  .auth-footer a {
    color: #3776AB;
    text-decoration: none;
    font-weight: 600;
  }

  .auth-footer a:hover {
    text-decoration: underline;
  }

  .db-notice {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    font: 10px ui-monospace, monospace;
    color: #475569;
    justify-content: center;
  }

  .db-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 4px #10B981;
  }
</style>
