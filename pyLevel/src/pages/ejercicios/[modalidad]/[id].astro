---
export const prerender = false;
import Workbench from '../../../core/Workbench.astro';
import ClassicWorkbench from '../../../core/ClassicWorkbench.astro';
import Layout from '../../../layouts/Layout.astro';
import { getDbPool } from '../../../lib/db';
import { exerciseStore } from '../../../admin/exercise-store';
const {modalidad,id}=Astro.params;
if(!['clasicos','contextualizados'].includes(modalidad || ''))return new Response('Ejercicio no encontrado.',{status:404});
const mode=modalidad==='clasicos'?'classic':'contextual';
const exercise=id?await exerciseStore(getDbPool()).find(id,mode,true):null;
if(!exercise)return new Response('Ejercicio no disponible.',{status:404});
const classicItem={...exercise,hints:exercise.hints.length?exercise.hints:['Analiza los casos de prueba.'],solution:exercise.solution || '# No hay una solución de referencia disponible.'};
---
<Layout title={`${exercise.title} · PyLevel`}>
  {mode==='classic'?<ClassicWorkbench exercise={classicItem}/>:<Workbench mode={mode} exercise={exercise}/>}
</Layout>
