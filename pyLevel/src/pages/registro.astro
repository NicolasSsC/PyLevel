---
import Layout from '../layouts/Layout.astro';
import ProgrammingPrelogin from '../components/ProgrammingPrelogin.astro';
---

<Layout title="Crear cuenta · PyLevel" description="Crea tu cuenta y empieza a practicar Python a tu ritmo." hideNavbar>
  <Fragment slot="head">
    <script is:inline>
      document.documentElement.dataset.prelogin = 'pending';
      window.setTimeout(() => {
        if (document.documentElement.dataset.prelogin === 'pending') delete document.documentElement.dataset.prelogin;
      }, 8000);
    </script>
    <style is:global>
      html[data-prelogin] body { overflow: hidden; background: #0d1520; }
      html[data-prelogin='pending'] #pylevel-prelogin [data-login-part] { visibility: hidden; }
    </style>
  </Fragment>
  <ProgrammingPrelogin mode="register" />
</Layout>
