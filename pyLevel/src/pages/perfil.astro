---
export const prerender = false;
import AccountShell from '../account/AccountShell.astro';
import { currentUser } from '../lib/session';
import { loadExamHistory } from '../account/data';
import { todayInBogota } from '../account/profile';

let user = null;
let exams: Awaited<ReturnType<typeof loadExamHistory>> = [];
let unavailable = false;
try { user = await currentUser(Astro.cookies); if (user) exams = await loadExamHistory(user.id); } catch { unavailable = true; }
if (!user && !unavailable) return Astro.redirect('/login');
if (unavailable) Astro.response.status = 503;
const initials = user?.displayName.split(/\s+/).filter(Boolean).slice(0, 2).map(n => n[0]).join('').toUpperCase();
const date = (value: string) => new Intl.DateTimeFormat('es-CO', { dateStyle: 'medium', timeZone: 'America/Bogota' }).format(new Date(value));
const birthdayLabel = user?.birthday ? new Intl.DateTimeFormat('es-CO', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${user.birthday}T12:00:00Z`)) : 'Sin completar';
const examStatus = { in_progress: 'En curso', submitted: 'Entregado', expired: 'Tiempo finalizado' };
---
<AccountShell title="Mi perfil" description="Tus datos, tu cuenta y las evaluaciones que has realizado." active="perfil">
  {unavailable || !user ? <section class="account-card account-empty"><h2>No pudimos cargar tu perfil</h2><p>Tu información sigue guardada. Vuelve a intentar cuando el servicio esté disponible.</p><a class="account-button secondary" href="/perfil">Volver a intentar</a></section> : <>
    <div class="account-grid">
      <section class="account-card" aria-labelledby="personal-title">
        <div class="profile-identity"><div class="profile-avatar" id="account-avatar" aria-hidden="true">{initials}</div><div><h2 id="account-name">{user.displayName}</h2><p id="account-occupation">{user.occupation || 'Completa tu ocupación'}</p></div></div>
        <form class="profile-form" id="profile-form" data-original-email={user.email}>
          <h2 id="personal-title">Datos personales</h2><p class="account-muted">Mantén tu información al día. El cumpleaños y la ocupación son opcionales.</p>
          <div class="profile-fields" style="margin-top:24px">
            <div class="profile-field"><label for="profile-full-name">Nombre completo</label><input id="profile-full-name" name="displayName" autocomplete="name" maxlength="100" value={user.displayName} required /></div>
            <div class="profile-field"><label for="profile-occupation">Ocupación</label><input id="profile-occupation" name="occupation" autocomplete="organization-title" maxlength="100" placeholder="Ej. Estudiante de ingeniería" value={user.occupation || ''} /></div>
            <div class="profile-field"><label for="profile-birthday">Cumpleaños</label><input id="profile-birthday" name="birthday" type="date" autocomplete="bday" min="1900-01-01" max={todayInBogota()} value={user.birthday || ''} /><small>Solo se muestra en tu perfil.</small></div>
            <div class="profile-field"><label for="profile-email">Correo electrónico</label><input id="profile-email" name="email" type="email" autocomplete="email" maxlength="254" value={user.email} required /><small>Este es el correo con el que inicias sesión.</small></div>
            <div class="profile-field full" id="email-password-field" hidden><label for="profile-password">Confirma tu contraseña actual</label><input id="profile-password" name="currentPassword" type="password" autocomplete="current-password" maxlength="200" /><small>Necesaria para cambiar el correo. Se cerrarán tus otras sesiones.</small></div>
          </div>
          <div class="profile-actions"><span class="account-muted">Los cambios se guardan en tu cuenta.</span><button class="account-button primary" id="profile-save" type="submit">Guardar cambios →</button></div>
          <p id="profile-status" class="account-notice" role="status" aria-live="polite" hidden></p>
        </form>
      </section>
      <aside class="account-card" aria-labelledby="account-title">
        <span class="account-label">TU CUENTA</span><h2 id="account-title" style="margin-top:12px">Un espacio personal</h2>
        <dl class="account-details"><div><dt>CORREO DE ACCESO</dt><dd id="account-email">{user.email}</dd></div><div><dt>CUMPLEAÑOS</dt><dd id="account-birthday">{birthdayLabel}</dd></div><div><dt>MIEMBRO DESDE</dt><dd>{date(user.createdAt)}</dd></div><div><dt>EXÁMENES REALIZADOS</dt><dd>{exams.filter(e => e.status !== 'in_progress').length} finalizados{exams.some(e => e.status === 'in_progress') ? ` · ${exams.filter(e => e.status === 'in_progress').length} en curso` : ''}</dd></div></dl>
        <div class="profile-session"><h3>Sesión actual</h3><p class="account-muted">Cierra tu sesión al terminar si utilizas un equipo compartido.</p><button id="profile-logout" class="account-button danger" type="button">Cerrar sesión</button><p id="logout-status" class="account-muted" role="status"></p></div>
      </aside>
    </div>
    <section class="account-card account-section" aria-labelledby="exams-title">
      <div class="section-top"><div><h2 id="exams-title">Mis exámenes</h2><p class="account-muted">Evaluaciones asociadas a tu cuenta y su estado actual.</p></div><span class="section-count">{exams.length} {exams.length === 1 ? 'intento' : 'intentos'}</span></div>
      {exams.length ? <div class="account-table-wrap"><table class="account-table"><thead><tr><th>EXAMEN</th><th>FECHA DE INICIO</th><th>ESTADO</th><th>EVALUACIÓN</th><th></th></tr></thead><tbody>{exams.map(attempt => <tr><td><strong>{attempt.title}</strong><small>Intento {attempt.id.slice(0, 8)}</small></td><td>{date(attempt.startedAt)}</td><td><span class:list={['account-status', { gold: attempt.status === 'expired', green: attempt.status === 'submitted' }]}>{examStatus[attempt.status]}</span></td><td>{attempt.status === 'in_progress' ? 'Sin entregar' : 'Pendiente de revisión'}</td><td>{attempt.current && <a href="/examen/">{attempt.status === 'in_progress' ? 'Continuar →' : 'Ver entrega →'}</a>}</td></tr>)}</tbody></table></div> : <div class="account-empty"><span aria-hidden="true">▤</span><h3>Aún no has realizado exámenes</h3><p>Cuando comiences una evaluación, podrás consultar aquí tu intento y volver a su entrega.</p><a class="account-button secondary" href="/examen/">Ver examen disponible →</a></div>}
    </section>
  </>}
</AccountShell>
<script>
  import { initProfile } from '../account/profile-client';
  initProfile();
</script>
