---
export const prerender = false;
import AccountShell from '../account/AccountShell.astro';
import { currentUser } from '../lib/session';
import { loadExamHistory, loadProgress } from '../account/data';
import { todayInBogota } from '../account/profile';
import { getDbPool } from '../lib/db';

let user = null;
let exams: Awaited<ReturnType<typeof loadExamHistory>> = [];
let progress: Awaited<ReturnType<typeof loadProgress>> | null = null;
let unavailable = false;
try {
  user = await currentUser(Astro.cookies);
  if (user && user.role !== 'admin') {
    [exams, progress] = await Promise.all([loadExamHistory(user.id), loadProgress(user.id)]);
  }
} catch {
  unavailable = true;
}

if (!user && !unavailable) return Astro.redirect('/login?next=/perfil');
if (unavailable) Astro.response.status = 503;

const isAdmin = user?.role === 'admin';

let registeredAdmins: Array<{ id: string; email: string; displayName: string; createdAt: string }> = [];
if (isAdmin) {
  try {
    const db = getDbPool();
    const res = await db.query(
      `SELECT u.id, u.email, u.created_at, COALESCE(p.display_name, u.email) AS display_name
       FROM users u
       LEFT JOIN profiles p ON u.id = p.user_id
       WHERE u.role = 'admin'
       ORDER BY u.created_at ASC`
    );
    registeredAdmins = res.rows.map(r => ({
      id: r.id,
      email: r.email,
      displayName: r.display_name,
      createdAt: r.created_at ? new Date(r.created_at).toISOString() : new Date().toISOString(),
    }));
  } catch (err) {
    console.warn('Error cargando administradores:', err);
  }
}

const initials = user?.displayName
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map(n => n[0])
  .join('')
  .toUpperCase() || 'IS';

const date = (value: string) =>
  new Intl.DateTimeFormat('es-CO', { dateStyle: 'medium', timeZone: 'America/Bogota' }).format(new Date(value));

const birthdayLabel = user?.birthday
  ? new Intl.DateTimeFormat('es-CO', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${user.birthday}T12:00:00Z`))
  : 'Sin completar';

const examStatus = { in_progress: 'En curso', submitted: 'Entregado', expired: 'Tiempo finalizado' };

const competencias = progress?.topics.map(topic => ({
  label: topic.name,
  subLabel: `${topic.completed} de ${topic.total} ejercicios con pruebas públicas superadas`,
  pct: Math.round(topic.completed / topic.total * 100),
  color: '#3776AB',
})) ?? [];
const nextStep = progress?.feedback[0];
const historial = progress?.recent ?? [];
const resultLabels = { pending: 'En curso', passed: 'Correcto', failed: 'Por revisar', technical_error: 'Error técnico', cancelled: 'Cancelado' };
const activityDate = (value: string) => new Intl.DateTimeFormat('es-CO', {
  dateStyle: 'medium', timeStyle: 'short', timeZone: 'America/Bogota',
}).format(new Date(value));
---

<AccountShell title={isAdmin ? "Administración de Accesos" : "Mi perfil"} description={isAdmin ? "Gestión de cuentas y habilitación de administradores en PyLevel." : "Tus datos, tu cuenta y tu actividad en PyLevel."} active="perfil" isAdmin={isAdmin}>
  {unavailable || !user ? (
    <section class="account-card account-empty">
      <h2>No pudimos cargar tu perfil</h2>
      <p>Tu información sigue guardada. Vuelve a intentar cuando el servicio esté disponible.</p>
      <a class="account-button secondary" href="/perfil">Volver a intentar</a>
    </section>
  ) : isAdmin ? (
    <div class="admin-view-wrap">
      <!-- Tarjeta: Habilitar Administrador -->
      <section class="account-card" aria-labelledby="add-admin-title">
        <div class="section-top">
          <div>
            <span class="account-label">CONTROL DE ACCESOS</span>
            <h2 id="add-admin-title" style="margin-top: 6px;">Habilitar Nuevo Administrador</h2>
            <p class="account-muted">Ingresa el nombre y correo electrónico. El sistema habilitará inmediatamente los privilegios de administrador para esa cuenta.</p>
          </div>
        </div>

        <form id="add-admin-form" class="add-admin-form">
          <div class="admin-fields-row">
            <div class="form-group flex-1">
              <label for="admin-name">Nombre completo</label>
              <input
                type="text"
                id="admin-name"
                name="name"
                class="admin-text-input"
                placeholder="Ej. Carlos Mendoza"
                required
              />
            </div>
            <div class="form-group flex-1">
              <label for="admin-email">Correo electrónico</label>
              <input
                type="email"
                id="admin-email"
                name="email"
                class="admin-text-input"
                placeholder="admin@pylevel.dev"
                required
              />
            </div>
          </div>
          <div class="admin-form-actions">
            <button type="submit" id="btn-submit-admin" class="account-button primary">
              Habilitar Administrador →
            </button>
            <span id="add-admin-feedback" class="admin-feedback" style="display: none;"></span>
          </div>
        </form>
      </section>

      <!-- Tarjeta: Lista de Administradores Registrados -->
      <section class="account-card account-section" aria-labelledby="admins-table-title">
        <div class="section-top">
          <div>
            <h2 id="admins-table-title">Administradores Habilitados</h2>
            <p class="account-muted">Cuentas autorizadas para gestionar ejercicios, revisar métricas y supervisar el sistema.</p>
          </div>
          <span class="section-count" id="admin-count-pill">{registeredAdmins.length} {registeredAdmins.length === 1 ? 'cuenta' : 'cuentas'}</span>
        </div>

        <div class="account-table-wrap">
          <table class="account-table">
            <thead>
              <tr>
                <th>NOMBRE</th>
                <th>CORREO ELECTRÓNICO</th>
                <th>FECHA DE ALTA</th>
                <th>ESTADO</th>
              </tr>
            </thead>
            <tbody id="admins-table-rows">
              {registeredAdmins.map(adm => (
                <tr>
                  <td><strong>{adm.displayName}</strong></td>
                  <td><code>{adm.email}</code></td>
                  <td>{date(adm.createdAt)}</td>
                  <td><span class="account-status green">Habilitado</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Sesión activa del administrador -->
      <aside class="account-card admin-session-card">
        <div class="admin-session-left">
          <span class="account-label">SESIÓN ACTIVA</span>
          <h3>{user.displayName}</h3>
          <p class="account-muted">Conectado como <strong>{user.email}</strong> con rol de Administrador.</p>
        </div>
        <div>
          <button id="admin-logout-btn" class="account-button danger" type="button">Cerrar sesión</button>
        </div>
      </aside>
    </div>
  ) : (
    <>
      <div class="account-grid">
        <section class="account-card" aria-labelledby="personal-title">
          <div class="profile-identity">
            <div class="profile-avatar" id="account-avatar" aria-hidden="true">{initials}</div>
            <div>
              <h2 id="account-name">{user.displayName}</h2>
              <p id="account-occupation">{user.occupation || 'Completa tu ocupación'}</p>
            </div>
          </div>

          <form id="profile-form" class="profile-form">
            <div class="profile-form-grid">
              <div class="profile-field">
                <label for="profile-name">Nombre completo</label>
                <input id="profile-name" name="displayName" autocomplete="name" maxlength="100" value={user.displayName} required />
              </div>
              <div class="profile-field">
                <label for="profile-occupation">Ocupación</label>
                <input id="profile-occupation" name="occupation" autocomplete="organization-title" maxlength="100" placeholder="Ej. Estudiante de ingeniería" value={user.occupation || ''} />
              </div>
              <div class="profile-field">
                <label for="profile-birthday">Cumpleaños</label>
                <input id="profile-birthday" name="birthday" type="date" autocomplete="bday" min="1900-01-01" max={todayInBogota()} value={user.birthday || ''} />
                <small>Solo se muestra en tu perfil.</small>
              </div>
              <div class="profile-field">
                <label for="profile-email">Correo electrónico</label>
                <input id="profile-email" name="email" type="email" autocomplete="email" maxlength="254" value={user.email} required />
                <small>Este es el correo con el que inicias sesión.</small>
              </div>
              <div class="profile-field full" id="email-password-field" hidden>
                <label for="profile-password">Confirma tu contraseña actual</label>
                <input id="profile-password" name="currentPassword" type="password" autocomplete="current-password" maxlength="200" />
                <small>Necesaria para cambiar el correo. Se cerrarán tus otras sesiones.</small>
              </div>
            </div>
            <div class="profile-actions">
              <span class="account-muted">Los cambios se guardan en tu cuenta.</span>
              <button class="account-button primary" id="profile-save" type="submit">Guardar cambios →</button>
            </div>
            <p id="profile-status" class="account-notice" role="status" aria-live="polite" hidden></p>
          </form>
        </section>

        <aside class="account-card" aria-labelledby="account-title">
          <span class="account-label">TU CUENTA</span>
          <h2 id="account-title" style="margin-top:12px">Un espacio personal</h2>
          <dl class="account-details">
            <div>
              <dt>CORREO DE ACCESO</dt>
              <dd id="account-email">{user.email}</dd>
            </div>
            <div>
              <dt>CUMPLEAÑOS</dt>
              <dd id="account-birthday">{birthdayLabel}</dd>
            </div>
            <div>
              <dt>MIEMBRO DESDE</dt>
              <dd>{date(user.createdAt)}</dd>
            </div>
            <div>
              <dt>ROL EN PLATAFORMA</dt>
              <dd>Estudiante</dd>
            </div>
          </dl>
          <div class="profile-session">
            <h3>Sesión actual</h3>
            <p class="account-muted">Cierra tu sesión al terminar si utilizas un equipo compartido.</p>
            <button id="profile-logout" class="account-button danger" type="button">Cerrar sesión</button>
            <p id="logout-status" class="account-muted" role="status"></p>
          </div>
        </aside>
      </div>

      {nextStep && (
        <section class="priority-banner" aria-labelledby="priority-heading">
          <div class="pb-content">
            <div class="pb-badge"><span class="pb-dot" aria-hidden="true"></span>TU SIGUIENTE PASO</div>
            <h2 id="priority-heading">{nextStep.title}</h2>
            <p>{nextStep.text}</p>
            <div class="pb-actions">
              <a href={nextStep.href} class="account-button primary">{nextStep.action} →</a>
              <a href="/progreso/" class="account-button secondary">Ver progreso y métricas</a>
            </div>
          </div>
          <div class="pb-meta">
            <div class="pb-stat"><span class="pbs-label">EJERCICIOS SUPERADOS</span><span class="pbs-value">{progress?.completed.length} de {progress?.total}</span></div>
            <div class="pb-stat"><span class="pbs-label">EJECUCIONES Y PRUEBAS</span><span class="pbs-value">{progress?.attempts}</span></div>
            <div class="pb-stat"><span class="pbs-label">EJERCICIOS EN PROGRESO</span><span class="pbs-value">{progress?.inProgress}</span></div>
          </div>
        </section>
      )}

      <!-- Avance real de práctica por tema -->
      <section class="account-card account-section" aria-labelledby="comp-heading">
        <div class="section-top">
          <div>
            <h2 id="comp-heading">Avance por temas</h2>
            <p class="account-muted">Ejercicios superados por tema. Estos porcentajes no representan una calificación de competencias.</p>
          </div>
        </div>

        <div class="comp-matrix">
          {competencias.map(c => (
            <div class="comp-block">
              <div class="cb-header">
                <div>
                  <h3>{c.label}</h3>
                  <p class="account-muted">{c.subLabel}</p>
                </div>
                <span class="cb-pct" style={`color:${c.color}`}>{c.pct}%</span>
              </div>
              <div class="bar-main-bg" role="progressbar" aria-label={`Ejercicios superados en ${c.label}`} aria-valuemin="0" aria-valuemax="100" aria-valuenow={c.pct}>
                <div class="bar-main-fill" style={`width:${c.pct}%;background:${c.color}`}></div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Historial de práctica -->
      <section class="account-card account-section" aria-labelledby="hist-heading">
        <div class="section-top">
          <div>
            <h2 id="hist-heading">Historial de práctica</h2>
            <p class="account-muted">Últimas ejecuciones y pruebas registradas en tu cuenta.</p>
          </div>
        </div>
        {historial.length ? (
          <div class="account-table-wrap">
            <table class="account-table">
              <thead><tr><th>EJERCICIO</th><th>ACCIÓN</th><th>RESULTADO</th><th>FECHA</th></tr></thead>
              <tbody>
                {historial.map(item => (
                  <tr>
                    <td><a href={item.href}><strong>{item.title}</strong></a><small>{item.mode === 'classic' ? 'Clásico' : 'Contextualizado'}</small></td>
                    <td>{item.kind === 'test' ? 'Pruebas públicas' : 'Ejecutar código'}</td>
                    <td>
                      <span class:list={['account-status', item.result === 'passed' ? 'green' : item.result === 'failed' ? 'gold' : 'muted']}>
                        {item.result === 'passed' && item.kind === 'test' ? 'Pruebas superadas' : resultLabels[item.result]}
                      </span>
                      {item.kind === 'test' && item.testsRun > 0 && <small>{item.testsRun} pruebas ejecutadas</small>}
                    </td>
                    <td>{activityDate(item.createdAt)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="account-empty">
            <h3>Aún no hay práctica registrada</h3>
            <p>Ejecuta una solución o prueba un ejercicio para empezar tu historial.</p>
            <a class="account-button secondary" href="/ejercicios/">Elegir un ejercicio →</a>
          </div>
        )}
      </section>

      <!-- Mis Exámenes -->
      <section class="account-card account-section" aria-labelledby="exams-title">
        <div class="section-top">
          <div>
            <h2 id="exams-title">Mis exámenes</h2>
            <p class="account-muted">Evaluaciones asociadas a tu cuenta y su estado actual.</p>
          </div>
          <span class="section-count">{exams.length} {exams.length === 1 ? 'intento' : 'intentos'}</span>
        </div>
        {exams.length ? (
          <div class="account-table-wrap">
            <table class="account-table">
              <thead>
                <tr>
                  <th>EXAMEN</th>
                  <th>FECHA DE INICIO</th>
                  <th>ESTADO</th>
                  <th>EVALUACIÓN</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {exams.map(attempt => (
                  <tr>
                    <td>
                      <strong>{attempt.title}</strong>
                      <small>Intento {attempt.id.slice(0, 8)}</small>
                    </td>
                    <td>{date(attempt.startedAt)}</td>
                    <td>
                      <span class:list={['account-status', { gold: attempt.status === 'expired', green: attempt.status === 'submitted' }]}>
                        {examStatus[attempt.status]}
                      </span>
                    </td>
                    <td>{attempt.status === 'in_progress' ? 'Sin entregar' : 'Pendiente de revisión'}</td>
                    <td>
                      {attempt.current && (
                        <a href="/examen/">{attempt.status === 'in_progress' ? 'Continuar →' : 'Ver entrega →'}</a>
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="account-empty">
            <span aria-hidden="true">▤</span>
            <h3>Aún no has realizado exámenes</h3>
            <p>Cuando comiences una evaluación, podrás consultar aquí tu intento y volver a su entrega.</p>
            <a class="account-button secondary" href="/examen/">Ver examen disponible →</a>
          </div>
        )}
      </section>
    </>
  )}
</AccountShell>

<script>
  // Inicialización de perfil de estudiante
  const profileForm = document.getElementById('profile-form');
  if (profileForm) {
    import('../account/profile-client').then(({ initProfile }) => initProfile());
  }

  // Lógica exclusiva de administración: Agregar administradores
  const addAdminForm = document.getElementById('add-admin-form') as HTMLFormElement | null;
  const adminNameInput = document.getElementById('admin-name') as HTMLInputElement | null;
  const adminEmailInput = document.getElementById('admin-email') as HTMLInputElement | null;
  const btnSubmitAdmin = document.getElementById('btn-submit-admin') as HTMLButtonElement | null;
  const addAdminFeedback = document.getElementById('add-admin-feedback') as HTMLElement | null;
  const adminsTableRows = document.getElementById('admins-table-rows');
  const adminCountPill = document.getElementById('admin-count-pill');

  if (addAdminForm && adminNameInput && adminEmailInput && btnSubmitAdmin && addAdminFeedback) {
    addAdminForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = adminNameInput.value.trim();
      const email = adminEmailInput.value.trim();

      if (!name || !email) {
        addAdminFeedback.textContent = 'Por favor completa el nombre y el correo.';
        addAdminFeedback.className = 'admin-feedback error';
        addAdminFeedback.style.display = 'inline-block';
        return;
      }

      btnSubmitAdmin.disabled = true;
      btnSubmitAdmin.textContent = 'Habilitando...';
      addAdminFeedback.style.display = 'none';

      try {
        const res = await fetch('/api/admin/admins', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email }),
        });

        const data = await res.json();
        if (!res.ok || !data.success) {
          addAdminFeedback.textContent = data.error || 'No se pudo habilitar el administrador.';
          addAdminFeedback.className = 'admin-feedback error';
          addAdminFeedback.style.display = 'inline-block';
          btnSubmitAdmin.disabled = false;
          btnSubmitAdmin.textContent = 'Habilitar Administrador →';
          return;
        }

        addAdminFeedback.textContent = data.message || `Administrador ${name} habilitado con éxito.`;
        addAdminFeedback.className = 'admin-feedback success';
        addAdminFeedback.style.display = 'inline-block';

        // Agregar fila a la tabla si no existe
        if (adminsTableRows && data.admin) {
          const existingRow = Array.from(adminsTableRows.querySelectorAll('tr')).find(
            tr => tr.textContent?.toLowerCase().includes(data.admin.email.toLowerCase())
          );

          if (!existingRow) {
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td><strong>${data.admin.displayName}</strong></td>
              <td><code>${data.admin.email}</code></td>
              <td>Hoy</td>
              <td><span class="account-status green">Habilitado</span></td>
            `;
            adminsTableRows.appendChild(tr);
            if (adminCountPill) {
              const currentTotal = adminsTableRows.querySelectorAll('tr').length;
              adminCountPill.textContent = `${currentTotal} ${currentTotal === 1 ? 'cuenta' : 'cuentas'}`;
            }
          }
        }

        adminNameInput.value = '';
        adminEmailInput.value = '';
      } catch (err) {
        addAdminFeedback.textContent = 'Error de conexión con el servidor.';
        addAdminFeedback.className = 'admin-feedback error';
        addAdminFeedback.style.display = 'inline-block';
      } finally {
        btnSubmitAdmin.disabled = false;
        btnSubmitAdmin.textContent = 'Habilitar Administrador →';
      }
    });
  }

  // Logout para administrador
  const adminLogoutBtn = document.getElementById('admin-logout-btn');
  if (adminLogoutBtn) {
    adminLogoutBtn.addEventListener('click', async () => {
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
        localStorage.removeItem('pylevel:current_user');
        window.location.href = '/login';
      } catch {
        window.location.href = '/login';
      }
    });
  }
</script>

<style>
  /* Vista Exclusiva de Administrador */
  .admin-view-wrap {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 18px;
  }

  .add-admin-form {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .admin-fields-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .flex-1 {
    flex: 1;
    min-width: 240px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font: 600 11px ui-monospace, monospace;
    letter-spacing: 0.5px;
    color: #94A3B8;
  }

  .admin-text-input {
    width: 100%;
    padding: 10px 14px;
    background: #0B1120;
    border: 1px solid #1E293B;
    border-radius: 8px;
    color: #F8FAFC;
    font-size: 13.5px;
    box-sizing: border-box;
    font-family: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .admin-text-input:focus {
    outline: none;
    border-color: #38BDF8;
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
  }

  .admin-form-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .admin-feedback {
    font-size: 12.5px;
    padding: 6px 12px;
    border-radius: 6px;
    line-height: 1.4;
  }

  .admin-feedback.success {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34D399;
  }

  .admin-feedback.error {
    background: rgba(244, 63, 94, 0.12);
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #F43F5E;
  }

  .admin-session-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid #1E293B;
    padding: 20px 24px;
  }

  .admin-session-left h3 {
    margin: 4px 0 2px;
    font-size: 16px;
    color: #F8FAFC;
  }

  /* Estilos originales de estudiante */
  .priority-banner {
    background: linear-gradient(135deg, rgba(15, 31, 56, 0.8) 0%, rgba(17, 24, 39, 0.9) 100%);
    border: 1px solid rgba(55, 118, 171, 0.4);
    border-radius: 14px;
    padding: 28px 32px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: start;
    margin-top: 24px;
  }
  .pb-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 10px ui-monospace, monospace;
    letter-spacing: 1.5px;
    color: #ffd43b;
    margin-bottom: 12px;
  }
  .pb-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ffd43b;
    animation: blink 2s ease-in-out infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .priority-banner h2 {
    font-size: 24px;
    letter-spacing: -0.8px;
    color: #e2e8f0;
    margin: 0 0 10px;
  }
  .priority-banner p {
    font-size: 13px;
    line-height: 1.7;
    color: #94a3b8;
    margin: 0 0 20px;
    max-width: 600px;
  }
  .pb-actions {
