---
import AppLayout from '../layouts/AppLayout.astro';
import { catalogs, modePaths } from '../core/catalog';
import { classic } from '../core/classic-exercises';

const contextualExercises = catalogs.contextual;
const classicExercises = classic;

// Datos simulados de competencias — marcados como DEMO
const competencias = [
  {
    id: 'comprension',
    label: 'Comprensión de código ajeno',
    subLabel: 'Capacidad para leer, navegar y entender arquitectura multiarchivo preexistente',
    pct: 68,
    evidencias: [
      { label: 'Comprensión de causa raíz',   pct: 72 },
      { label: 'Calidad de la corrección',     pct: 65 },
      { label: 'Eficacia de verificación',     pct: 60 },
    ],
    color: '#3776AB',
  },
  {
    id: 'depuracion',
    label: 'Depuración y localización de defectos',
    subLabel: 'Identificación y corrección de bugs en código con errores de diseño',
    pct: 52,
    evidencias: [
      { label: 'Localización del defecto',     pct: 58 },
      { label: 'Precisión de la corrección',   pct: 50 },
      { label: 'Cobertura de casos límite',    pct: 44 },
    ],
    color: '#3776AB',
  },
  {
    id: 'validacion',
    label: 'Validación de reglas de dominio',
    subLabel: 'Aplicación de restricciones de negocio (unidades vs peso, solapamiento, idempotencia)',
    pct: 41,
    evidencias: [
      { label: 'Reglas de dominio',            pct: 45 },
      { label: 'Casos límite cubiertos',       pct: 38 },
      { label: 'No regresión verificada',      pct: 35 },
    ],
    color: '#FFD43B',
  },
  {
    id: 'regresion',
    label: 'Verificación y control de regresión',
    subLabel: 'Garantía de que las correcciones no rompen funcionalidad preexistente',
    pct: 27,
    evidencias: [
      { label: 'Pruebas existentes preservadas', pct: 30 },
      { label: 'Casos nuevos añadidos',          pct: 25 },
      { label: 'Robustez general',               pct: 22 },
    ],
    color: '#10B981',
  },
];

// Historial de entregas auditado — representativo de los 3 estados deterministas del motor
const historial = [
  {
    id: 'hist-001',
    ejercicio: '01_inventario_juan',
    titulo: 'Inventario de Juan',
    fecha: '2026-10-15 21:47',
    intento: 2,
    estado: 'EVALUADA' as const,
    resultado: 'Pruebas funcionales y de regresión superadas. Rechaza correctamente 7.5 manzanas (por unidad), acepta 7 manzanas y 1.5 kg arroz (por peso).',
    duracion: '4.2s',
  },
  {
    id: 'hist-002',
    ejercicio: '01_inventario_juan',
    titulo: 'Inventario de Juan',
    fecha: '2026-10-15 21:31',
    intento: 1,
    estado: 'EVALUADA' as const,
    resultado: 'FALLIDO — Fallo en caso límite: aceptó cantidad fraccionaria (0.5) en producto por unidad. test_rechaza_fraccionario_por_unidad: FAILED.',
    duracion: '3.8s',
    fallo: true,
  },
  {
    id: 'hist-003',
    ejercicio: '02_agenda_salas',
    titulo: 'Reservas de salas',
    fecha: '2026-10-15 20:15',
    intento: 1,
    estado: 'ENTREGA_INVALIDA' as const,
    resultado: 'Estructura de archivos incompleta o error de sintaxis previo a ejecución. reservas.py: SyntaxError en línea 14.',
    duracion: '—',
  },
  {
    id: 'hist-004',
    ejercicio: '03_pagos_factura',
    titulo: 'Pagos de facturas',
    fecha: '2026-10-15 19:58',
    intento: 1,
    estado: 'ERROR_TECNICO' as const,
    resultado: 'Timeout / Excepción de infraestructura en Sandbox gVisor (10s excedidos). Calificación no imputada (0 penalización académica).',
    duracion: '10.0s',
  },
];

type EstadoMotor = 'EVALUADA' | 'ENTREGA_INVALIDA' | 'ERROR_TECNICO';

const estadoConfig: Record<EstadoMotor, { cls: string; label: string }> = {
  'EVALUADA':         { cls: 'state-ok',   label: 'EVALUADA' },
  'ENTREGA_INVALIDA': { cls: 'state-warn', label: 'ENTREGA_INVALIDA' },
  'ERROR_TECNICO':    { cls: 'state-err',  label: 'ERROR_TECNICO' },
};
---

<AppLayout
  title="Panel de Control y Perfil · PyLevel"
  description="Panel central de control del estudiante en PyLevel: métricas de competencias, reto prioritario, actividad reciente y auditoría del motor evaluador."
>
  <div class="control-center">

    <!-- ── Cabecera del Estudiante con Estado de Cuenta PostgreSQL ── -->
    <header class="student-header">
      <div class="sh-left">
        <div class="sh-avatar" id="profile-avatar" aria-hidden="true">IS</div>
        <div class="sh-info">
          <div class="sh-title-row">
            <h1 id="profile-name">Estudiante — Ingeniería de Software</h1>
            <span class="account-badge" id="account-status-badge">Cuenta Activa</span>
          </div>
          <p class="sh-meta">
            <span id="profile-email">estudiante@pylevel.dev</span>
            <span class="sh-sep" aria-hidden="true">·</span>
            <span>Semestre VI</span>
            <span class="sh-sep" aria-hidden="true">·</span>
            <span>Calidad y Pruebas de Software</span>
          </p>
          <p class="sh-id">ID de Sesión: <code id="profile-id">STU-ISW-2026-DEMO</code></p>
        </div>
      </div>

      <!-- Badge de demostración — Obligatorio por reglamento estricto de asignatura -->
      <div class="demo-notice" role="note" aria-label="Aviso de demostración longitudinal">
        <div class="dn-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div class="dn-text">
          <strong>Datos de demostración — Simulación de perfil longitudinal</strong>
          <span>Métricas simuladas para contrato visual. Las entregas reales se registran directamente en el Workbench gVisor.</span>
        </div>
      </div>
    </header>

    <!-- ── Banner prioritario: Continuar Reto de Referencia ─────────────── -->
    <section class="priority-banner" aria-labelledby="priority-heading">
      <div class="pb-content">
        <div class="pb-badge">
          <span class="pb-dot" aria-hidden="true"></span>
          RETO PRIORITARIO DE REFERENCIA — EN CURSO
        </div>
        <h2 id="priority-heading">
          <span class="ph-accent">01.</span> Inventario de Juan
        </h2>
        <p>
          Corrige la lógica de ventas del sistema de inventario: debe rechazar cantidades
          fraccionarias en productos vendidos por unidad (como manzanas), permitiendo a la vez
          cantidades decimales en productos por peso (como arroz o harina). Todas las pruebas
          de regresión deben superarse sin alterar el contrato público.
        </p>
        <div class="pb-actions">
          <a href="/ejercicios/contextualizados/01_inventario_juan" class="pb-btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Continuar en Workbench
          </a>
          <a href="/ejercicios" class="pb-btn-ghost">Ver todas las modalidades →</a>
        </div>
      </div>
      <div class="pb-meta" aria-hidden="true">
        <div class="pb-stat">
          <span class="pbs-label">COMPETENCIAS EVALUADAS</span>
          <span class="pbs-value">Reglas de Dominio · Casos Límite · No Regresión</span>
        </div>
        <div class="pb-stat">
          <span class="pbs-label">ARCHIVOS INVOLUCRADOS</span>
          <span class="pbs-value pbs-mono">modelos.py · ventas.py · main.py</span>
        </div>
        <div class="pb-stat">
          <span class="pbs-label">ESTADO DETERMINISTA</span>
          <span class="state-pending">● PENDIENTE DE VALIDACIÓN</span>
        </div>
      </div>
    </section>

    <!-- ── Resumen de Métricas Rápidas ───────────────────────── -->
    <div class="stats-row" aria-label="Estadísticas de evaluación">
      <div class="stat-card">
        <span class="sc-value">4</span>
        <span class="sc-label">Entregas auditadas</span>
        <span class="sc-demo">[Demo]</span>
      </div>
      <div class="stat-card">
        <span class="sc-value sc-value--green">1</span>
        <span class="sc-label">Retos evaluados OK</span>
        <span class="sc-demo">[Demo]</span>
      </div>
      <div class="stat-card">
        <span class="sc-value sc-value--yellow">4</span>
        <span class="sc-label">Competencias monitoreadas</span>
        <span class="sc-demo">[Demo]</span>
      </div>
      <div class="stat-card">
        <span class="sc-value sc-value--blue">8</span>
        <span class="sc-label">Retos disponibles en catálogo</span>
        <span class="sc-demo">CATÁLOGO ACTIVO</span>
      </div>
    </div>

    <!-- ── Grid Principal: Competencias + Actividad Local ────── -->
    <div class="main-grid">

      <!-- Columna Izquierda: Matriz Longitudinal de Competencias -->
      <section class="panel" aria-labelledby="comp-heading">
        <div class="panel-header">
          <h2 id="comp-heading">Resumen de Competencias Evaluadas</h2>
          <span class="demo-badge-sm">Datos de demostración — Simulación de perfil longitudinal</span>
        </div>
        <p class="panel-note">
          Evaluación continua del estudiante basada en evidencia de desempeño sobre código real.
          Sin autoevaluación subjetiva.
        </p>

        <div class="comp-matrix">
          {competencias.map(c => (
            <div class="comp-block">
              <div class="cb-header">
                <div class="cb-info">
                  <h3>{c.label}</h3>
                  <p>{c.subLabel}</p>
                </div>
                <span class="cb-pct" style={`color:${c.color}`}>{c.pct}%</span>
              </div>

              <!-- Barra principal -->
              <div class="bar-main-bg" role="progressbar" aria-valuenow={c.pct} aria-valuemin={0} aria-valuemax={100} aria-label={`${c.label}: ${c.pct}%`}>
                <div class="bar-main-fill" style={`width:${c.pct}%;background:${c.color}`}></div>
              </div>

              <!-- Desglose de sub-evidencias -->
              <div class="evidencias">
                {c.evidencias.map(ev => (
                  <div class="ev-item">
                    <span class="ev-label">{ev.label}</span>
                    <div class="ev-bar-bg">
                      <div class="ev-bar-fill" style={`width:${ev.pct}%;background:${c.color}90`}></div>
                    </div>
                    <span class="ev-pct">{ev.pct}%</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Columna Derecha: Lector LocalStorage y Proyectos Disponibles -->
      <aside class="side-column">

        <!-- Lector de localStorage de workspace.ts -->
        <section class="panel panel--small" aria-labelledby="ls-heading">
          <div class="panel-header">
            <h2 id="ls-heading">Actividad Reciente en Workbench</h2>
            <span class="live-dot" title="Sincronizado con localStorage local"></span>
          </div>
          <p class="panel-note">Borradores y código guardado localmente en este navegador (claves <code>pylevel:&#123;id&#125;</code>):</p>
          
          <div id="local-activity-list" class="local-activity-box">
            <p class="empty-local">Buscando borradores guardados...</p>
          </div>
        </section>

        <!-- Proyectos contextualizados disponibles -->
        <section class="panel panel--small" aria-labelledby="projects-heading">
          <div class="panel-header">
            <h2 id="projects-heading">Proyectos Contextualizados</h2>
            <a href="/ejercicios/contextualizados/" class="panel-link">Ver todos →</a>
          </div>
          <ul class="quick-projects-list">
            {contextualExercises.map((ex) => (
              <li class="qp-item">
                <div class="qp-info">
                  <a href={`/ejercicios/${modePaths['contextual']}/${ex.id}/`} class="qp-title">{ex.title}</a>
                  <span class="qp-diff">{ex.difficulty}</span>
                </div>
                <a href={`/ejercicios/${modePaths['contextual']}/${ex.id}/`} class="qp-btn" title="Abrir en Workbench">
                  →
                </a>
              </li>
            ))}
          </ul>
        </section>

        <!-- Leyenda de Estados del Motor -->
        <section class="panel panel--small" aria-labelledby="legend-heading">
          <h2 id="legend-heading">Estados Deterministas del Motor</h2>
          <div class="state-legend-list">
            <div class="sll-item">
              <span class="s-chip s-ok">EVALUADA</span>
              <p>Código válido y suite de pruebas ejecutada. Solución verificada.</p>
            </div>
            <div class="sll-item">
              <span class="s-chip s-warn">ENTREGA_INVALIDA</span>
              <p>Error de sintaxis o estructura de archivos incompleta antes de la ejecución.</p>
            </div>
            <div class="sll-item">
              <span class="s-chip s-err">ERROR_TECNICO</span>
              <p>Fallo de infraestructura en sandbox gVisor. <strong>Sin penalización académica.</strong></p>
            </div>
          </div>
        </section>

      </aside>
    </div>

    <!-- ── Historial y Auditoría de Entregas ───────────────────── -->
    <section class="panel panel--full" aria-labelledby="hist-heading">
      <div class="panel-header">
        <h2 id="hist-heading">Auditoría del Motor Evaluador — Historial de Envíos</h2>
        <span class="demo-badge-sm">Datos de demostración — Simulación de perfil longitudinal</span>
      </div>
      <p class="panel-note">
        Registro inmutable de los resultados devueltos por el sandbox Docker/gVisor. Cada intento
        refleja con precisión la categoría de veredicto técnico.
      </p>

      <!-- Tabla de historial -->
      <div class="table-wrapper" role="region" aria-label="Tabla de historial de entregas" tabindex="0">
        <table class="submissions-table">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Ejercicio</th>
              <th scope="col">Intento</th>
              <th scope="col">Fecha / Hora</th>
              <th scope="col">Estado Determinista</th>
              <th scope="col">Diagnóstico / Salida de Ejecución</th>
              <th scope="col">Tiempo</th>
            </tr>
          </thead>
          <tbody>
            {historial.map((h, i) => (
              <tr class={`sub-row sub-row--${h.estado.toLowerCase().replace(/_/g, '-')}${h.fallo ? ' sub-row--failed' : ''}`}>
                <td class="col-num">{historial.length - i}</td>
                <td class="col-exercise">
                  <a href={`/ejercicios/contextualizados/${h.ejercicio}/`} class="ex-link">
                    {h.titulo}
                  </a>
                  <code class="ex-id">{h.ejercicio}</code>
                </td>
                <td class="col-attempt">
                  <span class="attempt-badge">#{h.intento}</span>
                </td>
                <td class="col-date">
                  <code>{h.fecha}</code>
                </td>
                <td class="col-state">
                  <span class={`s-chip ${estadoConfig[h.estado].cls}`}>
                    {estadoConfig[h.estado].label}
                  </span>
                  {h.estado === 'ERROR_TECNICO' && (
                    <span class="infra-note">Fallo de infraestructura</span>
                  )}
                </td>
                <td class="col-detail">{h.resultado}</td>
                <td class="col-dur"><code>{h.duracion}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Nota de garantía sobre ERROR_TECNICO -->
      <div class="err-disclaimer" role="note">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>
          <strong>Garantía de evaluación imparcial:</strong> Los estados <code>ERROR_TECNICO</code> corresponden a excepciones
          del sandbox o timeouts del contenedor supervisor gVisor. Están expresamente catalogados como no imputables al estudiante, garantizando cero penalización académica.
        </span>
      </div>
    </section>

  </div>
</AppLayout>

<!-- Script para Lector de LocalStorage (claves pylevel:{id}) y Datos de Sesión PostgreSQL -->
<script>
  // 1. Sincronizar datos de usuario autenticado en PostgreSQL Render
  function syncUserProfile() {
    const rawUser = localStorage.getItem('pylevel:current_user');
    if (rawUser) {
      try {
        const u = JSON.parse(rawUser);
        const nameEl = document.getElementById('profile-name');
        const emailEl = document.getElementById('profile-email');
        const avatarEl = document.getElementById('profile-avatar');
        const idEl = document.getElementById('profile-id');
        const badgeEl = document.getElementById('account-status-badge');

        if (nameEl && u.displayName) nameEl.textContent = u.displayName;
        if (emailEl && u.email) emailEl.textContent = u.email;
        if (idEl && u.id) idEl.textContent = u.id;
        if (badgeEl) {
          badgeEl.textContent = 'PostgreSQL Conectado';
          badgeEl.classList.add('account-badge--active');
        }

        if (avatarEl && (u.displayName || u.email)) {
          const initials = (u.displayName || u.email)
            .split(' ')
            .map((s: string) => s[0])
            .slice(0, 2)
            .join('')
            .toUpperCase();
          avatarEl.textContent = initials || 'IS';
        }
      } catch {}
    }
  }

  // 2. Lector de borradores locales usando el formato exacto de workspace.ts (`pylevel:${id}`)
  function scanLocalWorkspace() {
    const exerciseCatalog = [
      { id: '01_inventario_juan', label: '01. Inventario de Juan', path: '/ejercicios/contextualizados/01_inventario_juan/' },
      { id: '02_agenda_salas',    label: '02. Reservas de Salas',   path: '/ejercicios/contextualizados/02_agenda_salas/' },
      { id: '03_pagos_factura',   label: '03. Pagos y Facturas',    path: '/ejercicios/contextualizados/03_pagos_factura/' },
      { id: 'clasico_operadores_logicos', label: '¿Puede acceder?', path: '/ejercicios/clasicos/clasico_operadores_logicos/' },
      { id: 'clasico_sumar_pares', label: 'Sumar números pares', path: '/ejercicios/clasicos/clasico_sumar_pares/' },
      { id: 'clasico_condicional_if', label: 'Positivo, negativo o cero', path: '/ejercicios/clasicos/clasico_condicional_if/' },
      { id: 'clasico_bubble_sort', label: 'Ordenar con Bubble Sort', path: '/ejercicios/clasicos/clasico_bubble_sort/' },
      { id: 'clasico_lambda', label: 'Transformar con Lambda', path: '/ejercicios/clasicos/clasico_lambda/' },
    ];

    const listBox = document.getElementById('local-activity-list');
    if (!listBox) return;

    const detected: Array<{ id: string; label: string; path: string; fileCount: number }> = [];

    for (const item of exerciseCatalog) {
      try {
        const stored = localStorage.getItem(`pylevel:${item.id}`);
        if (stored) {
          const parsed = JSON.parse(stored);
          if (parsed && typeof parsed === 'object') {
            const count = Object.keys(parsed).length;
            detected.push({ ...item, fileCount: count });
          }
        }
      } catch {}
    }

    if (detected.length > 0) {
      listBox.innerHTML = `
        <div class="local-detected">
          <p class="ld-msg"><strong>${detected.length}</strong> borrador(es) activo(s) en tu navegador:</p>
          <ul class="ld-list">
            ${detected.map(d => `
              <li class="ld-item">
                <div class="ld-info">
                  <span class="ld-dot">●</span>
                  <a href="${d.path}" class="ld-link">${d.label}</a>
                  <span class="ld-count">(${d.fileCount} arch.)</span>
                </div>
                <a href="${d.path}" class="ld-btn">Abrir</a>
              </li>
            `).join('')}
          </ul>
        </div>
      `;
    } else {
      listBox.innerHTML = `
        <div class="ld-empty">
          <p>Aún no tienes borradores guardados localmente.</p>
          <a href="/ejercicios/contextualizados/01_inventario_juan" class="ld-cta">Abrir Inventario de Juan para empezar →</a>
        </div>
      `;
    }
  }

  syncUserProfile();
  scanLocalWorkspace();
  document.addEventListener('astro:page-load', () => {
    syncUserProfile();
    scanLocalWorkspace();
  });
</script>

<style>
  .control-center {
    max-width: 1300px;
    margin: 0 auto;
    padding: 32px 24px 80px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* ── Cabecera del Estudiante ── */
  .student-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    background: #111827;
    border: 1px solid #1E293B;
    border-radius: 14px;
    padding: 28px 32px;
    flex-wrap: wrap;
  }

  .sh-left { display: flex; align-items: center; gap: 20px; }

  .sh-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #3776AB;
    color: #fff;
    font-size: 20px;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    letter-spacing: 1px;
    box-shadow: 0 0 12px rgba(55,118,171,0.3);
  }

  .sh-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 6px;
  }

  .sh-info h1 {
    font-size: 20px;
    font-weight: 700;
    color: #E2E8F0;
    margin: 0;
    letter-spacing: -0.4px;
  }

  .account-badge {
    font: 700 10px ui-monospace, monospace;
    background: rgba(55,118,171,0.15);
    color: #60A5FA;
    border: 1px solid rgba(55,118,171,0.3);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .account-badge--active {
    background: rgba(16,185,129,0.15);
    color: #10B981;
    border-color: rgba(16,185,129,0.3);
  }

  .sh-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 12px;
    color: #64748B;
    margin: 0 0 6px;
  }

  .sh-sep { color: #1E293B; }

  .sh-id { font-size: 11px; color: #475569; margin: 0; }
  .sh-id code { font-family: ui-monospace, monospace; color: #94A3B8; }

  /* Demo notice estricto */
  .demo-notice {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    background: rgba(245,158,11,0.07);
    border: 1px solid rgba(245,158,11,0.25);
