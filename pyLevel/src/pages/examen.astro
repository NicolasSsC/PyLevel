---
export const prerender = false;
import AppLayout from '../layouts/AppLayout.astro';
import ExamWindow from '../exam/ExamWindow.astro';
import { currentUser } from '../lib/session';

let user = null;
let unavailable = false;
try { user = await currentUser(Astro.cookies); } catch { unavailable = true; }
if (!unavailable && !user) return Astro.redirect('/login?next=/examen/');
if (unavailable) Astro.response.status = 503;
---
<AppLayout title="Examen de Python · PyLevel">
  {user ? <ExamWindow user={user} /> : (
    <main class="unavailable">
      <h1>No pudimos verificar tu sesión</h1>
      <p>El servicio no está disponible. Tu examen no se ha iniciado.</p>
      <a href="/examen/">Volver a intentar</a>
    </main>
  )}
</AppLayout>
<style>
  .unavailable { max-width: 640px; margin: 0 auto; padding: 100px 24px; }
  a { color: var(--color-primary); }
</style>
