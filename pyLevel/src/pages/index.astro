---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout
  title="PyLevel — Evaluación de Competencias en Python"
  description="Plataforma universitaria de evaluación mediante evidencia real de desempeño sobre proyectos Python multiarchivo. Exclusivo para estudiantes de Ingeniería de Software."
>

  <!-- ══════════════════════════════════════════════════
       HERO TÉCNICO
  ══════════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-bg" aria-hidden="true">
      <div class="grid-pattern"></div>
      <div class="glow glow-blue"></div>
      <div class="glow glow-yellow"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        Plataforma de evaluación · Ingeniería de Software
      </div>

      <h1 id="hero-heading">
        Evalúa tus competencias<br />
        <em>sobre código real.</em>
      </h1>

      <p class="hero-lead">
        No teoría desconectada. No autoevaluación subjetiva.<br />
        PyLevel te asigna proyectos Python con defectos reales: tú los depuras,
        corriges y verificas sin romper lo que ya funciona.
      </p>

      <div class="hero-stack">
        <span class="stack-badge">Python 3</span>
        <span class="stack-sep" aria-hidden="true">·</span>
        <span class="stack-badge">Multiarchivo</span>
        <span class="stack-sep" aria-hidden="true">·</span>
        <span class="stack-badge">Sandbox gVisor</span>
        <span class="stack-sep" aria-hidden="true">·</span>
        <span class="stack-badge">Motor determinista</span>
      </div>

      <div class="hero-ctas">
        <a href="/ejercicios/contextualizados/01_inventario_juan" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Iniciar Reto: Inventario de Juan
        </a>
        <a href="/ejercicios" class="btn-secondary">
          Workbench de Ejercicios
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <!-- Terminal decorativo -->
    <div class="hero-terminal" aria-hidden="true" role="presentation">
      <div class="terminal-bar">
        <span class="t-dot t-red"></span>
        <span class="t-dot t-yellow"></span>
        <span class="t-dot t-green"></span>
        <span class="t-title">inventario/ventas.py — PyLevel Workbench</span>
      </div>
      <div class="terminal-body">
        <div class="t-line"><span class="t-lnum">1</span><span class="t-comment"># BUG: acepta cantidades fraccionarias para productos por unidad</span></div>
        <div class="t-line"><span class="t-lnum">2</span></div>
        <div class="t-line"><span class="t-lnum">3</span><span class="t-kw">def</span> <span class="t-fn">registrar_venta</span>(producto, cantidad):</div>
        <div class="t-line"><span class="t-lnum">4</span>    <span class="t-kw">if</span> cantidad <span class="t-op">&lt;=</span> <span class="t-num">0</span>:</div>
        <div class="t-line"><span class="t-lnum">5</span>        <span class="t-kw">raise</span> ValueError(<span class="t-str">"Cantidad inválida"</span>)</div>
        <div class="t-line t-cursor"><span class="t-lnum">6</span>    <span class="t-comment"># ← Tu corrección aquí</span><span class="t-caret">▌</span></div>
        <div class="t-line"><span class="t-lnum">7</span>    <span class="t-kw">return</span> producto.precio <span class="t-op">*</span> cantidad</div>
        <div class="t-divider"></div>
        <div class="t-output">
          <span class="t-out-label">▶ Resultado de pruebas:</span>
          <span class="t-pass">✓ test_venta_entera_valida</span>
          <span class="t-fail">✗ test_rechaza_fraccionario_por_unidad — <em>FALLIDO</em></span>
          <span class="t-pass">✓ test_acepta_fraccionario_por_peso</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════
       ARQUITECTURA DE EVALUACIÓN VERIFICABLE
  ══════════════════════════════════════════════════ -->
  <section class="eval-arch" aria-labelledby="eval-heading">
    <div class="section-inner">
      <p class="section-eyebrow">ALGORITMO DE EVALUACIÓN</p>
      <h2 id="eval-heading">Arquitectura de Evaluación Verificable</h2>
      <p class="section-lead">
        El motor de PyLevel no mide opiniones. Ejecuta pruebas reales sobre tu código
        en un entorno aislado y emite un veredicto determinista de tres estados posibles.
      </p>

      <div class="eval-cards">
        <!-- Card 1 -->
        <article class="eval-card">
          <div class="eval-icon eval-icon--blue" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          </div>
          <div class="eval-num">01</div>
          <h3>Comprensión y Reglas de Dominio</h3>
          <p>
            No se evalúa sintaxis aislada. Los ejercicios son proyectos multiarchivo
            con modelos, lógica de negocio y restricciones reales: unidades enteras
            vs. productos por peso, solapamiento de reservas consecutivas, idempotencia
            en pagos duplicados.
          </p>
          <ul class="eval-tags">
            <li>Proyectos multiarchivo</li>
            <li>Reglas de negocio</li>
            <li>Contexto real</li>
          </ul>
        </article>

        <!-- Card 2 -->
        <article class="eval-card eval-card--featured">
          <div class="eval-icon eval-icon--yellow" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <div class="eval-num">02</div>
          <h3>Batería de Pruebas y No Regresión</h3>
          <p>
            El motor ejecuta casos normales, casos límite (cantidades fraccionarias,
            valores cero, negativos, entradas no numéricas) y verifica que la corrección
            no rompa comportamientos válidos previos. Sin regresión = tu solución es robusta.
          </p>
          <ul class="eval-tags">
            <li>Casos límite</li>
            <li>No regresión</li>
            <li>Batería completa</li>
          </ul>
        </article>

        <!-- Card 3 -->
        <article class="eval-card">
          <div class="eval-icon eval-icon--green" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <div class="eval-num">03</div>
          <h3>Contrato Determinista de Estados</h3>
          <p>
            Separación estricta entre <code class="state-chip state-ok">EVALUADA</code>,
            <code class="state-chip state-warn">ENTREGA_INVALIDA</code> y
            <code class="state-chip state-err">ERROR_TECNICO</code>.
            Un fallo del contenedor nunca penaliza académicamente al estudiante.
          </p>
          <ul class="eval-tags">
            <li>Veredicto trazable</li>
            <li>Sin penalización por infraestructura</li>
            <li>Auditable</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════
       ACCESO RÁPIDO A MODALIDADES
  ══════════════════════════════════════════════════ -->
  <section class="modalities" aria-labelledby="mod-heading">
    <div class="section-inner">
      <p class="section-eyebrow">MODALIDADES DE PRÁCTICA</p>
      <h2 id="mod-heading">Elige cómo quieres practicar</h2>

      <div class="mod-grid">
        <a href="/ejercicios/contextualizados/" class="mod-card mod-card--contextual">
          <div class="mod-card-top">
            <span class="mod-icon" aria-hidden="true">{'{ }'}</span>
            <span class="mod-label">02 / PROYECTOS</span>
          </div>
          <h3>Ejercicios Contextualizados</h3>
          <p>Proyectos Python reales con múltiples archivos. Comprende el dominio, localiza el defecto y corrige sin romper el resto.</p>
          <div class="mod-preview" aria-hidden="true">
            <span>▾ &nbsp;inventario/</span>
            <span class="mp-indent">modelos.py <i>Modelo del producto</i></span>
            <span class="mp-indent mp-active">ventas.py <i>Tu punto de partida</i></span>
            <span class="mp-indent">tests/test_publico.py</span>
          </div>
          <div class="mod-footer">
            <span>Inventario · Reservas · Facturación</span>
            <strong>Explorar proyectos ↗</strong>
          </div>
        </a>

        <a href="/ejercicios/clasicos/" class="mod-card mod-card--classic">
          <div class="mod-card-top">
            <span class="mod-icon mod-icon--blue" aria-hidden="true">&lt;/&gt;</span>
            <span class="mod-label">01 / FUNDAMENTOS</span>
          </div>
          <h3>Ejercicios Clásicos</h3>
          <p>Un enunciado, una función por completar. Concentra tu atención en la lógica algorítmica.</p>
          <div class="mod-preview mod-preview--code" aria-hidden="true">
            <span class="t-comment"># Tu siguiente solución empieza aquí</span>
            <span><span class="t-kw">def</span> <span class="t-fn">sumar_pares</span>(numeros):</span>
            <span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="t-kw">pass</span></span>
          </div>
          <div class="mod-footer">
            <span>Bucles · Funciones · Lambdas</span>
            <strong>Ver ejercicios ↗</strong>
          </div>
        </a>
      </div>
    </div>
  </section>

</AppLayout>

<style>
  /* ── Variables locales ── */
  :root {
    --bg: #0B1120;
    --surface: #111827;
    --surface2: #1E293B;
    --blue: #3776AB;
    --yellow: #FFD43B;
    --green: #10B981;
    --red: #F43F5E;
    --text: #E2E8F0;
    --muted: #94A3B8;
    --border: #1E293B;
  }

  /* ── Sección inner ── */
  .section-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .section-eyebrow {
    font: 600 11px ui-monospace, monospace;
    letter-spacing: 2px;
    color: var(--yellow);
    margin: 0 0 12px;
  }

  .section-inner > h2 {
    font-size: clamp(24px, 3vw, 36px);
    letter-spacing: -1px;
    color: var(--text);
    margin: 0 0 14px;
  }

  .section-lead {
    font-size: 15px;
    line-height: 1.8;
    color: var(--muted);
    margin: 0 0 48px;
    max-width: 640px;
  }

  /* ═══════════════════════════════════════
     HERO
  ═══════════════════════════════════════ */
  .hero {
    position: relative;
    min-height: calc(100vh - 56px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 48px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 32px 60px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .grid-pattern {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(55, 118, 171, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(55, 118, 171, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
  }

  .glow-blue  { width: 500px; height: 500px; background: #3776AB; top: -100px; left: -100px; }
  .glow-yellow{ width: 300px; height: 300px; background: #FFD43B; bottom: 0; right: 10%; }

  .hero-content { position: relative; z-index: 1; }

  /* Badge de bienvenida */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 600 11px ui-monospace, monospace;
    letter-spacing: 1.5px;
    color: var(--yellow);
    background: rgba(255, 212, 59, 0.08);
    border: 1px solid rgba(255, 212, 59, 0.2);
    padding: 6px 14px;
    border-radius: 20px;
    margin-bottom: 28px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--yellow);
    flex-shrink: 0;
  }

  /* Heading */
  h1 {
    font-size: clamp(36px, 5vw, 62px);
    line-height: 1.08;
    letter-spacing: -2px;
    color: var(--text);
    margin: 0 0 24px;
    font-weight: 750;
  }

  h1 em {
    font-style: normal;
    color: var(--blue);
  }

  .hero-lead {
    font-size: 16px;
    line-height: 1.8;
    color: var(--muted);
    margin: 0 0 28px;
    max-width: 520px;
  }

  /* Stack badges */
  .hero-stack {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 36px;
  }

  .stack-badge {
    font: 11px ui-monospace, monospace;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }

  .stack-sep { color: #334155; font-size: 14px; }

  /* CTAs */
  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 13px 24px;
    background: var(--blue);
    color: #fff;
    font-size: 14px;
    font-weight: 650;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s, transform 0.15s;
    border: 1px solid transparent;
  }

  .btn-primary:hover { background: #2d6496; transform: translateY(-1px); }
  .btn-primary:focus-visible { outline: 2px solid var(--yellow); outline-offset: 3px; }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 13px 24px;
    background: transparent;
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid var(--border);
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }

  .btn-secondary:hover { border-color: var(--blue); color: var(--blue); background: rgba(55,118,171,0.05); }
  .btn-secondary:focus-visible { outline: 2px solid var(--yellow); outline-offset: 3px; }

  /* ── Terminal decorativa ── */
  .hero-terminal {
    position: relative;
    z-index: 1;
    background: #060D1A;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    font-family: ui-monospace, Consolas, monospace;
    font-size: 13px;
    box-shadow: 0 24px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(55,118,171,0.15);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    background: #0E1929;
    border-bottom: 1px solid var(--border);
    padding: 10px 16px;
  }

  .t-dot { width: 10px; height: 10px; border-radius: 50%; }
  .t-red    { background: #F43F5E; }
  .t-yellow { background: #FFD43B; }
  .t-green  { background: #10B981; }

  .t-title {
    font-size: 11px;
    color: #475569;
    margin-left: 6px;
    letter-spacing: 0.3px;
  }

  .terminal-body { padding: 18px 20px; line-height: 1.9; }

  .t-line { display: flex; gap: 16px; }
  .t-lnum { color: #334155; min-width: 16px; text-align: right; user-select: none; }
  .t-comment { color: #4B6B8A; }
  .t-kw { color: #3776AB; }
  .t-fn { color: #10B981; }
  .t-op { color: #94A3B8; }
  .t-num { color: #FFD43B; }
  .t-str { color: #F59E0B; }

  .t-cursor { color: var(--muted); }
  .t-caret { color: var(--yellow); animation: blink 1.2s step-end infinite; }

  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  .t-divider { border-top: 1px solid var(--border); margin: 14px 0 12px; }

  .t-output { display: flex; flex-direction: column; gap: 4px; }
  .t-out-label { font-size: 11px; color: #475569; margin-bottom: 4px; letter-spacing: 1px; }
  .t-pass { color: #10B981; }
  .t-fail { color: #F43F5E; }
  .t-fail em { font-style: normal; font-size: 11px; opacity: 0.8; }

  /* ═══════════════════════════════════════
     ARQUITECTURA EVALUACIÓN
  ═══════════════════════════════════════ */
  .eval-arch {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 80px 0;
  }

  .eval-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .eval-card {
    background: #0B1120;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 28px;
    position: relative;
    transition: border-color 0.2s;
  }

  .eval-card:hover { border-color: var(--blue); }

  .eval-card--featured {
    border-color: rgba(55,118,171,0.5);
    background: linear-gradient(145deg, #0B1120, #0f1e35);
  }

  .eval-card--featured::before {
    content: 'NÚCLEO';
    position: absolute;
    top: -1px;
    right: 20px;
    font: 700 10px ui-monospace, monospace;
    letter-spacing: 1.5px;
    color: #0B1120;
    background: var(--yellow);
    padding: 3px 8px;
    border-radius: 0 0 6px 6px;
  }

  .eval-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    margin-bottom: 16px;
  }

  .eval-icon--blue   { background: rgba(55,118,171,0.15); color: var(--blue); }
  .eval-icon--yellow { background: rgba(255,212,59,0.12); color: var(--yellow); }
  .eval-icon--green  { background: rgba(16,185,129,0.12); color: var(--green); }

  .eval-num {
    font: 700 11px ui-monospace, monospace;
    color: #334155;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .eval-card h3 { font-size: 16px; color: var(--text); margin: 0 0 12px; letter-spacing: -0.3px; }
  .eval-card p  { font-size: 13px; line-height: 1.75; color: var(--muted); margin: 0 0 16px; }

  .eval-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .eval-tags li {
    font: 11px ui-monospace, monospace;
    color: #64748B;
    border: 1px solid #1E293B;
    padding: 3px 8px;
    border-radius: 4px;
  }

  /* State chips */
  .state-chip {
    font: 700 11px ui-monospace, monospace;
    padding: 2px 7px;
    border-radius: 4px;
    letter-spacing: 0.5px;
  }

  .state-ok   { background: rgba(16,185,129,0.15); color: #10B981; border: 1px solid rgba(16,185,129,0.3); }
  .state-warn { background: rgba(245,158,11,0.15); color: #F59E0B; border: 1px solid rgba(245,158,11,0.3); }
  .state-err  { background: rgba(244,63,94,0.15);  color: #F43F5E; border: 1px solid rgba(244,63,94,0.3); }

  /* ═══════════════════════════════════════
     MODALIDADES
  ═══════════════════════════════════════ */
  .modalities { padding: 80px 0 100px; }

  .mod-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .mod-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 28px;
    text-decoration: none;
    transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s;
  }

  .mod-card:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(0,0,0,0.4); }
  .mod-card:focus-visible { outline: 2px solid var(--yellow); outline-offset: 4px; }

  .mod-card--contextual {
    background: #121F35;
    border-color: rgba(55,118,171,0.3);
    color: var(--text);
  }

  .mod-card--classic {
    background: var(--surface);
    color: var(--text);
  }

  .mod-card--contextual:hover { border-color: var(--blue); }
  .mod-card--classic:hover { border-color: var(--border); box-shadow: 0 16px 40px rgba(0,0,0,0.3); }

  .mod-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }

  .mod-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(255,212,59,0.12);
    color: var(--yellow);
    font: 700 18px ui-monospace, monospace;
  }

  .mod-icon--blue { background: rgba(55,118,171,0.15); color: var(--blue); }

  .mod-label {
    font: 700 10px ui-monospace, monospace;
    letter-spacing: 1.5px;
    color: #475569;
  }

  .mod-card h3  { font-size: 20px; letter-spacing: -0.4px; margin: 0 0 10px; }
  .mod-card > p { font-size: 13px; line-height: 1.75; color: var(--muted); margin: 0 0 20px; }

  .mod-preview {
    flex: 1;
    background: rgba(0,0,0,0.3);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    padding: 14px 16px;
