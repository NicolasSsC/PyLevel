---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import manualDataRaw from '../data/user-manual.json';
import type { UserManualData, CellLinkData, PendingCellData } from '../data/user-manual-types';

const manual = manualDataRaw as unknown as UserManualData;

const isLinkCell = (cell: unknown): cell is CellLinkData => {
  return typeof cell === 'object' && cell !== null && 'links' in cell;
};

const isPendingCell = (cell: unknown): cell is PendingCellData => {
  return typeof cell === 'object' && cell !== null && 'isPending' in cell && (cell as PendingCellData).isPending;
};
---

<Layout
  title={`${manual.metadata.title} · PyLevel`}
  description={manual.metadata.subtitle}
>
  <a href="#main-manual-content" class="skip-link">Saltar al contenido principal</a>

  <div class="manual-page-wrapper">
    <!-- Header Hero -->
    <header class="manual-hero">
      <div class="manual-container">
        <nav class="breadcrumb-nav" aria-label="Ruta de navegación">
          <a href="/" class="crumb-link">Inicio</a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <span class="crumb-current" aria-current="page">Manual de usuario</span>
        </nav>

        <div class="hero-badge-wrap">
          <span class="hero-badge">DOCUMENTACIÓN OFICIAL</span>
          <span class="hero-version">Versión {manual.metadata.version}</span>
        </div>

        <h1 class="manual-main-title">{manual.metadata.title}</h1>
        <p class="manual-main-lead">{manual.metadata.subtitle}</p>

        <div class="manual-meta-bar">
          <span class="meta-item">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            {manual.metadata.date}
          </span>
          <span class="meta-sep" aria-hidden="true">•</span>
          <span class="meta-item">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            {manual.metadata.author}
          </span>
        </div>
      </div>
    </header>

    <!-- Main Layout: Sidebar TOC + Content Area -->
    <div class="manual-container manual-body-layout">
      <!-- Mobile Collapsible TOC -->
      <aside class="mobile-toc-aside" aria-label="Tabla de contenidos móvil">
        <details class="mobile-toc-details">
          <summary class="mobile-toc-summary">
            <span class="summary-text">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
              Tabla de contenido del manual
            </span>
            <span class="summary-chevron" aria-hidden="true">▾</span>
          </summary>
          <nav class="mobile-toc-nav" aria-label="Índice de secciones móvil">
            <ol class="toc-list">
              {manual.sections.map(section => (
                <li class="toc-item">
                  <a href={`#${section.id}`} class="mobile-toc-link">
                    <span class="toc-num">{section.number}.</span>
                    <span class="toc-title">{section.title}</span>
                    {section.role && <span class:list={['role-pill', `role-${section.role.toLowerCase()}`]}>{section.role}</span>}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      </aside>

      <!-- Desktop Sticky Sidebar TOC -->
      <aside class="desktop-toc-aside" aria-label="Tabla de contenidos fija">
        <div class="toc-sticky-box">
          <h2 class="toc-heading">En este manual</h2>
          <nav aria-label="Índice de secciones">
            <ol class="toc-list" id="desktop-toc-list">
              {manual.sections.map(section => (
                <li class="toc-item">
                  <a href={`#${section.id}`} class="toc-link" data-section-target={section.id}>
                    <span class="toc-num">{section.number}.</span>
                    <span class="toc-title">{section.title}</span>
                    {section.role && <span class:list={['role-pill', `role-${section.role.toLowerCase()}`]}>{section.role}</span>}
                  </a>
                </li>
              ))}
            </ol>
          </nav>

          <div class="toc-footer-quick">
            <a href="#seccion-8-1" class="toc-faq-pill">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
              Preguntas frecuentes (8.1)
            </a>
          </div>
        </div>
      </aside>

      <!-- Main Content Article -->
      <main id="main-manual-content" class="manual-article" tabindex="-1">
        {manual.sections.map(section => (
          <section id={section.id} class:list={['manual-section-block', { 'section-with-role': !!section.role }]} aria-labelledby={`title-${section.id}`}>
            <!-- Section Header -->
            <div class="section-title-wrap">
              {section.role && (
                <div class="role-guide-banner" role="note" aria-label={`Guía orientada al rol ${section.role}`}>
                  <span class:list={['role-tag-badge', `role-bg-${section.role.toLowerCase()}`]}>
                    GUÍA POR ROL: {section.role.toUpperCase()}
                  </span>
                  <span class="role-desc-text">
                    Sección especialmente dirigida a usuarios con perfil de <strong>{section.role}</strong>.
                  </span>
                </div>
              )}

              <div class="heading-anchor-row">
                <h2 id={`title-${section.id}`} class="section-h2">
                  <span class="num-prefix">{section.number}.</span> {section.title}
                </h2>
                <a href={`#${section.id}`} class="heading-permalink" aria-label={`Enlace directo a la sección ${section.number}: ${section.title}`}>
                  <span aria-hidden="true">#</span>
                </a>
              </div>
            </div>

            {section.lead && <p class="lead-text">{section.lead}</p>}

            {section.paragraphs?.map(paragraph => (
              <p class="body-text">{paragraph}</p>
            ))}

            <!-- Subsections -->
            {section.subsections?.map(sub => (
              <div id={sub.id} class="manual-subsection-block">
                {sub.aliasId && <span id={sub.aliasId} class="anchor-alias" aria-hidden="true"></span>}

                <div class="subheading-anchor-row">
                  <h3 id={`title-${sub.id}`} class="section-h3">
                    <span class="num-prefix">{sub.number}</span> {sub.title}
                  </h3>
                  <a href={`#${sub.id}`} class="heading-permalink" aria-label={`Enlace directo a la subsección ${sub.number}: ${sub.title}`}>
                    <span aria-hidden="true">#</span>
                  </a>
                </div>

                {sub.lead && <p class="lead-text">{sub.lead}</p>}

                {sub.paragraphs?.map(p => (
                  <p class="body-text">{p}</p>
                ))}

                <!-- Steps list if present -->
                {sub.steps && (
                  <ol class="manual-steps-list">
                    {sub.steps.map(step => (
                      <li class="step-item">
                        <span class="step-content">{step}</span>
                      </li>
                    ))}
                  </ol>
                )}

                <!-- Standard list if present -->
                {sub.list && (
                  <ul class="manual-bullets-list">
                    {sub.list.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}

                <!-- Table if present -->
                {sub.table && (
                  <div class="table-scroll-container" tabindex="0" role="region" aria-label={sub.table.caption}>
                    <table class="manual-data-table">
                      <caption class="sr-only">{sub.table.caption}</caption>
                      <thead>
                        <tr>
                          {sub.table.headers.map(header => (
                            <th scope="col">{header}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {sub.table.rows.map(row => (
                          <tr>
                            {row.map((cell, idx) => (
                              <td class:list={[{ 'font-medium text-primary': idx === 0 }]}>
                                {typeof cell === 'string' && cell}
                                {isLinkCell(cell) && (
                                  <span>
                                    {cell.links.map((link, lIdx) => (
                                      <span>
                                        {lIdx > 0 && ' y '}
                                        <a href={link.target} class="manual-in-link">Sección {link.label}</a>
                                      </span>
                                    ))}
                                  </span>
                                )}
                                {isPendingCell(cell) && (
                                  <mark class="pending-marker" title="Campo pendiente de completar">
                                    {cell.text}
                                  </mark>
                                )}
                              </td>
                            ))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}

                <!-- Math Formula in 4.1 -->
                {sub.formula && (
                  <div class="formula-box" role="figure" aria-label={sub.formula.label}>
                    <div class="formula-render" aria-hidden="true">
                      <span class="formula-var">Puntaje</span>
                      <span class="formula-equal">=</span>
                      <div class="formula-fraction">
                        <span class="formula-numerator">{sub.formula.numerator}</span>
                        <span class="formula-fraction-bar"></span>
                        <span class="formula-denominator">{sub.formula.denominator}</span>
                      </div>
                      <span class="formula-times">×</span>
                      <span class="formula-multiplier">{sub.formula.multiplier}</span>
                    </div>
                    <span class="sr-only">{sub.formula.label}</span>
                  </div>
                )}

                <!-- Paragraphs after table/formula -->
                {sub.paragraphsAfter?.map(p => (
                  <p class="body-text">{p}</p>
                ))}

                <!-- Note / Callout -->
                {sub.note && (
                  <div class="doc-note-box">
                    <div class="note-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                    </div>
                    <div class="note-body">
                      {sub.note}
                      {sub.noteLinks && (
                        <span class="note-links-row">
                          {' '}(Acceso rápido:{' '}
                          {sub.noteLinks.map((nl, nIdx) => (
                            <span>
                              {nIdx > 0 && ', '}
                              <a href={nl.target} class="manual-in-link">{nl.label}</a>
                            </span>
                          ))}
                          )
                        </span>
                      )}
                    </div>
                  </div>
                )}

                <!-- FAQs Accordion (Section 8.1) -->
                {sub.isAccordion && sub.faqs && (
                  <div class="faqs-accordion-wrapper" role="region" aria-label="Preguntas frecuentes interactivas">
                    {sub.faqs.map(faq => (
                      <div class="faq-accordion-item" id={`item-${faq.id}`}>
                        <button
                          type="button"
                          class="faq-accordion-trigger"
                          aria-expanded="false"
                          aria-controls={`panel-${faq.id}`}
                          id={`btn-${faq.id}`}
                        >
                          <span class="faq-question-text">{faq.question}</span>
                          <span class="faq-indicator" aria-hidden="true">+</span>
                        </button>
                        <div
                          id={`panel-${faq.id}`}
                          class="faq-accordion-panel"
                          role="region"
                          aria-labelledby={`btn-${faq.id}`}
                          hidden
                        >
                          <div class="faq-panel-inner">
                            <p class="faq-answer-text">{faq.answer}</p>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {sub.footerNote && (
                  <p class="manual-footer-note">
                    <small>{sub.footerNote}</small>
                  </p>
                )}
              </div>
            ))}
          </section>
        ))}

        <!-- Back to Top Button -->
        <div class="back-to-top-wrapper">
          <button type="button" id="btn-back-to-top" class="btn-back-to-top" aria-label="Volver arriba al inicio del manual">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="18 15 12 9 6 15"></polyline>
            </svg>
            <span>Volver arriba</span>
          </button>
        </div>
      </main>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  // Scroll Spy: Highlight active desktop TOC link
  const sections = document.querySelectorAll<HTMLElement>('.manual-section-block');
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('#desktop-toc-list .toc-link');

  const observerOptions: IntersectionObserverInit = {
    root: null,
    rootMargin: '-80px 0px -65% 0px',
    threshold: 0,
  };

  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        for (const link of tocLinks) {
          const isActive = link.dataset.sectionTarget === id;
          link.classList.toggle('active', isActive);
          if (isActive) {
            link.setAttribute('aria-current', 'true');
          } else {
            link.removeAttribute('aria-current');
          }
        }
      }
    }
  }, observerOptions);

  sections.forEach(sec => observer.observe(sec));

  // Accordion Logic (Accessible WCAG 2.1 AA)
  const triggers = document.querySelectorAll<HTMLButtonElement>('.faq-accordion-trigger');

  triggers.forEach(trigger => {
    trigger.addEventListener('click', () => {
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      const panelId = trigger.getAttribute('aria-controls');
      if (!panelId) return;
      const panel = document.getElementById(panelId);
      if (!panel) return;

      trigger.setAttribute('aria-expanded', String(!isExpanded));
      panel.hidden = isExpanded;
      trigger.classList.toggle('is-open', !isExpanded);
      const indicator = trigger.querySelector('.faq-indicator');
      if (indicator) {
        indicator.textContent = isExpanded ? '+' : '−';
      }
    });
  });

  // Check URL Hash on load: if #faq or #seccion-8-1, expand first FAQ or target
  function handleHash() {
    const hash = window.location.hash;
    if (hash === '#faq' || hash === '#seccion-8-1') {
      const target = document.getElementById('seccion-8-1');
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
        // Optionally open first FAQ
        const firstTrigger = document.querySelector<HTMLButtonElement>('.faq-accordion-trigger');
        if (firstTrigger && firstTrigger.getAttribute('aria-expanded') !== 'true') {
          firstTrigger.click();
        }
      }
    }
  }

  window.addEventListener('hashchange', handleHash);
  if (window.location.hash) {
    handleHash();
  }

  // Back to top button
  const backToTopBtn = document.getElementById('btn-back-to-top');
  if (backToTopBtn) {
    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      const main = document.getElementById('main-manual-content');
      if (main) main.focus();
    });
  }
</script>

<style>
  /* Accessibility: Skip link */
  .skip-link {
    position: absolute;
    top: -999px;
    left: 1rem;
    background: var(--color-primary, #2563eb);
    color: #ffffff;
    padding: 0.75rem 1.25rem;
    font-weight: 700;
    border-radius: 6px;
    z-index: 9999;
    text-decoration: none;
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: 1rem;
    outline: 3px solid #ffd343;
    outline-offset: 2px;
  }

  .manual-page-wrapper {
    background: var(--color-bg, #0B1120);
    color: var(--color-text-primary, #F8FAFC);
    min-height: 100vh;
    padding-bottom: 5rem;
  }

  .manual-container {
    width: min(1200px, calc(100% - 2.5rem));
    margin-inline: auto;
  }

  /* Hero Header */
  .manual-hero {
    background: linear-gradient(180deg, var(--color-surface, #0f172a) 0%, var(--color-bg, #0B1120) 100%);
    border-bottom: 1px solid var(--color-border, #1e293b);
    padding-block: 2.5rem 2rem;
    margin-bottom: 2rem;
  }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary, #94a3b8);
    margin-bottom: 1rem;
  }

  .crumb-link {
    color: var(--color-primary, #3b82f6);
    text-decoration: none;
  }
  .crumb-link:hover {
    text-decoration: underline;
  }

  .crumb-current {
    color: var(--color-text-primary, #F8FAFC);
    font-weight: 600;
  }

  .hero-badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-badge {
    background: var(--color-primary-light, rgba(59, 130, 246, 0.15));
    color: var(--color-primary, #3b82f6);
    border: 1px solid var(--color-primary, #3b82f6);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
  }

  .hero-version {
    font-size: 0.78rem;
    color: var(--color-text-muted, #64748b);
  }

  .manual-main-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 0.5rem;
    color: var(--color-text-primary, #F8FAFC);
  }

  .manual-main-lead {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #94a3b8);
    max-width: 750px;
    margin: 0 0 1.25rem;
  }

  .manual-meta-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: var(--color-text-muted, #64748b);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Layout Structure */
  .manual-body-layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  /* Desktop Sticky Sidebar TOC */
  .desktop-toc-aside {
    position: sticky;
    top: 90px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
  }

  .toc-sticky-box {
    background: var(--color-surface, #0f172a);
    border: 1px solid var(--color-border, #1e293b);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .toc-heading {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted, #64748b);
    font-weight: 700;
    margin: 0;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .toc-item {
    margin: 0;
  }

  .toc-link,
  .mobile-toc-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    border-radius: 6px;
    color: var(--color-text-secondary, #94a3b8);
    text-decoration: none;
    font-size: 0.85rem;
    line-height: 1.4;
    transition: all 0.15s ease;
  }

  .toc-link:hover,
  .mobile-toc-link:hover {
    color: var(--color-text-primary, #F8FAFC);
    background: var(--color-surface-hover, #1e293b);
  }

  .toc-link.active {
    color: #ffffff;
    background: var(--color-primary, #2563eb);
    font-weight: 600;
  }

  .toc-num {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    opacity: 0.8;
  }

  .toc-title {
    flex: 1;
  }

  .toc-faq-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary, #3b82f6);
    background: var(--color-primary-light, rgba(59, 130, 246, 0.12));
    border: 1px solid var(--color-border, #1e293b);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    width: 100%;
    box-sizing: border-box;
    transition: all 0.15s ease;
  }

  .toc-faq-pill:hover {
    background: var(--color-primary, #2563eb);
    color: #ffffff;
  }

  /* Role Pills */
  .role-pill {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .role-estudiante {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .role-docente {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .role-administrador {
    background: rgba(234, 179, 8, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(234, 179, 8, 0.3);
  }

  /* Mobile Collapsible TOC */
  .mobile-toc-aside {
    display: none;
    margin-bottom: 1.5rem;
  }

  .mobile-toc-details {
    background: var(--color-surface, #0f172a);
    border: 1px solid var(--color-border, #1e293b);
    border-radius: 10px;
    overflow: hidden;
  }

  .mobile-toc-summary {
    padding: 0.85rem 1.25rem;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    user-select: none;
  }

  .mobile-toc-summary .summary-text {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-toc-nav {
    padding: 0.75rem;
    border-top: 1px solid var(--color-border, #1e293b);
  }

  /* Main Article Sections */
  .manual-article {
    min-width: 0;
    max-width: 82ch; /* Confortable reading width (WCAG AA: 70-80 chars) */
  }

  .manual-section-block {
