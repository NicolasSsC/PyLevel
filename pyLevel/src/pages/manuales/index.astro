<script>
  // Copiar código de los bloques
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const pre = btn.closest('.code-block-wrap')?.querySelector('.code-pre code');
      if (pre) {
        await navigator.clipboard.writeText(pre.textContent || '');
        const originalText = btn.textContent;
        btn.textContent = '¡Copiado!';
        setTimeout(() => {
          btn.textContent = originalText;
        }, 2000);
      }
    });
  });

  // Buscador interactivo en vivo de los manuales
  const searchInput = document.getElementById('manual-search-input') as HTMLInputElement;
  const docContent = document.getElementById('manuals-doc-content');

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();
    const topics = document.querySelectorAll('.doc-topic');

    topics.forEach(t => {
      const topic = t as HTMLElement;
      const text = topic.textContent?.toLowerCase() || '';
      if (!query || text.includes(query)) {
        topic.style.display = '';
      } else {
        topic.style.display = 'none';
      }
    });

    // Ocultar capítulos si todos sus tópicos están ocultos
    document.querySelectorAll('.doc-chapter').forEach(c => {
      const chapter = c as HTMLElement;
      const visibleTopics = chapter.querySelectorAll('.doc-topic:not([style*="display: none"])');
      if (!query || visibleTopics.length > 0) {
        chapter.style.display = '';
      } else {
        chapter.style.display = 'none';
      }
    });
  });

  // Resaltado de enlaces en scroll
  const links = document.querySelectorAll('.sidebar-link');
  window.addEventListener('scroll', () => {
    let current = '';
    document.querySelectorAll('.doc-topic').forEach(section => {
      const sec = section as HTMLElement;
      const sectionTop = sec.offsetTop - 120;
      if (window.scrollY >= sectionTop) {
        current = sec.getAttribute('id') || '';
      }
    });

    links.forEach(link => {
      link.classList.remove('active');
      if (link.getAttribute('href') === `#${current}`) {
        link.classList.add('active');
      }
    });
  });
</script>
