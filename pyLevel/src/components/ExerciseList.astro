    font-size: 18px;
    color: #f8fafc;
    margin: 0 0 8px;
  }

  .empty-results-box p {
    font-size: 14px;
    color: #94a3b8;
    max-width: 480px;
    margin: 0 auto 18px;
  }

  .reset-link-btn {
