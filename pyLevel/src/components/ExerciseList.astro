  /* Estado vacío */
  .empty-results-box {
    text-align: center;
    padding: 64px 24px;
    background: #0f172a;
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    margin-top: 24px;
  }

  .empty-icon {
    font-size: 36px;
    margin-bottom: 12px;
  }

