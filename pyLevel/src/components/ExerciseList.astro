---
import { catalogs, modePaths, type Exercise } from '../core/catalog';

interface Props {
  mode: 'classic' | 'contextual';
}

const { mode } = Astro.props;
const classic = mode === 'classic';
const initialExercises = catalogs[mode];

// Dificultades ordenadas
const difficulties = ['Fácil', 'Medio', 'Difícil'];

// Extraer temas únicos del catálogo
const topics = [...new Set(initialExercises.flatMap(e => e.topics))].sort();
---

<main class="catalog-page" data-mode={mode}>
  <!-- Sub-barra superior con navegación contextual y cambio de modalidad -->
  <div class="catalog-subbar">
    <a class="nav-back" href="/ejercicios/">
      <span aria-hidden="true">←</span> Volver a modalidades
    </a>
    <div class="mode-tabs" role="tablist" aria-label="Modalidades de práctica">
      <a
        href="/ejercicios/clasicos/"
        class:list={['mode-tab', { active: classic }]}
        role="tab"
        aria-selected={classic ? 'true' : 'false'}
      >
        Desafíos Prácticos
      </a>
      <a
        href="/ejercicios/contextualizados/"
        class:list={['mode-tab', { active: !classic }]}
        role="tab"
        aria-selected={!classic ? 'true' : 'false'}
      >
        Proyectos Multi-archivo
      </a>
    </div>
    <span class="lang-tag">Python 3 <b>●</b></span>
  </div>

  <!-- Encabezado de la sección -->
  <header class="catalog-header">
    <p class="catalog-eyebrow">
      {classic ? 'PRÁCTICA Y AUTO-CALIFICACIÓN' : 'ARQUITECTURA Y MODULARIZACIÓN'}
    </p>
    <h1 class="catalog-title">
      {classic ? 'Desafíos Prácticos en Python' : 'Proyectos Prácticos Multi-archivo'}
    </h1>
    <p class="catalog-subtitle">
      {classic
        ? 'Escribe código real, resuelve los retos en el editor y califica tu solución con casos de prueba automatizados.'
        : 'Desarrolla aplicaciones modulares, interactúa entre múltiples archivos Python y supera los criterios de aceptación.'}
    </p>
  </header>

  <!-- Barra de Filtros, Búsqueda y Acción IA -->
  <section class="catalog-toolbar" aria-label="Filtros y acciones">
    <div class="toolbar-left">
      <!-- Selector de dificultad (Pills) -->
      <div class="difficulty-pills" role="radiogroup" aria-label="Filtrar por dificultad">
        <button type="button" class="pill-btn active" data-difficulty="all">Todos</button>
        <button type="button" class="pill-btn" data-difficulty="Fácil">Fácil</button>
        <button type="button" class="pill-btn" data-difficulty="Medio">Media</button>
        <button type="button" class="pill-btn" data-difficulty="Difícil">Difícil</button>
      </div>

      <!-- Filtros adicionales para proyectos multi-archivo -->
      {!classic && (
        <div class="extra-filters">
          <select id="topic-select" class="theme-dropdown" aria-label="Filtrar por tema">
            <option value="all">Todos los temas</option>
            {topics.map(t => (
              <option value={t}>#{t}</option>
            ))}
          </select>

          <div class="search-box">
            <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input
              type="text"
              id="search-input"
              class="search-input"
              placeholder="Buscar proyecto por nombre o tema..."
              aria-label="Buscar proyectos"
            />
          </div>

          <button type="button" id="clear-filters-btn" class="clear-btn">
            Limpiar filtros
          </button>
        </div>
      )}
    </div>

    <!-- Botón de acción Generar con IA -->
    <div class="toolbar-right">
      <button type="button" id="open-ai-modal-btn" class="ai-create-btn">
        <svg class="spark-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
        <span>{classic ? 'Crear Reto con IA' : 'Crear Proyecto con IA'}</span>
      </button>
    </div>
  </section>

  <!-- Grid de Tarjetas (Cards) -->
  <section class="cards-grid" id="cards-container" aria-label="Listado de ejercicios">
    {initialExercises.map((exercise, index) => {
      const isEasy = exercise.difficulty === 'Fácil';
      const isMedium = exercise.difficulty === 'Medio';
      const isHard = exercise.difficulty === 'Difícil';
      const diffClass = isEasy ? 'diff-easy' : isMedium ? 'diff-medium' : 'diff-hard';
      const diffLabel = isEasy ? 'FACIL' : isMedium ? 'MEDIA' : 'DIFICIL';

      const categoryText = classic
        ? (exercise.category || (exercise.topics && exercise.topics[0] ? exercise.topics[0].toUpperCase() : 'ALGORITMOS'))
        : `PROYECTO #${exercise.projectNumber || index + 1}`;

      const linkHref = `/ejercicios/${modePaths[mode]}/${exercise.id}/`;

      return (
        <article
          class="card-item"
          data-id={exercise.id}
          data-difficulty={exercise.difficulty}
          data-topics={JSON.stringify(exercise.topics || [])}
          data-title={exercise.title.toLowerCase()}
        >
          <!-- Cabecera de la tarjeta -->
          <div class="card-header">
            <div class="card-tags-group">
              <span class="card-eyebrow-tag">{categoryText}</span>
              {exercise.isAI && <span class="ai-badge">IA</span>}
            </div>

            <div class="card-meta-right">
              <span class:list={['card-diff-chip', diffClass]}>{diffLabel}</span>
            </div>
          </div>

          <!-- Título y descripción -->
          <h2 class="card-title">
            <a href={linkHref}>{exercise.title}</a>
          </h2>
          <p class="card-desc">{exercise.description}</p>

          <!-- Hashtags para proyectos -->
          {!classic && exercise.topics && (
            <div class="card-hashtags" aria-label="Temas del proyecto">
              {exercise.topics.map(topic => (
                <span class="hashtag-chip">#{topic}</span>
              ))}
            </div>
          )}

          <!-- Pie de tarjeta con métricas y estado -->
          <div class="card-footer">
            <div class="footer-metric">
              {classic ? (
                <span>{exercise.testCasesCount || 5} casos de prueba</span>
              ) : (
                <span>
                  {exercise.filesCount || Object.keys(exercise.files || {}).length || 3} archivos • {exercise.criteriaCount || 6} criterios
                </span>
              )}
            </div>

            <div class="footer-status" data-status-id={exercise.id}>
              <span class="status-indicator pending">Pendiente</span>
            </div>
          </div>
        </article>
      );
    })}
  </section>

  <!-- Mensaje de estado vacío cuando ningún filtro coincide -->
  <div id="no-results-state" class="empty-results-box" hidden>
    <div class="empty-icon" aria-hidden="true">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg>
    </div>
    <h3>No se encontraron resultados</h3>
    <p>No hay desafíos que coincidan con los filtros seleccionados. Prueba con otra combinación o genera uno nuevo con PyBot.</p>
    <button type="button" id="reset-filter-action" class="reset-link-btn">Restablecer filtros</button>
  </div>

  <!-- MODAL: Crear con IA (PyBot) -->
  <dialog id="ai-generator-modal" class="ai-modal" aria-labelledby="modal-heading">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-spark" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>
          </div>
          <div>
            <h2 id="modal-heading">{classic ? 'Generar Reto con PyBot IA' : 'Generar Proyecto con PyBot IA'}</h2>
            <p class="modal-subtext">PyBot diseñará automáticamente el enunciado, código inicial y casos de prueba.</p>
          </div>
        </div>
        <button type="button" id="close-modal-btn" class="modal-close" aria-label="Cerrar modal">✕</button>
      </div>

      <form id="ai-generator-form" class="modal-form">
        <div class="form-group">
          <label for="ai-theme-input">Tema o concepto a trabajar</label>
          <input
            type="text"
            id="ai-theme-input"
            class="form-input"
            placeholder={classic ? 'Ej: Listas, Cadenas, Recursión, Diccionarios...' : 'Ej: Ecosistema Espacial, Tienda Online, Simulación IoT...'}
            required
          />
          <div class="theme-suggestions">
            <span class="sugg-label">Sugerencias:</span>
            {classic ? (
              <>
                <button type="button" class="sugg-btn" data-val="Listas y Ciclos">Listas</button>
                <button type="button" class="sugg-btn" data-val="Cadenas y Manipulación">Cadenas</button>
                <button type="button" class="sugg-btn" data-val="Diccionarios">Diccionarios</button>
                <button type="button" class="sugg-btn" data-val="Algoritmos y Lógica">Algoritmos</button>
              </>
            ) : (
              <>
                <button type="button" class="sugg-btn" data-val="Arquitectura y POO">POO</button>
                <button type="button" class="sugg-btn" data-val="Simulación de Ecosistema">Ecosistema</button>
                <button type="button" class="sugg-btn" data-val="Motor de Reservas">Reservas</button>
                <button type="button" class="sugg-btn" data-val="Event Bus reactivo">Eventos</button>
              </>
            )}
          </div>
        </div>

        <div class="form-group">
          <label for="ai-diff-select">Nivel de dificultad</label>
          <select id="ai-diff-select" class="form-select">
            <option value="facil">Fácil</option>
            <option value="media" selected>Media</option>
            <option value="dificil">Difícil</option>
            <option value="extrema">Extrema</option>
          </select>
        </div>

        <div id="ai-modal-error" class="modal-error-box" hidden></div>

        <!-- Vista de progreso mientras se genera -->
        <div id="ai-loading-box" class="modal-loading-box" hidden>
          <div class="pulse-loader" aria-hidden="true">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="dot"></span>
          </div>
          <p id="ai-loading-status" class="loading-text">PyBot está estructurando los casos de prueba y las funciones...</p>
        </div>

        <div class="modal-actions">
          <button type="button" id="cancel-ai-btn" class="modal-btn secondary">Cancelar</button>
          <button type="submit" id="submit-ai-btn" class="modal-btn primary">
            Generar con PyBot
          </button>
        </div>
      </form>
    </div>
  </dialog>
</main>

<script>
  // Inicialización de lógica interactiva del catálogo y PyBot
  const page = document.querySelector<HTMLElement>('.catalog-page')!;
  const mode = page.dataset.mode as 'classic' | 'contextual';
  const isClassic = mode === 'classic';

  // Elementos de filtrado
  const pillButtons = document.querySelectorAll<HTMLButtonElement>('.pill-btn');
  const cardsContainer = document.getElementById('cards-container')!;
  const noResults = document.getElementById('no-results-state')!;
  const topicSelect = document.getElementById('topic-select') as HTMLSelectElement | null;
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-filters-btn') as HTMLButtonElement | null;
  const resetBtn = document.getElementById('reset-filter-action');

  let currentDiff = 'all';
  let currentTopic = 'all';
  let currentQuery = '';

  function filterCards() {
    const cards = document.querySelectorAll<HTMLElement>('.card-item');
    let visibleCount = 0;

    cards.forEach(card => {
      const cardDiff = card.dataset.difficulty || '';
      const cardTopics: string[] = JSON.parse(card.dataset.topics || '[]');
      const cardTitle = card.dataset.title || '';

      const matchDiff = currentDiff === 'all' || cardDiff.toLowerCase() === currentDiff.toLowerCase() || (currentDiff === 'Medio' && cardDiff === 'Medio');
      const matchTopic = currentTopic === 'all' || cardTopics.includes(currentTopic);
      const matchQuery = !currentQuery || cardTitle.includes(currentQuery) || cardTopics.some(t => t.toLowerCase().includes(currentQuery));

      const isMatch = matchDiff && matchTopic && matchQuery;
      card.style.display = isMatch ? 'flex' : 'none';
      if (isMatch) visibleCount++;
    });

    if (noResults) {
      noResults.hidden = visibleCount > 0;
    }
  }

  // Eventos de pills
  pillButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      pillButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentDiff = btn.dataset.difficulty || 'all';
      filterCards();
    });
  });

  // Evento de dropdown de temas
  if (topicSelect) {
    topicSelect.addEventListener('change', () => {
      currentTopic = topicSelect.value;
      filterCards();
    });
  }

  // Evento de búsqueda por texto
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      currentQuery = searchInput.value.trim().toLowerCase();
      filterCards();
    });
  }

  // Botón limpiar filtros
  function resetFilters() {
    currentDiff = 'all';
    currentTopic = 'all';
    currentQuery = '';
    pillButtons.forEach(b => b.classList.toggle('active', b.dataset.difficulty === 'all'));
    if (topicSelect) topicSelect.value = 'all';
    if (searchInput) searchInput.value = '';
    filterCards();
  }

  if (clearBtn) clearBtn.addEventListener('click', resetFilters);
  if (resetBtn) resetBtn.addEventListener('click', resetFilters);

  // Comprobar estado de completado en localStorage
  function updateCompletionStatuses() {
    try {
      const progressRaw = localStorage.getItem('pylevel_progress') || '{}';
      const progress = JSON.parse(progressRaw);
      const statusEls = document.querySelectorAll<HTMLElement>('.footer-status');

      statusEls.forEach(el => {
        const id = el.dataset.statusId;
        if (id && progress[id] && progress[id].completed) {
          el.innerHTML = '<span class="status-indicator completed">Resuelto</span>';
        }
      });
    } catch {
      // Ignorar fallback
    }
  }

  updateCompletionStatuses();

  // =========================================================================
  // MODAL Y GENERACIÓN CON PYBOT
  // =========================================================================
  const modal = document.getElementById('ai-generator-modal') as HTMLDialogElement;
  const openModalBtn = document.getElementById('open-ai-modal-btn');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelModalBtn = document.getElementById('cancel-ai-btn');
  const aiForm = document.getElementById('ai-generator-form') as HTMLFormElement;
  const themeInput = document.getElementById('ai-theme-input') as HTMLInputElement;
  const diffSelect = document.getElementById('ai-diff-select') as HTMLSelectElement;
  const loadingBox = document.getElementById('ai-loading-box')!;
  const loadingStatus = document.getElementById('ai-loading-status')!;
  const errorBox = document.getElementById('ai-modal-error')!;
  const submitBtn = document.getElementById('submit-ai-btn') as HTMLButtonElement;

  if (openModalBtn && modal) {
    openModalBtn.addEventListener('click', () => {
      if (typeof modal.showModal === 'function') {
        modal.showModal();
      } else {
        modal.setAttribute('open', 'true');
      }
      themeInput.focus();
    });
  }

  function hideModal() {
    if (modal) {
      if (typeof modal.close === 'function') {
        modal.close();
      } else {
        modal.removeAttribute('open');
      }
      loadingBox.hidden = true;
      errorBox.hidden = true;
      submitBtn.disabled = false;
    }
  }

  if (closeModalBtn) closeModalBtn.addEventListener('click', hideModal);
  if (cancelModalBtn) cancelModalBtn.addEventListener('click', hideModal);

  // Botones de sugerencias de temas
  document.querySelectorAll<HTMLButtonElement>('.sugg-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      if (themeInput && btn.dataset.val) {
        themeInput.value = btn.dataset.val;
      }
    });
  });

  // Enviar generación a la API de PyBot
  if (aiForm) {
    aiForm.addEventListener('submit', async e => {
      e.preventDefault();
      const tema = themeInput.value.trim();
      const dificultad = diffSelect.value;

      loadingBox.hidden = false;
      errorBox.hidden = true;
      submitBtn.disabled = true;

      const loadingMessages = isClassic
        ? ['PyBot está redactando el desafío...', 'Estructurando casos de prueba automáticos...', 'Compilando solución y validando assertions...']
        : ['PyBot está diseñando la arquitectura modular...', 'Generando archivos y contratos de clases...', 'Construyendo suite test_runner...'];

      let msgIndex = 0;
      const interval = setInterval(() => {
        msgIndex = (msgIndex + 1) % loadingMessages.length;
        if (loadingStatus) loadingStatus.textContent = loadingMessages[msgIndex];
      }, 1500);

      try {
        const endpoint = isClassic ? '/api/ai/generate-challenge' : '/api/ai/generate-project';
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tema, dificultad }),
        });

        clearInterval(interval);

        if (!res.ok) {
          throw new Error(`Error en el servidor (${res.status})`);
        }

        const data = await res.json();
        if (!data.success) {
          throw new Error(data.error || 'No se pudo generar el desafío.');
        }

        // Crear dinámicamente la nueva tarjeta en la interfaz
        const nuevo = isClassic ? data.reto : data.proyecto;
        const nuevoId = isClassic ? `ia_${Date.now()}` : `ia_proj_${Date.now()}`;
        const nuevoTitulo = nuevo.titulo || nuevo.nombre || 'Desafío Generado con IA';
        const diffText = (nuevo.dificultad || dificultad).toLowerCase();
        const diffDisplay = diffText === 'facil' ? 'FACIL' : diffText === 'media' ? 'MEDIA' : 'DIFICIL';
        const diffClass = diffText === 'facil' ? 'diff-easy' : diffText === 'media' ? 'diff-medium' : 'diff-hard';

        // Guardar el ejercicio generado en sessionStorage/localStorage para que el editor pueda cargarlo
        try {
          const customStoreKey = isClassic ? 'pylevel_custom_challenges' : 'pylevel_custom_projects';
          const stored = JSON.parse(localStorage.getItem(customStoreKey) || '{}');
          stored[nuevoId] = {
            id: nuevoId,
            ...nuevo,
            isAI: true,
          };
          localStorage.setItem(customStoreKey, JSON.stringify(stored));
        } catch {
          // Ignorar almacenamiento si falla
        }

        // Crear elemento HTML e insertarlo al inicio del grid
        const article = document.createElement('article');
        article.className = 'card-item card-new-highlight';
        article.dataset.id = nuevoId;
        article.dataset.difficulty = diffDisplay === 'FACIL' ? 'Fácil' : diffDisplay === 'MEDIA' ? 'Medio' : 'Difícil';
        article.dataset.topics = JSON.stringify(isClassic ? [nuevo.tema || tema] : nuevo.temas || [tema]);
        article.dataset.title = nuevoTitulo.toLowerCase();

        const categoryTag = isClassic ? (nuevo.tema || tema).toUpperCase() : `PROYECTO IA #${document.querySelectorAll('.card-item').length + 1}`;
        const targetHref = `/ejercicios/${isClassic ? 'clasicos' : 'contextualizados'}/${nuevoId}/`;

        article.innerHTML = `
          <div class="card-header">
            <div class="card-tags-group">
              <span class="card-eyebrow-tag">${categoryTag}</span>
              <span class="ai-badge">IA NUEVO</span>
            </div>
            <div class="card-meta-right">
              <span class="card-diff-chip ${diffClass}">${diffDisplay}</span>
            </div>
          </div>
          <h2 class="card-title">
            <a href="${targetHref}">${nuevoTitulo}</a>
          </h2>
          <p class="card-desc">${nuevo.descripcion || nuevo.enunciado?.slice(0, 140) + '...'}</p>
          ${!isClassic && nuevo.temas ? `<div class="card-hashtags">${nuevo.temas.map((t: string) => `<span class="hashtag-chip">#${t}</span>`).join('')}</div>` : ''}
          <div class="card-footer">
            <div class="footer-metric">
              <span>${isClassic ? `${nuevo.casos_prueba?.length || 4} casos de prueba` : `${Object.keys(nuevo.archivos || {}).length || 3} archivos • ${nuevo.criterios_aceptacion?.length || 4} criterios`}</span>
            </div>
            <div class="footer-status">
              <span class="status-indicator pending">Pendiente</span>
            </div>
          </div>
        `;

        cardsContainer.prepend(article);
        hideModal();

        // Scroll suave hacia la nueva tarjeta
        article.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err: any) {
        clearInterval(interval);
        loadingBox.hidden = true;
        errorBox.hidden = false;
        errorBox.textContent = `Error: ${err.message || 'Ocurrió un error al generar.'}`;
        submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  /* =========================================================================
     ESTILOS MODERNOS Y PRECISOS DEL CATÁLOGO PYLEVEL (DARK THEME PROFUNDO)
     ========================================================================= */

  .catalog-page {
    max-width: 1360px;
    margin: 0 auto;
    padding: 24px 28px 80px;
    color: #e2e8f0;
    box-sizing: border-box;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Sub-barra superior */
  .catalog-subbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 32px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .nav-back {
    color: #94a3b8;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: color 0.15s ease;
  }

  .nav-back:hover {
    color: #38bdf8;
  }

  .mode-tabs {
    display: flex;
    gap: 8px;
    background: #0f172a;
    padding: 4px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mode-tab {
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: none;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.18s ease;
  }

  .mode-tab:hover {
    color: #f1f5f9;
  }

  .mode-tab.active {
    background: #1e293b;
    color: #ffffff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .lang-tag {
    font: 600 12px ui-monospace, monospace;
    color: #64748b;
  }

  .lang-tag b {
    color: #ffd43b;
    margin-left: 4px;
  }

  /* Encabezado */
  .catalog-header {
    margin-bottom: 28px;
