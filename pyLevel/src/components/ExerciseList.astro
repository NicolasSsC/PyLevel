    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 8px 16px;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
    .catalog-toolbar {
      flex-direction: column;
      align-items: stretch;
    }
    .toolbar-left {
      flex-direction: column;
      align-items: stretch;
    }
    .difficulty-pills {
      justify-content: center;
    }
    .search-input {
      width: 100%;
    }
  }
</style>
