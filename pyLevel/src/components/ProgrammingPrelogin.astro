---
const lines = [
  { text: 'from nicegui import ui' },
  { text: '' },
  { text: 'ui.input(placeholder="Correo")', builds: 'email' },
  { text: 'ui.input(placeholder="Clave",' },
  { text: '         password=True)', builds: 'password' },
  { text: '' },
  { text: 'ui.button("Iniciar sesión")', builds: 'signin' },
  { text: 'ui.button("Crear cuenta")', builds: 'account' },
  { text: 'ui.link("Olvidé la contraseña")', builds: 'recovery' },
  { text: '' },
  { text: 'ui.run()' },
];
function tokenize(line: string) {
  return line.split(/("[^"]*"|\b(?:from|import|True|input|button|link|run)\b)/g).filter(Boolean).map(text => ({
    text,
    kind: text.startsWith('"') ? 'string' : /^(from|import|True)$/.test(text) ? 'keyword' : /^(input|button|link|run)$/.test(text) ? 'function' : 'plain',
  }));
}
---

<main id="pylevel-prelogin" class="prelogin" aria-labelledby="login-title">
  <h1 id="login-title" class="sr-only">Iniciar sesión</h1>
  <div class="prelogin-shell">
    <div class="prelogin-workspace">
      <section class="console" aria-label="Animación del código del login">
        <div class="console-bar">
          <a class="prelogin-back" href="/" aria-label="Volver a Inicio" title="Volver a Inicio">←</a>
          <span class="console-file" aria-hidden="true"><span>Py</span> login.py</span>
          <span class="console-language" aria-hidden="true">Python</span>
        </div>
        <div class="console-code" aria-hidden="true">
          {lines.map((line, i) => <div class="code-line" data-code-line data-builds={line.builds}>
            <span class="line-number">{String(i + 1).padStart(2, '0')}</span>
            <code>{tokenize(line.text).map(token => <span class={`token-${token.kind}`} data-code-token>{token.text}</span>)}</code>
          </div>)}
        </div>
        <div class="console-status" aria-hidden="true"><span class="status-dot"></span><span id="prelogin-code-status">Acceso a PyLevel</span><span class="console-encoding">UTF-8</span></div>
      </section>

      <section class="login-preview" aria-label="Formulario de acceso">
        <span class="preview-label" aria-hidden="true">LOGIN <span>↗</span></span>
        <form id="prelogin-form" class="login-form" aria-label="Iniciar sesión" aria-busy="false">
          <div class="login-field" data-login-part="email">
            <label for="prelogin-email" class="sr-only">Correo</label>
            <input id="prelogin-email" name="email" type="email" placeholder="Correo" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="254" required />
          </div>
          <div class="login-field" data-login-part="password">
            <label for="prelogin-password" class="sr-only">Clave</label>
            <input id="prelogin-password" name="password" type="password" placeholder="Clave" autocomplete="current-password" maxlength="200" required />
          </div>
          <div data-login-part="signin"><button id="login-submit" class="login-button sign-in" type="submit" disabled><span id="login-submit-label">Iniciar sesión</span><span class="submit-icon" aria-hidden="true">↗</span></button></div>
          <div data-login-part="account"><a class="login-button create-account" href="/registro">Crear cuenta</a></div>
          <div class="recovery" data-login-part="recovery"><button id="login-recovery" type="button" aria-controls="login-recovery-note" aria-expanded="false">Olvidé la contraseña</button></div>
          <p id="login-error" class="login-message" role="alert" tabindex="-1" hidden></p>
          <p id="login-recovery-note" class="login-message recovery-note" role="status" hidden>La recuperación de contraseña aún no está disponible.</p>
          <noscript><p class="login-message recovery-note">Activa JavaScript para iniciar sesión. También puedes crear una cuenta o volver a Inicio.</p></noscript>
        </form>
        <p id="prelogin-status" class="sr-only" role="status" aria-live="polite"></p>
      </section>
    </div>
    <div class="prelogin-controls"><button id="prelogin-skip" type="button" hidden>Saltar animación <span aria-hidden="true">→</span></button></div>
  </div>
</main>

<style>
  .prelogin [hidden] { display: none; }
  .prelogin { position: fixed; inset: 0; z-index: 99999; display: grid; align-items: center; overflow-y: auto; overscroll-behavior: contain; background: #0d1520; color: #edf3f8; font-family: var(--font-sans); }
  .prelogin-shell { width: min(980px, calc(100% - 80px)); margin: auto; padding-block: 32px; }
  .prelogin-workspace { display: grid; grid-template-columns: 1.15fr 1fr; border: 1px solid #2b3d4f; border-radius: 14px; overflow: hidden; }
  .console { min-width: 0; background: #101b28; }
  .console-bar { display: flex; align-items: center; gap: 20px; min-height: 52px; padding-inline: 22px; border-bottom: 1px solid #26374a; }
  .prelogin-back { display: grid; place-items: center; flex-shrink: 0; width: 44px; min-height: 44px; margin-left: -12px; border-radius: 6px; color: #a8bdcd; font-size: 19px; text-decoration: none; transition: color .2s ease, background .2s ease; }
  .prelogin-back:hover { color: #fff; background: #85c4ef10; }
  .prelogin-back:focus-visible { outline: 2px solid #85c4ef; outline-offset: 2px; }
  .console-file { display: inline-flex; gap: 10px; color: #b9cbd9; font: 11px var(--font-mono); }
  .console-file > span { color: #85c4ef; }
  .console-language { margin-left: auto; color: #8ca6ba; font: 10px var(--font-mono); }
  .console-code { min-height: 330px; padding: 30px 22px; overflow-x: auto; }
  .code-line { display: flex; gap: 18px; min-height: 25px; }
  .line-number { width: 18px; flex-shrink: 0; color: #617b92; font: 10px/25px var(--font-mono); user-select: none; }
  .code-line code { white-space: pre; color: #c6d4e0; font: 12px/25px var(--font-mono); }
  .token-function { color: #85c4ef; }
  .token-keyword { color: #c4a5ee; }
  .token-string { color: #eed17c; }
  .code-line[data-typing] code::after { content: ''; display: inline-block; width: 5px; height: 13px; margin-left: 2px; vertical-align: -2px; background: #ffd343; animation: cursor-blink 1.1s step-end infinite; }
  .console-status { display: flex; align-items: center; gap: 7px; min-height: 36px; padding-inline: 22px; border-top: 1px solid #26374a; color: #91aabc; font: 10px var(--font-mono); }
  .status-dot { width: 5px; height: 5px; border-radius: 50%; background: #ffd343; }
  .console-encoding { margin-left: auto; color: #7893aa; }
  .login-preview { position: relative; min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 70px 44px; background: #132130; border-left: 1px solid #2b3d4f; }
  .preview-label { position: absolute; inset: 22px 24px auto; display: flex; justify-content: space-between; color: #8ca6ba; font: 10px var(--font-mono); letter-spacing: 1.4px; }
  .preview-label > span { color: #85c4ef; font-size: 15px; }
  .login-form { display: grid; gap: 14px; width: 100%; max-width: 300px; margin-inline: auto; }
  [data-login-part] { transition: opacity .3s ease, transform .3s ease; }
  .prelogin[data-animating] [data-login-part]:not(.is-built) { visibility: hidden; opacity: 0; transform: translateY(6px); }
  .login-field input { box-sizing: border-box; display: block; width: 100%; min-height: 50px; padding: 14px 16px; border: 1px solid #3b5268; border-radius: 7px; background: #101c2a; color: #f0f4f8; font: 13px var(--font-sans); transition: border-color .2s ease, box-shadow .2s ease; }
  .login-field input::placeholder { color: #a0b4c5; opacity: 1; }
  .login-field input:hover { border-color: #6a8ca6; }
  .login-field input:focus-visible { outline: 0; border-color: #85c4ef; box-shadow: 0 0 0 3px #85c4ef20; }
  .login-button { box-sizing: border-box; display: inline-flex; align-items: center; justify-content: space-between; gap: 20px; width: 100%; min-height: 50px; padding: 12px 17px; border: 1px solid #e8c54c; border-radius: 7px; background: #ffd343; color: #172c3e; font: 650 13px var(--font-sans); text-decoration: none; cursor: pointer; transition: background .2s ease, border-color .2s ease, transform .2s ease; }
  .sign-in { margin-top: 4px; }
  .submit-icon { font-size: 18px; font-weight: 400; }
  .sign-in:hover:not(:disabled) { background: #ffe17a; border-color: #ffe17a; }
  .login-button:active:not(:disabled) { transform: translateY(1px); }
  .create-account { justify-content: center; border-color: #3b5268; background: transparent; color: #c0d3e2; font-weight: 500; }
  .create-account:hover { background: #85c4ef0c; border-color: #85c4ef; color: #edf3f8; }
  .login-button:focus-visible, .recovery button:focus-visible { outline: 2px solid #85c4ef; outline-offset: 4px; }
  .login-button:disabled { cursor: wait; opacity: .7; }
  .login-form[data-submitting] .submit-icon { width: 15px; height: 15px; border: 2px solid #172c3e40; border-top-color: #172c3e; border-radius: 50%; font-size: 0; animation: login-spin .8s linear infinite; }
  .recovery { text-align: center; }
  .recovery button { min-height: 44px; padding: 8px; border: 0; border-radius: 4px; background: none; color: #adc3d5; font: 12px var(--font-sans); cursor: pointer; }
  .recovery button:hover { color: #edf3f8; text-decoration: underline; text-underline-offset: 4px; }
  .login-message { margin: 0; padding: 12px 14px; border: 1px solid #ed9f9f55; border-radius: 7px; color: #ffc6c6; background: #ed9f9f09; font-size: 12px; line-height: 1.6; overflow-wrap: anywhere; }
  .login-message:focus { outline: 2px solid #ed9f9f; outline-offset: 3px; }
  .recovery-note { border-color: #85c4ef55; color: #c0d3e2; background: #85c4ef09; }
  .prelogin-controls { display: flex; justify-content: flex-end; padding-top: 10px; }
  .prelogin-controls button { display: inline-flex; align-items: center; gap: 14px; min-height: 44px; padding: 10px 4px 10px 14px; border: 0; border-radius: 4px; background: transparent; color: #a8bdcd; font: 12px var(--font-sans); cursor: pointer; transition: color .2s ease; }
  .prelogin-controls button:hover { color: #fff; }
  .prelogin-controls button:focus-visible { outline: 2px solid #85c4ef; outline-offset: 3px; }
  .prelogin[data-ready] .status-dot { background: #82c9a8; }
  .prelogin[data-ready] .prelogin-controls { display: none; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @keyframes cursor-blink { 50% { opacity: 0; } }
  @keyframes login-spin { to { transform: rotate(360deg); } }
  @media (max-width: 700px) {
    .prelogin-shell { width: calc(100% - 40px); padding-block: 24px; }
    .prelogin-workspace { grid-template-columns: 1fr; }
    .console-bar { padding-inline: 16px; min-height: 42px; }
    .console-code { min-height: 0; padding: 20px 16px; }
    .code-line { gap: 12px; min-height: 21px; }
    .code-line code { font-size: 11px; line-height: 21px; }
    .line-number { line-height: 21px; }
    .console-status { padding-inline: 16px; }
    .login-preview { padding: 54px 24px 24px; border-left: 0; border-top: 1px solid #2b3d4f; }
    .preview-label { inset: 20px 24px auto; }
  }
  @media (max-width: 700px) and (max-height: 700px) {
    .prelogin-shell { padding-block: 12px; }
    .console-code { max-height: 176px; padding-block: 12px; overflow-y: auto; }
    .code-line { min-height: 18px; }
    .code-line code, .line-number { line-height: 18px; }
    .console-status { display: none; }
    .login-preview { padding: 42px 20px 18px; }
    .preview-label { inset: 16px 20px auto; }
    .login-form { gap: 10px; }
    .login-field input, .login-button { min-height: 44px; padding-block: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .prelogin *, .prelogin *::after { animation: none !important; transition: none !important; }
  }
</style>

<script>
  (() => {
    const root = document.documentElement;
    const overlay = document.getElementById('pylevel-prelogin');
    const form = document.getElementById('prelogin-form') as HTMLFormElement | null;
    const skip = document.getElementById('prelogin-skip') as HTMLButtonElement | null;
    const email = document.getElementById('prelogin-email') as HTMLInputElement | null;
    const password = document.getElementById('prelogin-password') as HTMLInputElement | null;
    const submit = document.getElementById('login-submit') as HTMLButtonElement | null;
    const submitLabel = document.getElementById('login-submit-label');
    const error = document.getElementById('login-error');
    const announcement = document.getElementById('prelogin-status');
    const recovery = document.getElementById('login-recovery');
    const recoveryNote = document.getElementById('login-recovery-note');
    if (!overlay || !form || !skip || !email || !password || !submit || !submitLabel || !error) { delete root.dataset.prelogin; return; }
    const forced = new URLSearchParams(location.search).get('intro') === '1';
    const readFlag = (key: string) => {
      try { return sessionStorage.getItem(key) === 'true'; } catch { return false; }
    };
    const remember = (key: string) => {
      try { sessionStorage.setItem(key, 'true'); } catch { /* Animation also works without storage. */ }
    };
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const tokens = [...overlay.querySelectorAll<HTMLElement>('[data-code-token]')]
      .map(node => ({ node, text: node.textContent || '' }));
    const codeLines = [...overlay.querySelectorAll<HTMLElement>('[data-code-line]')];
    const parts = [...overlay.querySelectorAll<HTMLElement>('[data-login-part]')];
    const revealAt = new Map<string, number>();
    let lineEnd = 0;
    codeLines.forEach(line => {
      lineEnd += line.querySelector('code')?.textContent?.length || 0;
      if (line.dataset.builds) revealAt.set(line.dataset.builds, lineEnd);
    });
    const total = tokens.reduce((sum, token) => sum + token.text.length, 0);
    let frame = 0;
    let fallback = 0;
    let started = false;
    let ready = false;
    let submitting = false;

    form.inert = true;
    form.setAttribute('aria-busy', 'true');
    overlay.dataset.animating = '';
    tokens.forEach(token => { token.node.textContent = ''; });

    function setSubmitting(value: boolean) {
      submitting = value;
      submit!.disabled = value;
      submitLabel!.textContent = value ? 'Iniciando sesión…' : 'Iniciar sesión';
      form!.setAttribute('aria-busy', String(value));
      form!.toggleAttribute('data-submitting', value);
    }

    function showError(message: string) {
      error!.textContent = message;
      error!.hidden = false;
      error!.focus();
    }

    function destination() {
      const next = new URLSearchParams(location.search).get('next');
      if (!next?.startsWith('/')) return '/perfil';
      try {
        const url = new URL(next, location.origin);
        const path = url.pathname.replace(/\/$/, '');
        if (url.origin === location.origin && ['/perfil', '/examen', '/progreso', '/ejercicios'].includes(path)) {
          return url.pathname + url.search + url.hash;
        }
      } catch { /* Invalid destinations return to the profile. */ }
      return '/perfil';
    }

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (!ready || submitting) return;
      error.hidden = true;
      if (recoveryNote) recoveryNote.hidden = true;
      recovery?.setAttribute('aria-expanded', 'false');
      email.value = email.value.trim();
      if (!form.reportValidity()) return;
      setSubmitting(true);
      if (announcement) announcement.textContent = 'Comprobando tus credenciales.';
      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email.value, password: password.value }),
          signal: AbortSignal.timeout(15000),
        });
        const data = await response.json();
        if (!response.ok || data.ok !== true) {
          setSubmitting(false);
          if (announcement) announcement.textContent = '';
          showError(typeof data.error === 'string' ? data.error : 'No se pudo iniciar sesión. Inténtalo nuevamente.');
          return;
        }
        try { localStorage.removeItem('pylevel:current_user'); } catch { /* The server cookie owns the session. */ }
        password.value = '';
        if (announcement) announcement.textContent = 'Sesión iniciada. Abriendo tu espacio.';
        window.location.assign(destination());
      } catch {
        setSubmitting(false);
        if (announcement) announcement.textContent = '';
        showError('No pudimos conectar. Revisa tu conexión e inténtalo de nuevo.');
      }
    });

    recovery?.addEventListener('click', () => {
      if (!recoveryNote) return;
      recoveryNote.hidden = !recoveryNote.hidden;
      recovery.setAttribute('aria-expanded', String(!recoveryNote.hidden));
    });
    window.addEventListener('pageshow', event => {
      if (event.persisted && ready) {
        setSubmitting(false);
        password.value = '';
        if (announcement) announcement.textContent = '';
      }
    });

    function revealCode(characters: number) {
      let remaining = characters;
      let activeLine: Element | null = null;
      tokens.forEach(({ node, text }) => {
        const visible = Math.max(0, Math.min(remaining, text.length));
        node.textContent = text.slice(0, visible);
        if (!activeLine && remaining <= text.length && text.length) activeLine = node.closest('[data-code-line]');
        remaining -= text.length;
      });
      codeLines.forEach(line => line.toggleAttribute('data-typing', line === activeLine));
      parts.forEach(part => part.classList.toggle('is-built', characters >= (revealAt.get(part.dataset.loginPart || '') ?? Infinity)));
      const consoleCode = overlay!.querySelector<HTMLElement>('.console-code');
      if (activeLine && consoleCode && consoleCode.scrollHeight > consoleCode.clientHeight) {
        const bottom = (activeLine as Element).getBoundingClientRect().bottom - consoleCode.getBoundingClientRect().top;
        if (bottom > consoleCode.clientHeight - 12) consoleCode.scrollTop += bottom - consoleCode.clientHeight + 12;
      }
    }
    function finishTyping() {
      if (ready || !started) return;
      ready = true;
      cancelAnimationFrame(frame);
      window.clearTimeout(fallback);
      revealCode(total);
      codeLines.forEach(line => line.removeAttribute('data-typing'));
      overlay!.dataset.ready = '';
      delete overlay!.dataset.animating;
      form!.inert = false;
      setSubmitting(false);
      remember('pylevel_prelogin_built');
      const status = document.getElementById('prelogin-code-status');
      if (status) status.textContent = 'Listo para iniciar sesión';
      if (announcement) announcement.textContent = 'Formulario listo para iniciar sesión.';
      // After skipping, move focus into the completed result before hiding that control.
      if (document.activeElement === skip) document.getElementById('prelogin-email')?.focus({ preventScroll: true });
      skip!.hidden = true;
    }
    function showPrelogin() {
      if (started) return;
      started = true;
      root.dataset.prelogin = 'active';
      if (motion.matches || (!forced && readFlag('pylevel_prelogin_built'))) {
        finishTyping();
        document.getElementById('prelogin-email')?.focus({ preventScroll: true });
        return;
      }
      const status = document.getElementById('prelogin-code-status');
      if (status) status.textContent = 'Escribiendo…';
      if (announcement) announcement.textContent = 'Se está construyendo el formulario de acceso.';
      skip!.hidden = false;
      skip!.focus({ preventScroll: true });
      fallback = window.setTimeout(finishTyping, 6500);
      const began = performance.now();
      function typeFrame(now: number) {
        if (ready) return;
        const progress = Math.max(0, Math.min(1, (now - began - 300) / 4500));
        revealCode(Math.floor(total * progress));
        if (progress === 1) { finishTyping(); return; }
        frame = requestAnimationFrame(typeFrame);
      }
      frame = requestAnimationFrame(typeFrame);
    }
    skip.addEventListener('click', finishTyping);
    motion.addEventListener('change', () => { if (motion.matches) finishTyping(); });
    window.addEventListener('keydown', event => {
      if (!started) return;
      if (event.key === 'Escape' && !ready) { event.preventDefault(); finishTyping(); return; }
    });
    showPrelogin();
  })();
</script>
