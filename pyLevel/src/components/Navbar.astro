---
const pathname = Astro.url.pathname;

const isActive = (path: string) => {
  if (path === '/') return pathname === '/';
  return pathname === path || pathname.startsWith(path + '/');
};

const navLinks = [
  { href: '/',           label: 'Inicio' },
  { href: '/ejercicios', label: 'Workbench de Ejercicios' },
  { href: '/perfil',     label: 'Mi Perfil' },
];
---

<nav class="pylevel-nav" aria-label="Navegación principal">
  <div class="nav-inner">

    <!-- Logo -->
    <a href="/" class="nav-logo" aria-label="PyLevel – Inicio">
      <span class="logo-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 4C13 4 10 9 10 16v4h14v2H8C4 22 4 28 4 32c0 7 3 12 12 12h4v-6h-2c-4 0-6-2-6-6v-4h28v4c0 4-2 6-6 6h-2v6h4c9 0 12-5 12-12V20c0-8-3-16-16-16zM18 14a2 2 0 110-4 2 2 0 010 4z" fill="#3776AB"/>
          <path d="M24 44c11 0 14-5 14-12v-4H24v-2h16c4 0 4-6 4-10 0-7-3-12-12-12h-4v6h2c4 0 6 2 6 6v4H8v-4c0-4 2-6 6-6h2V4H12C3 4 0 9 0 16v12c0 8 3 16 16 16zM30 34a2 2 0 110 4 2 2 0 010-4z" fill="#FFD43B"/>
        </svg>
      </span>
      <span class="logo-text">Py<span class="logo-blue">Level</span><span class="logo-dot">.</span></span>
      <span class="logo-version">v2.0 Engine</span>
    </a>

    <!-- Links principales reducidos a: Inicio, Workbench de Ejercicios, Mi Perfil -->
    <ul class="nav-links" role="list">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`nav-link${isActive(link.href) ? ' nav-link--active' : ''}`}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Right side: Runner status + User / Auth -->
    <div class="nav-right">
      <span class="runner-badge" title="Motor de ejecución Python en contenedor aislado (gVisor + Docker)">
        <span class="runner-dot" aria-hidden="true"></span>
        <span class="runner-label">Runner: <strong>Online</strong> · gVisor-Docker</span>
      </span>

      <!-- Estado de Autenticación Reactivo -->
      <div id="nav-user-container" class="nav-user-wrapper">
        <a href="/login" id="nav-login-btn" class="nav-auth-btn">Iniciar Sesión</a>
        <div id="nav-user-info" class="nav-user" style="display: none;">
          <span class="user-avatar" id="nav-user-avatar" aria-hidden="true">IS</span>
          <span class="user-name" id="nav-user-name">Estudiante</span>
          <button id="nav-logout-btn" class="nav-logout-icon" title="Cerrar sesión" aria-label="Cerrar sesión">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          </button>
        </div>
      </div>
    </div>

  </div>
</nav>

<script>
  // Control de sesión en cliente
  async function updateNavbarAuth() {
    const loginBtn = document.getElementById('nav-login-btn');
    const userInfo = document.getElementById('nav-user-info');
    const userName = document.getElementById('nav-user-name');
    const userAvatar = document.getElementById('nav-user-avatar');
    const logoutBtn = document.getElementById('nav-logout-btn');

    if (!loginBtn || !userInfo || !userName || !userAvatar) return;

    try {
      // 1. Verificar si hay cookie de sesión activa vía API
      const res = await fetch('/api/auth/me');
      const data = await res.json();

      if (data.user) {
        // Usuario autenticado con PostgreSQL Render
        loginBtn.style.display = 'none';
        userInfo.style.display = 'flex';
        userName.textContent = data.user.displayName || data.user.email.split('@')[0];
        
        const initials = (data.user.displayName || 'IS')
          .split(' ')
          .map((n: string) => n[0])
          .slice(0, 2)
          .join('')
          .toUpperCase();
        userAvatar.textContent = initials || 'IS';

        // Guardar para uso síncrono en vistas
        localStorage.setItem('pylevel:current_user', JSON.stringify(data.user));
      } else {
        // Sin sesión activa
        loginBtn.style.display = 'inline-block';
        userInfo.style.display = 'none';
        localStorage.removeItem('pylevel:current_user');
      }
    } catch {
      // Si falla la red, revisar localStorage como fallback
      const cached = localStorage.getItem('pylevel:current_user');
      if (cached) {
        try {
          const u = JSON.parse(cached);
          loginBtn.style.display = 'none';
          userInfo.style.display = 'flex';
          userName.textContent = u.displayName || u.email.split('@')[0];
          const initials = (u.displayName || 'IS').split(' ').map((n: string) => n[0]).slice(0, 2).join('').toUpperCase();
          userAvatar.textContent = initials || 'IS';
        } catch {
          loginBtn.style.display = 'inline-block';
          userInfo.style.display = 'none';
        }
      }
    }

    if (logoutBtn) {
      logoutBtn.onclick = async () => {
        try {
          await fetch('/api/auth/logout', { method: 'POST' });
        } catch {}
        localStorage.removeItem('pylevel:current_user');
        window.location.href = '/login';
      };
    }
  }

  updateNavbarAuth();
  document.addEventListener('astro:page-load', updateNavbarAuth);
</script>

<style>
  .pylevel-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: 56px;
    background: #0B1120;
    border-bottom: 1px solid #1E293B;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  }

  .nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    height: 100%;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 0;
  }

  /* ── Logo ── */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
    margin-right: 32px;
  }

  .logo-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .logo-text {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.6px;
    color: #E2E8F0;
    line-height: 1;
  }

  .logo-blue { color: #3776AB; }
  .logo-dot  { color: #FFD43B; }

  .logo-version {
    font: 10px ui-monospace, monospace;
    color: #475569;
    letter-spacing: 0.5px;
    background: #111827;
    border: 1px solid #1E293B;
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  /* ── Nav links ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .nav-link {
    display: block;
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 500;
    color: #94A3B8;
    text-decoration: none;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #E2E8F0;
    background: #111827;
  }

  .nav-link--active {
    color: #FFD43B;
    background: rgba(255, 212, 59, 0.08);
    font-weight: 600;
  }

  .nav-link:focus-visible {
    outline: 2px solid #3776AB;
    outline-offset: 3px;
  }

  /* ── Right section ── */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
    margin-left: auto;
  }

  .runner-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    font: 11px ui-monospace, monospace;
    color: #64748B;
    cursor: default;
    user-select: none;
  }

  .runner-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 6px #10B98166;
    animation: pulse-dot 2.5s ease-in-out infinite;
    flex-shrink: 0;
  }

  .runner-label strong {
    color: #10B981;
    font-weight: 600;
  }

  .nav-user-wrapper {
    display: flex;
    align-items: center;
  }

  .nav-auth-btn {
    font-size: 12px;
    font-weight: 600;
    color: #CBD5E1;
    background: #1E293B;
    border: 1px solid rgba(55,118,171,0.3);
    padding: 6px 14px;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }

  .nav-auth-btn:hover {
    background: #3776AB;
    color: #fff;
    border-color: #3776AB;
  }

  .nav-user {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .user-avatar {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #3776AB;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    letter-spacing: 0.5px;
  }

  .user-name {
    font-size: 12px;
    color: #CBD5E1;
    font-weight: 500;
    white-space: nowrap;
    max-width: 140px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-logout-icon {
    background: transparent;
    border: none;
    color: #64748B;
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 4px;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
  }

  .nav-logout-icon:hover {
    color: #F43F5E;
    background: rgba(244,63,94,0.1);
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  @media (max-width: 900px) {
    .runner-badge { display: none; }
    .logo-version { display: none; }
    .user-name { display: none; }
    .nav-link { padding: 6px 8px; font-size: 12px; }
    .nav-logo { margin-right: 16px; }
  }

  @media (max-width: 640px) {
    .nav-links { gap: 0; }
    .nav-link { padding: 6px 6px; font-size: 11px; }
  }
</style>
