---
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isExercises = pathname.startsWith('/ejercicios');

// The middleware checks the cookie per request; no browser-cached identity is trusted.
const sessionUser = Astro.locals.sessionUser;
const authenticated = !!sessionUser;
const user = sessionUser ? {
  ...sessionUser,
  initials: sessionUser.displayName.split(/\s+/).filter(Boolean).slice(0, 2).map(name => name[0]).join('').toUpperCase() || 'US',
} : { displayName: 'Invitado', email: '', bio: 'Inicia sesión para continuar', initials: 'PL' };
const firstName = user.displayName ? user.displayName.split(' ')[0] : 'Estudiante';
const sessionLink = (path: string) => ({
  href: authenticated ? path : undefined,
  'aria-disabled': !authenticated,
  tabindex: authenticated ? undefined : -1,
  title: authenticated ? undefined : 'Inicia sesión para acceder.',
});
---

<header class="pylevel-navbar" id="top-navbar">
  <div class="nav-container">
    <!-- Brand / Logo -->
    <div class="nav-left">
      <a href="/" class="brand-link" aria-label="PyLevel - Inicio">
        <div class="brand-badge" aria-hidden="true">
          <img src="/pylevel-logo.svg" alt="" width="44" height="44" decoding="async" />
        </div>
        <span class="brand-name">
          Py<span class="highlight">Level</span><b class="brand-dot">.</b>
        </span>
      </a>

      <!-- Primary Navigation Links -->
      <nav class="nav-links" aria-label="Navegación principal" data-session-only hidden={!authenticated}>
        <!-- Ejercicios with dropdown -->
        <div class="nav-dropdown-trigger" id="exercises-menu-trigger" data-session-locked={String(!authenticated)}>
          <a data-session-link="/ejercicios/" {...sessionLink('/ejercicios/')} role="link" class:list={['nav-item', { active: isExercises }]}>
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            <span>Ejercicios</span>
            <svg class="chevron-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </a>

          <!-- Ejercicios Submenu Popover -->
          <div class="dropdown-popover exercises-popover" role="menu" data-session-submenu hidden={!authenticated} inert={!authenticated}>
            <div class="popover-arrow"></div>
            <a data-session-link="/ejercicios/clasicos/" {...sessionLink('/ejercicios/clasicos/')} class="popover-item" role="menuitem">
              <div class="popover-icon classic-icon">&lt;/&gt;</div>
              <div class="popover-text">
                <strong>Ejercicios Clásicos</strong>
                <span>Fundamentos, bucles, condiciones y algoritmos</span>
              </div>
            </a>
            <a data-session-link="/ejercicios/contextualizados/" {...sessionLink('/ejercicios/contextualizados/')} class="popover-item" role="menuitem">
              <div class="popover-icon project-icon">{'{ }'}</div>
              <div class="popover-text">
                <strong>Contextualizados</strong>
                <span>Proyectos con lógica real y varios archivos</span>
              </div>
            </a>
          </div>
        </div>
        <a data-session-link="/examen/" {...sessionLink('/examen/')} role="link" class:list={['nav-item', { active: pathname.startsWith('/examen') }]}>
          <span aria-hidden="true">▤</span><span>Examen</span>
        </a>
      </nav>
    </div>

    <!-- Actions / Right Tools -->
    <div class="nav-right">
      <!-- Dark / Light Theme Toggle -->
      <button
        id="theme-toggle-btn"
        class="icon-btn theme-btn"
        type="button"
        aria-label="Cambiar modo de color"
        title="Cambiar modo claro / oscuro"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="theme-icon sun-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="theme-icon moon-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Notifications -->
      <div class="dropdown-wrapper" id="notifications-wrapper" hidden={!authenticated}>
        <button
          id="notifications-btn"
          class="icon-btn notif-btn"
          type="button"
          aria-label="Notificaciones"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
          <span class="notif-badge" id="notif-badge" aria-label="2 notificaciones no leídas">2</span>
        </button>

        <!-- Notifications Popover -->
        <div class="dropdown-menu notif-dropdown" id="notifications-dropdown" role="region" aria-label="Notificaciones">
          <div class="dropdown-header">
            <div class="header-title">
              <h3>Notificaciones</h3>
              <span class="unread-pill" id="unread-count-text" role="status" aria-live="polite" aria-atomic="true">2 nuevas</span>
            </div>
            <button id="mark-read-btn" class="header-action-btn" type="button">Marcar leídas</button>
          </div>

          <div class="notif-list" id="notif-list">
            <article class="notif-item unread" data-id="1">
              <div class="notif-indicator"></div>
              <div class="notif-avatar notif-blue">Py</div>
              <div class="notif-content">
                <p class="notif-text"><strong>¡Bienvenido a PyLevel!</strong> Comienza practicando con ejercicios clásicos o proyectos.</p>
                <time class="notif-time">Hace 10 min</time>
              </div>
            </article>

            <article class="notif-item unread" data-id="2">
              <div class="notif-indicator"></div>
              <div class="notif-avatar notif-gold">Reto</div>
              <div class="notif-content">
                <p class="notif-text"><strong>Nuevo reto disponible:</strong> Pon a prueba tu lógica resolviendo <em>Bubble Sort</em>.</p>
                <time class="notif-time">Hace 1 hora</time>
              </div>
            </article>

            <article class="notif-item" data-id="3">
              <div class="notif-avatar notif-green">OK</div>
              <div class="notif-content">
                <p class="notif-text"><strong>Ejecutor seguro:</strong> Entorno gVisor aislado preparado para evaluar tus soluciones.</p>
                <time class="notif-time">Ayer</time>
              </div>
            </article>
          </div>

          <div class="dropdown-footer">
            <a href="/ejercicios/" class="view-all-link">Explorar catálogo de retos →</a>
          </div>
        </div>
      </div>

      <!-- User Profile -->
      {isHome && <a href="/login" id="home-signin-link" class="nav-signin" hidden={authenticated}>Iniciar sesión <span aria-hidden="true">↗</span></a>}
      <div class="dropdown-wrapper" id="profile-wrapper" data-session-only hidden={!authenticated}>
        <button
          id="profile-btn"
          class="profile-btn"
          type="button"
          aria-label="Menú de perfil de usuario"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <div class="avatar-circle">
            <span class="avatar-initials" id="user-avatar-initials">{user.initials}</span>
            <span class="status-dot-online" aria-label="En línea"></span>
          </div>
          <span class="profile-username" id="user-profile-name">{firstName}</span>
          <svg class="chevron-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Profile Popover -->
        <div class="dropdown-menu profile-dropdown" id="profile-dropdown" role="menu">
          <div class="profile-summary">
            <div class="summary-avatar" id="dropdown-avatar">{user.initials}</div>
            <div class="summary-details">
              <strong id="dropdown-display-name">{user.displayName}</strong>
              <span class="summary-email" id="dropdown-email">{user.email}</span>
              <span class="summary-level" id="dropdown-bio">{sessionUser?.occupation || user.bio || 'Aprendiendo Python en PyLevel'}</span>
            </div>
          </div>

          <div class="profile-menu-links">
            <a href="/admin/" class="menu-item" role="menuitem" data-admin-link hidden={sessionUser?.role !== 'admin'}><span>Panel de administración</span></a>
            <a href="/perfil" class="menu-item" role="menuitem">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span>Mi perfil</span>
            </a>
            <a href="/progreso/" class="menu-item" role="menuitem">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
              </svg>
              <span>Progreso y Métricas</span>
            </a>
          </div>

          <div class="dropdown-divider"></div>

          <button id="logout-btn" class="menu-item logout-item" type="button" role="menuitem">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span>Cerrar sesión</span>
          </button>
        </div>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        class="icon-btn mobile-menu-btn"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg class="hamburger-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="close-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <div class="mobile-nav-links">
      <a href="/admin/" class="mobile-nav-item" data-admin-link hidden={sessionUser?.role !== 'admin'}>Panel de administración</a>
      <a href="/" class:list={['mobile-nav-item', { active: isHome }]}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span>Inicio</span>
      </a>
      <a data-session-link="/ejercicios/" {...sessionLink('/ejercicios/')} role="link" class:list={['mobile-nav-item', { active: isExercises }]}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
        <span>Todos los ejercicios</span>
      </a>
      <div class="mobile-sublinks" data-session-only hidden={!authenticated}>
        <a data-session-link="/ejercicios/clasicos/" {...sessionLink('/ejercicios/clasicos/')} role="link" class="mobile-sublink">&lt;/&gt; Ejercicios Clásicos</a>
        <a data-session-link="/ejercicios/contextualizados/" {...sessionLink('/ejercicios/contextualizados/')} role="link" class="mobile-sublink">{'{ }'} Contextualizados</a>
      </div>
      <a data-session-link="/examen/" {...sessionLink('/examen/')} role="link" class:list={['mobile-nav-item', { active: pathname.startsWith('/examen') }]}>Examen de Python</a>
    </div>

    <div class="mobile-drawer-footer">
      <div class="mobile-user-card" data-session-only hidden={!authenticated}>
        <div class="avatar-circle" id="mobile-avatar">{user.initials}</div>
        <div class="user-info">
          <strong id="mobile-name">{user.displayName}</strong>
          <span id="mobile-email">{user.email}</span>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .pylevel-navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    height: var(--nav-height, 68px);
    background: var(--nav-bg, rgba(255, 255, 255, 0.95));
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--nav-border, #dce3e9);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .nav-container {
    max-width: 1280px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  /* Left Side: Brand and Links */
  .nav-left {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--color-text-primary);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.8px;
    user-select: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .brand-link:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .brand-badge {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
  }

  .brand-badge img { display: block; width: 100%; height: 100%; object-fit: contain; }

  .brand-name .highlight {
    color: var(--color-primary);
  }

  .brand-dot {
    color: var(--color-accent-gold);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 550;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .nav-item:hover {
    color: var(--color-text-primary);
    background: var(--color-surface-hover);
  }

  .nav-item.active {
    color: var(--color-primary);
    background: var(--color-primary-light);
  }

  .nav-icon {
    flex-shrink: 0;
  }

  .chevron-icon {
    transition: transform 0.2s ease;
  }

  /* Ejercicios Menu Popover */
  .nav-dropdown-trigger {
    position: relative;
  }

  .nav-dropdown-trigger:hover .chevron-icon,
  .nav-dropdown-trigger:focus-within .chevron-icon {
    transform: rotate(180deg);
  }

  .dropdown-popover {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 290px;
    background: var(--dropdown-bg);
    border: 1px solid var(--dropdown-border);
    border-radius: 12px;
    box-shadow: var(--dropdown-shadow);
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    z-index: 110;
  }

  .nav-dropdown-trigger:hover .dropdown-popover,
  .nav-dropdown-trigger:focus-within .dropdown-popover {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .popover-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--color-text-primary);
    transition: background-color 0.15s ease;
  }

  .popover-item:hover {
    background: var(--color-surface-hover);
  }

  .popover-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    font: 600 13px var(--font-mono);
    flex-shrink: 0;
  }

  .classic-icon {
    background: rgba(55, 118, 171, 0.12);
    color: var(--color-primary);
  }

  .project-icon {
    background: rgba(213, 168, 21, 0.15);
    color: var(--color-accent-gold);
  }

  .popover-text strong {
    display: block;
    font-size: 13px;
    font-weight: 600;
  }

  .popover-text span {
    display: block;
    font-size: 11px;
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin-top: 2px;
  }

  /* Right Tools */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nav-signin { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; padding: 10px 15px; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-primary-light); color: var(--color-text-primary); font-size: 13px; font-weight: 650; text-decoration: none; white-space: nowrap; transition: background .2s ease, border-color .2s ease; }
  .nav-signin:hover { background: var(--color-surface-hover); border-color: var(--color-primary); }
  .nav-signin:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  .nav-signin[hidden], .dropdown-wrapper[hidden] { display: none; }
  @media (max-width: 400px) { .nav-signin { padding-inline: 10px; gap: 6px; font-size: 12px; } }

  .icon-btn {
    display: grid;
    place-items: center;
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .icon-btn:hover {
    color: var(--color-text-primary);
    background: var(--color-surface-hover);
    border-color: var(--color-border);
  }

  .icon-btn:focus-visible,
  .profile-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Theme Button (Sun / Moon) */
  .theme-btn .sun-icon {
    display: none;
    color: #facc15;
  }

  .theme-btn .moon-icon {
    display: block;
    color: var(--color-text-secondary);
  }

  :global(html.dark) .theme-btn .sun-icon {
    display: block;
  }

  :global(html.dark) .theme-btn .moon-icon {
    display: none;
  }

  /* Notifications Button & Badge */
  .notif-badge {
    position: absolute;
    top: 5px;
    right: 5px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 9px;
    background: var(--danger-color);
    color: #ffffff;
    font: 700 10px/17px var(--font-sans);
    text-align: center;
    border: 2px solid var(--color-surface);
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.2s ease;
  }

  .notif-badge.hidden-badge {
    transform: scale(0);
    opacity: 0;
  }

  /* Dropdown Menus (General) */
  .dropdown-wrapper {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    background: var(--dropdown-bg);
    border: 1px solid var(--dropdown-border);
    border-radius: 14px;
    box-shadow: var(--dropdown-shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px) scale(0.98);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s;
    z-index: 120;
    overflow: hidden;
  }

  .dropdown-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* Notifications Dropdown */
  .notif-dropdown {
    width: 340px;
  }

  .dropdown-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-hover);
  }

  .header-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header-title h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .unread-pill {
    padding: 2px 7px;
    border-radius: 10px;
    background: var(--color-primary-light);
    color: var(--color-primary);
    font-size: 11px;
    font-weight: 600;
  }

  .header-action-btn {
    border: none;
    background: none;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
    padding: 4px 6px;
    border-radius: 4px;
  }

  .header-action-btn:hover:enabled {
    text-decoration: underline;
  }

  .header-action-btn:disabled { opacity: .5; cursor: default; }

  .notif-list {
    max-height: 320px;
    overflow-y: auto;
  }

  .notif-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background 0.15s ease;
  }

  .notif-item:last-child {
    border-bottom: none;
  }

  .notif-item.unread {
    background: rgba(56, 189, 248, 0.04);
  }

  .notif-indicator {
    position: absolute;
    left: 7px;
    top: 18px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .notif-item:not(.unread) .notif-indicator {
    display: none;
  }

  .notif-avatar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    font-size: 14px;
    flex-shrink: 0;
  }

  .notif-blue { background: rgba(55, 118, 171, 0.14); }
  .notif-gold { background: rgba(213, 168, 21, 0.18); }
  .notif-green { background: rgba(16, 185, 129, 0.15); }

  .notif-content {
    flex: 1;
    min-width: 0;
  }

  .notif-text {
    margin: 0;
    font-size: 12px;
    line-height: 1.45;
    color: var(--color-text-primary);
  }

  .notif-time {
    display: block;
    margin-top: 4px;
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .dropdown-footer {
    padding: 10px 18px;
    border-top: 1px solid var(--color-border);
    text-align: center;
    background: var(--color-surface-hover);
  }

  .view-all-link {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .view-all-link:hover {
    text-decoration: underline;
  }

  /* Profile Button */
  .profile-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px 4px 4px;
    border-radius: 24px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .profile-btn:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-primary);
  }

  .avatar-circle {
    position: relative;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3776ab 0%, #1e3a52 100%);
    color: #ffffff;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: -0.5px;
  }

  .status-dot-online {
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--success-color);
    border: 2px solid var(--color-surface);
  }

  .profile-username {
    font-size: 13px;
    font-weight: 600;
  }

  /* Profile Dropdown */
  .profile-dropdown {
    width: 260px;
    padding: 6px;
  }

  .profile-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: var(--color-surface-hover);
    border-radius: 10px;
    margin-bottom: 6px;
  }

  .summary-avatar {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3776ab 0%, #ffd343 120%);
    color: #ffffff;
    font-weight: 700;
    font-size: 14px;
    flex-shrink: 0;
  }

  .summary-details {
    min-width: 0;
  }

  .summary-details strong {
    display: block;
    font-size: 13px;
    color: var(--color-text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .summary-email {
    display: block;
    font-size: 11px;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .summary-level {
    display: inline-block;
    margin-top: 4px;
    font-size: 10px;
    font-weight: 600;
    color: var(--color-accent-gold);
  }

  .profile-menu-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .menu-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-primary);
    text-decoration: none;
    border: none;
    background: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .menu-item:hover {
    background: var(--color-surface-hover);
  }

  .pill-badge {
    margin-left: auto;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--color-primary-light);
    color: var(--color-primary);
  }

  .dropdown-divider {
    height: 1px;
    background: var(--color-border);
    margin: 6px 0;
  }

  .logout-item {
    color: var(--danger-color);
  }

  .logout-item:hover {
    background: rgba(239, 68, 68, 0.08);
  }

  /* Mobile Hamburger & Drawer */
  .mobile-menu-btn {
    display: none;
  }

  .mobile-drawer {
    display: none;
  }

  /* Responsive Rules */
  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .profile-username {
      display: none;
    }

    .profile-btn {
      padding: 3px;
    }

    .profile-btn .chevron-icon {
      display: none;
    }

    .mobile-menu-btn {
      display: grid;
    }

    .notif-dropdown {
      position: fixed;
      top: var(--nav-height);
      left: 16px;
      right: 16px;
      width: auto;
      max-width: none;
    }

    .profile-dropdown {
      position: fixed;
      top: var(--nav-height);
      left: 16px;
      right: 16px;
      width: auto;
      max-width: none;
    }

    .mobile-drawer:not([hidden]) {
      display: flex;
      flex-direction: column;
      position: fixed;
      top: var(--nav-height);
      left: 0;
      width: 100%;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
      padding: 16px;
      z-index: 99;
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .mobile-nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      color: var(--color-text-primary);
      text-decoration: none;
    }

    .mobile-nav-item.active {
      background: var(--color-primary-light);
      color: var(--color-primary);
    }

    .mobile-sublinks {
      padding-left: 36px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin: 4px 0 12px;
    }

    .mobile-sublink {
      font-size: 13px;
      color: var(--color-text-secondary);
      text-decoration: none;
    }

    .mobile-drawer-footer {
      border-top: 1px solid var(--color-border);
      margin-top: 12px;
      padding-top: 12px;
    }

    .mobile-user-card {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .user-info strong {
      display: block;
      font-size: 13px;
    }

    .user-info span {
      display: block;
      font-size: 11px;
      color: var(--color-text-muted);
    }
  }
  [data-session-link][aria-disabled='true'], [data-session-only][hidden], [data-admin-link][hidden] { display: none; }
  .exercises-popover[hidden] { display: none; }
  .nav-dropdown-trigger[data-session-locked='true'] .chevron-icon { transform: none; }
</style>

<script>
  // DOM Elements
  const themeToggle = document.getElementById('theme-toggle-btn');
  const notifBtn = document.getElementById('notifications-btn');
  const notifDropdown = document.getElementById('notifications-dropdown');
  const notifBadge = document.getElementById('notif-badge');
  const markReadBtn = document.getElementById('mark-read-btn') as HTMLButtonElement | null;
  const unreadCountText = document.getElementById('unread-count-text');
  const notifications = [...document.querySelectorAll<HTMLElement>('#notif-list .notif-item[data-id]')]
    .map(item => ({ item, id: item.dataset.id!, initiallyUnread: item.classList.contains('unread') }));
  let notificationUserId: string | null = null;
  let notificationReadIds = new Set<string>();

  function renderNotificationState() {
    let unread = 0;
    notifications.forEach(({ item, id, initiallyUnread }) => {
      const isUnread = initiallyUnread && !notificationReadIds.has(id);
      item.classList.toggle('unread', isUnread);
      if (isUnread) unread++;
    });
    if (notifBadge) {
      notifBadge.textContent = String(unread);
      notifBadge.hidden = unread === 0;
      notifBadge.classList.toggle('hidden-badge', unread === 0);
      notifBadge.setAttribute('aria-label', `${unread} ${unread === 1 ? 'notificación no leída' : 'notificaciones no leídas'}`);
    }
    if (unreadCountText) {
      unreadCountText.textContent = `${unread} ${unread === 1 ? 'nueva' : 'nuevas'}`;
      unreadCountText.style.opacity = unread ? '1' : '0.5';
    }
    if (markReadBtn) markReadBtn.disabled = !notificationUserId || unread === 0;
  }

  function restoreNotificationState(userId: string | null) {
    if (notificationUserId !== userId) notificationReadIds = new Set();
    notificationUserId = userId;
    if (userId) {
      try {
        const saved = JSON.parse(localStorage.getItem(`pylevel:notifications:read:${userId}`) || '[]');
        notificationReadIds = new Set(Array.isArray(saved) ? saved.filter((id): id is string => typeof id === 'string') : []);
      } catch { /* Keep this page usable when browser storage is unavailable. */ }
    }
    renderNotificationState();
  }
  
  const profileBtn = document.getElementById('profile-btn');
  const profileDropdown = document.getElementById('profile-dropdown');
  const logoutBtn = document.getElementById('logout-btn');

  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');

  // --- Dark / Light Theme Logic ---
  function applyTheme(theme: 'light' | 'dark') {
    const root = document.documentElement;
    root.setAttribute('data-theme', theme);
    if (theme === 'dark') {
      root.classList.add('dark');
    } else {
      root.classList.remove('dark');
    }
    localStorage.setItem('pylevel-theme', theme);
  }

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const current = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      const next = current === 'dark' ? 'light' : 'dark';
      applyTheme(next);
    });
  }

  // --- Dropdowns Interactivity ---
  function closeAllDropdowns() {
    if (notifDropdown?.classList.contains('is-open')) {
      notifDropdown.classList.remove('is-open');
      notifBtn?.setAttribute('aria-expanded', 'false');
    }
    if (profileDropdown?.classList.contains('is-open')) {
      profileDropdown.classList.remove('is-open');
      profileBtn?.setAttribute('aria-expanded', 'false');
    }
  }

  // Notifications Dropdown Toggle
  notifBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = notifDropdown?.classList.contains('is-open');
    closeAllDropdowns();
    if (!isOpen) {
      notifDropdown?.classList.add('is-open');
      notifBtn?.setAttribute('aria-expanded', 'true');
    }
  });

  // Profile Dropdown Toggle
  profileBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = profileDropdown?.classList.contains('is-open');
    closeAllDropdowns();
    if (!isOpen) {
      profileDropdown?.classList.add('is-open');
      profileBtn?.setAttribute('aria-expanded', 'true');
    }
  });

  // Mark all notifications as read
  markReadBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!notificationUserId) return;
    notifications.forEach(({ id }) => notificationReadIds.add(id));
    try {
      localStorage.setItem(`pylevel:notifications:read:${notificationUserId}`, JSON.stringify([...notificationReadIds]));
    } catch { /* Reading notifications still works for the current page. */ }
    renderNotificationState();
  });
  window.addEventListener('storage', event => {
    if (notificationUserId && (event.key === null || event.key === `pylevel:notifications:read:${notificationUserId}`)) {
      restoreNotificationState(notificationUserId);
    }
  });

  // Real session sync and logout
  const sessionLinks = [...document.querySelectorAll<HTMLAnchorElement>('#top-navbar [data-session-link]')];
  let sessionRequest = 0;

  function setSessionNavigation(authenticated: boolean) {
    document.querySelectorAll<HTMLElement>('#python-home [data-guest-only]').forEach(link => { link.hidden = authenticated; });
    const notificationsWrapper = document.getElementById('notifications-wrapper');
    if (notificationsWrapper) notificationsWrapper.hidden = !authenticated;
    const pybot = document.getElementById('pybot-widget');
    if (pybot) {
      pybot.hidden = !authenticated;
      if (!authenticated && document.getElementById('pybot-trigger-btn')?.getAttribute('aria-expanded') === 'true') {
        document.getElementById('pybot-close-btn')?.click();
      }
    }
    document.querySelectorAll<HTMLElement>('#top-navbar [data-session-only]').forEach(group => { group.hidden = !authenticated; });
    sessionLinks.forEach(link => {
      link.setAttribute('aria-disabled', String(!authenticated));
      if (authenticated && link.dataset.sessionLink) {
        link.href = link.dataset.sessionLink;
        link.removeAttribute('tabindex');
        link.removeAttribute('title');
      } else {
        link.removeAttribute('href');
        link.tabIndex = -1;
        link.title = 'Inicia sesión para acceder.';
      }
    });
    const exerciseMenu = document.getElementById('exercises-menu-trigger');
    if (exerciseMenu) exerciseMenu.dataset.sessionLocked = String(!authenticated);
    const submenu = document.querySelector<HTMLElement>('[data-session-submenu]');
    if (submenu) { submenu.hidden = !authenticated; submenu.inert = !authenticated; }
    const signinLink = document.getElementById('home-signin-link');
    if (signinLink) {
      signinLink.hidden = authenticated;
    }
  }

  async function checkAuthSession() {
    const request = ++sessionRequest;
    try {
      const res = await fetch('/api/auth/me');
      if (!res.ok) throw new Error('session');
      const data = await res.json();
      if (request !== sessionRequest) return;
      document.querySelectorAll<HTMLElement>('[data-admin-link]').forEach(link => { link.hidden = data.user?.role !== 'admin'; });
      restoreNotificationState(typeof data.user?.id === 'string' ? data.user.id : null);
      if (data.user) {
        const initials = (data.user.displayName || 'US')
          .split(' ')
          .map((n: string) => n[0])
          .slice(0, 2)
          .join('')
          .toUpperCase();
        const firstName = (data.user.displayName || '').split(' ')[0] || 'Estudiante';

        const avatarEl = document.getElementById('user-avatar-initials');
        const nameEl = document.getElementById('user-profile-name');
        const dropAvatar = document.getElementById('dropdown-avatar');
        const dropName = document.getElementById('dropdown-display-name');
        const dropEmail = document.getElementById('dropdown-email');
        const dropBio = document.getElementById('dropdown-bio');

        if (avatarEl) avatarEl.textContent = initials;
        if (nameEl) nameEl.textContent = firstName;
        if (dropAvatar) dropAvatar.textContent = initials;
        if (dropName) dropName.textContent = data.user.displayName;
        if (dropEmail) dropEmail.textContent = data.user.email;
        if (dropBio) dropBio.textContent = data.user.occupation || data.user.bio || 'Aprendiendo Python en PyLevel';
        const mobileName = document.getElementById('mobile-name');
        const mobileEmail = document.getElementById('mobile-email');
        const mobileAvatar = document.getElementById('mobile-avatar');
        if (mobileName) mobileName.textContent = data.user.displayName;
        if (mobileEmail) mobileEmail.textContent = data.user.email;
        if (mobileAvatar) mobileAvatar.textContent = initials;
      }
      setSessionNavigation(!!data.user);
    } catch {
      if (request === sessionRequest) {
        document.querySelectorAll<HTMLElement>('[data-admin-link]').forEach(link => { link.hidden = true; });
        restoreNotificationState(null);
        setSessionNavigation(false);
      }
    }
  }
  checkAuthSession();
  window.addEventListener('pylevel:profile-updated', checkAuthSession);
  window.addEventListener('focus', checkAuthSession);
  window.addEventListener('pageshow', event => {
    if (event.persisted) {
      checkAuthSession();
    }
  });

  logoutBtn?.addEventListener('click', async () => {
    try {
      const response = await fetch('/api/auth/logout', { method: 'POST' });
      if (!response.ok) throw new Error('logout');
      setSessionNavigation(false);
      try { localStorage.removeItem('pylevel:current_user'); } catch { /* The server session is already closed. */ }
      window.location.href = '/';
    } catch {
      if (logoutBtn) logoutBtn.textContent = 'No se pudo cerrar sesión. Reintentar';
    }
  });

  // Close when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('.dropdown-wrapper')) {
      closeAllDropdowns();
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAllDropdowns();
      if (mobileDrawer && !mobileDrawer.hidden) {
        toggleMobileMenu();
      }
    }
  });

  // --- Mobile Drawer Toggle ---
  function toggleMobileMenu() {
    if (!mobileDrawer || !mobileMenuBtn) return;
    const isHidden = mobileDrawer.hidden;
    mobileDrawer.hidden = !isHidden;
    mobileMenuBtn.setAttribute('aria-expanded', String(isHidden));
    const hamburger = mobileMenuBtn.querySelector('.hamburger-icon') as HTMLElement;
    const close = mobileMenuBtn.querySelector('.close-icon') as HTMLElement;
    if (hamburger && close) {
      hamburger.style.display = isHidden ? 'none' : 'block';
      close.style.display = isHidden ? 'block' : 'none';
    }
  }

  mobileMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeAllDropdowns();
    toggleMobileMenu();
  });
</script>
