---
// Componente de Asistente Virtual Flotante PyBot
---

<!-- Contenedor global del widget flotante -->
<aside id="pybot-widget" class="pybot-widget-container" aria-label="Asistente virtual PyBot">
  <!-- Botón circular flotante -->
  <button
    type="button"
    id="pybot-trigger-btn"
    class="pybot-floating-circle"
    aria-expanded="false"
    aria-controls="pybot-chat-panel"
    aria-label="Abrir asistente de Python PyBot"
    title="Abrir PyBot 🤖"
  >
    <div class="circle-halo" aria-hidden="true"></div>
    <div class="circle-icon-wrap" aria-hidden="true">
      <!-- Icono de Bot inteligente (SVG) -->
      <svg class="bot-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 8V4H8" />
        <rect width="16" height="12" x="4" y="8" rx="2" />
        <path d="M2 14h2" />
        <path d="M20 14h2" />
        <path d="M15 13v2" />
        <path d="M9 13v2" />
      </svg>
      <!-- Icono de Cerrar (SVG, se activa al abrir) -->
      <svg class="close-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </div>
    <span class="online-indicator-dot" title="PyBot en línea" aria-hidden="true"></span>
  </button>

  <!-- Panel / Ventana de Chat Flotante -->
  <section
    id="pybot-chat-panel"
    class="pybot-panel"
    role="region"
    aria-labelledby="pybot-panel-title"
    hidden
  >
    <!-- Cabecera del Panel -->
    <header class="panel-header">
      <div class="header-profile">
        <div class="avatar-bubble" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="16" height="12" x="4" y="8" rx="2" />
            <path d="M12 8V4H8" />
            <path d="M15 13v2" />
            <path d="M9 13v2" />
          </svg>
        </div>
        <div class="header-text">
          <h2 id="pybot-panel-title" class="bot-name">PyBot 🤖</h2>
          <span class="bot-status"><span class="status-dot"></span> Tutor pedagógico ⚡</span>
        </div>
      </div>

      <div class="header-actions">
        <!-- Botón Limpiar conversación -->
        <button type="button" id="pybot-clear-btn" class="header-action-btn" title="Limpiar conversación" aria-label="Limpiar conversación">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 6h18" />
            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
          </svg>
        </button>
        <!-- Botón Minimizar -->
        <button type="button" id="pybot-minimize-btn" class="header-action-btn" title="Minimizar chat" aria-label="Minimizar chat">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
        <!-- Botón Cerrar (X) -->
        <button type="button" id="pybot-close-btn" class="header-action-btn" title="Cerrar chat" aria-label="Cerrar chat">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Contexto activo opcional (detecta si está en un ejercicio) -->
    <div id="pybot-context-banner" class="context-banner" hidden>
      <span class="context-tag">Contexto activo 🎯:</span>
      <span id="pybot-context-title" class="context-name">Ejercicio</span>
    </div>

    <!-- Contenedor de Mensajes -->
    <div id="pybot-messages" class="messages-container" tabindex="0" aria-live="polite">
      <!-- Mensaje inicial de bienvenida -->
      <div class="msg-row bot-row">
        <div class="msg-bubble bot-bubble">
          <p>¡Hola! 👋 Soy <strong>PyBot</strong> 🤖, tu tutor pedagógico de Python en PyLevel.</p>
          <p>Puedo resolver tus dudas sobre sintaxis 🐍, estructuras de datos 📦, o darte pistas si estás atascado en un ejercicio 💡. ¿En qué te puedo orientar hoy? 🚀</p>
        </div>
      </div>

      <!-- Sugerencias rápidas -->
      <div id="pybot-chips-wrap" class="quick-chips">
        <button type="button" class="quick-chip" data-prompt="¿Cuál es la diferencia entre is y == en Python?">
          💡 is vs ==
        </button>
        <button type="button" class="quick-chip" data-prompt="Explícame cómo funcionan las List Comprehensions">
          📦 List Comprehensions
        </button>
        <button type="button" class="quick-chip" data-prompt="¿Qué es una función generadora y cómo se usa yield?">
          ⚡ Generadores con yield
        </button>
        <button type="button" class="quick-chip" data-prompt="¿Cómo operan los diccionarios y el método .get() en Python?">
          🗂️ Diccionarios
        </button>
      </div>
    </div>

    <!-- Indicador de escritura (loader) -->
    <div id="pybot-typing" class="typing-indicator" hidden aria-label="PyBot está respondiendo">
      <div class="typing-dots">
        <span></span><span></span><span></span>
      </div>
      <span class="typing-label">PyBot está pensando... 🧠</span>
    </div>

    <!-- Barra inferior de entrada de texto -->
    <form id="pybot-form" class="panel-input-bar">
      <label for="pybot-input" class="sr-only">Pregunta para PyBot</label>
      <textarea
        id="pybot-input"
        class="chat-input"
        placeholder="Pregúntale a PyBot sobre Python... 🐍"
        rows="1"
        maxlength="1000"
      ></textarea>
      <button type="submit" id="pybot-send-btn" class="send-btn" aria-label="Enviar mensaje" disabled title="Enviar mensaje">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m5 12 14-7-7 14-2-5-5-2Z" />
        </svg>
      </button>
    </form>
  </section>
</aside>

<script>
  // Lógica interactiva del widget flotante de PyBot
  const widget = document.getElementById('pybot-widget');
  const triggerBtn = document.getElementById('pybot-trigger-btn') as HTMLButtonElement;
  const panel = document.getElementById('pybot-chat-panel') as HTMLElement;
  const minimizeBtn = document.getElementById('pybot-minimize-btn');
  const closeBtn = document.getElementById('pybot-close-btn');
  const clearBtn = document.getElementById('pybot-clear-btn');
  const messagesContainer = document.getElementById('pybot-messages')!;
  const chatForm = document.getElementById('pybot-form') as HTMLFormElement;
  const chatInput = document.getElementById('pybot-input') as HTMLTextAreaElement;
  const sendBtn = document.getElementById('pybot-send-btn') as HTMLButtonElement;
  const typingIndicator = document.getElementById('pybot-typing')!;
  const chipsWrap = document.getElementById('pybot-chips-wrap');
  const contextBanner = document.getElementById('pybot-context-banner')!;
  const contextTitle = document.getElementById('pybot-context-title')!;

  interface ChatMessage {
    rol: 'user' | 'bot';
    contenido: string;
  }

  const STORAGE_KEY = 'pylevel_pybot_history';
  let history: ChatMessage[] = [];

  // Cargar historial previo de localStorage
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      history = JSON.parse(raw);
    }
  } catch {
    history = [];
  }

  // Renderizar historial existente
  function renderHistory() {
    if (!history.length) return;
    if (chipsWrap) chipsWrap.hidden = true;

    history.forEach(msg => {
      appendMessageToDOM(msg.rol, msg.contenido, false);
    });
    scrollToBottom();
  }

  // Detectar si el usuario está en una página de ejercicio para capturar contexto
  function detectPageContext() {
    const editor = document.getElementById('python-code') as HTMLTextAreaElement | null;
    const titleEl = document.querySelector('h1#exercise-title, .title-row h1, .catalog-header h1');
    const title = titleEl ? titleEl.textContent?.trim() : '';

    if (editor && title) {
      contextBanner.removeAttribute('hidden');
      contextBanner.classList.add('is-active');
      contextTitle.textContent = title;
      return {
        tema: title,
        codigo_actual: editor.value.slice(0, 800),
      };
    } else {
      contextBanner.setAttribute('hidden', '');
      contextBanner.classList.remove('is-active');
      return null;
    }
  }

  // Control estricto del estado de escritura (pensando)
  function setTyping(active: boolean) {
    if (active) {
      typingIndicator.removeAttribute('hidden');
      typingIndicator.classList.add('is-active');
      scrollToBottom();
    } else {
      typingIndicator.setAttribute('hidden', '');
      typingIndicator.classList.remove('is-active');
    }
  }

  // Alternar apertura y cierre del panel (con clases y atributos para máxima compatibilidad)
  function togglePanel(open?: boolean) {
    const isCurrentlyOpen = panel.classList.contains('is-open');
    const shouldOpen = open !== undefined ? open : !isCurrentlyOpen;

    if (shouldOpen) {
      panel.removeAttribute('hidden');
      panel.classList.add('is-open');
      triggerBtn.classList.add('is-open');
      triggerBtn.setAttribute('aria-expanded', 'true');
      detectPageContext();
      scrollToBottom();
      setTimeout(() => chatInput.focus(), 120);
    } else {
      panel.setAttribute('hidden', '');
      panel.classList.remove('is-open');
      triggerBtn.classList.remove('is-open');
      triggerBtn.setAttribute('aria-expanded', 'false');
    }
  }

  // Eventos de botones abrir/cerrar/minimizar
  triggerBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    togglePanel();
  });

  if (minimizeBtn) {
    minimizeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      togglePanel(false);
    });
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      togglePanel(false);
    });
  }

  // Cerrar con tecla Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel.classList.contains('is-open')) {
      togglePanel(false);
    }
  });

  // Limpiar conversación
  if (clearBtn) {
    clearBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      history = [];
      localStorage.removeItem(STORAGE_KEY);
      messagesContainer.innerHTML = `
        <div class="msg-row bot-row">
          <div class="msg-bubble bot-bubble">
            <p>¡Conversación reiniciada! 🔄 ¿En qué tema o ejercicio de Python te gustaría que nos enfoquemos ahora? 🐍</p>
          </div>
        </div>
      `;
      if (chipsWrap) {
        messagesContainer.appendChild(chipsWrap);
        chipsWrap.hidden = false;
      }
    });
  }

  // Chips de preguntas rápidas
  document.querySelectorAll<HTMLButtonElement>('.quick-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const prompt = chip.dataset.prompt;
      if (prompt) {
        enviarMensaje(prompt);
      }
    });
  });

  // Habilitar / deshabilitar botón de enviar según contenido
  chatInput.addEventListener('input', () => {
    sendBtn.disabled = !chatInput.value.trim();
    chatInput.style.height = 'auto';
    chatInput.style.height = `${Math.min(chatInput.scrollHeight, 100)}px`;
  });

  // Enviar con Enter (sin Shift)
  chatInput.addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      if (!sendBtn.disabled) {
        chatForm.dispatchEvent(new Event('submit'));
      }
    }
  });

  // Envío del formulario
  chatForm.addEventListener('submit', e => {
    e.preventDefault();
    const texto = chatInput.value.trim();
    if (!texto) return;

    chatInput.value = '';
    chatInput.style.height = 'auto';
    sendBtn.disabled = true;

    enviarMensaje(texto);
  });

  // Función principal para enviar y recibir con soporte SSE Streaming
  async function enviarMensaje(texto: string) {
    if (chipsWrap) chipsWrap.hidden = true;

    // Agregar mensaje del usuario al DOM y al historial
    appendMessageToDOM('user', texto, true);
    history.push({ rol: 'user', contenido: texto });
    saveHistory();
    scrollToBottom();

    // Activar loader de escritura mientras esperamos el primer token
    setTyping(true);

    try {
      const contexto = detectPageContext();

      const response = await fetch('/api/ai/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'text/event-stream',
        },
        body: JSON.stringify({
          mensaje: texto,
          historial: history.slice(-6),
          contexto: contexto || {},
          stream: true,
        }),
      });

      if (!response.ok) {
        throw new Error(`Error en servidor (${response.status})`);
      }

      const contentType = response.headers.get('content-type') || '';

      if (contentType.includes('text/event-stream') && response.body) {
        // Modo Streaming palabra por palabra en tiempo real
        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let sseBuffer = '';
        let fullBotReply = '';

        // Crear la fila y burbuja del bot
        const row = document.createElement('div');
        row.className = 'msg-row bot-row animate-in';
        const bubble = document.createElement('div');
        bubble.className = 'msg-bubble bot-bubble';
        row.appendChild(bubble);

        let attached = false;

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          sseBuffer += decoder.decode(value, { stream: true });
          const lines = sseBuffer.split('\n');
          sseBuffer = lines.pop() ?? '';

          for (const line of lines) {
            const trimmed = line.trim();
            if (!trimmed.startsWith('data:')) continue;
            const dataStr = trimmed.slice(5).trim();
            if (!dataStr) continue;

            if (dataStr === '[DONE]') {
              break;
            }

            try {
              const parsed = JSON.parse(dataStr);
              if (parsed.token) {
                if (!attached) {
                  setTyping(false);
                  messagesContainer.appendChild(row);
                  attached = true;
                }
                fullBotReply += parsed.token;
                bubble.innerHTML = formatMarkdown(fullBotReply) + '<span class="chat-cursor"></span>';
                scrollToBottom();
              }
            } catch {}
          }
        }

        // Finalizar streaming: quitar cursor y guardar en historial
        if (!attached && fullBotReply) {
          setTyping(false);
          messagesContainer.appendChild(row);
        }
        bubble.innerHTML = formatMarkdown(fullBotReply || '¡Listo! 🚀');
        history.push({ rol: 'bot', contenido: fullBotReply || '¡Listo! 🚀' });
        saveHistory();
      } else {
        // Fallback estándar JSON
        const data = await response.json();
        const respuestaBot = data.respuesta || (data.success ? '¡Listo! 🚀' : 'Ocurrió un error al procesar tu consulta.');
        setTyping(false);
        appendMessageToDOM('bot', respuestaBot, true);
        history.push({ rol: 'bot', contenido: respuestaBot });
        saveHistory();
      }
    } catch (err: any) {
      setTyping(false);
      const errorMsg = 'No pude conectar con PyBot en este momento. Verifica tu conexión e inténtalo nuevamente. ⚠️';
      appendMessageToDOM('bot', errorMsg, false);
    } finally {
      setTyping(false);
      scrollToBottom();
    }
  }

  // Parseador ligero de Markdown seguro
  function formatMarkdown(text: string): string {
    let html = text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/```(?:python)?\s*([\s\S]*?)```/g, '<pre class="chat-code-block"><code>$1</code></pre>')
      .replace(/`([^`]+)`/g, '<code class="chat-inline-code">$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/\n\n/g, '</p><p>')
      .replace(/\n/g, '<br />');

    return `<p>${html}</p>`;
  }

  function appendMessageToDOM(rol: 'user' | 'bot', texto: string, animate: boolean) {
    const row = document.createElement('div');
    row.className = `msg-row ${rol}-row ${animate ? 'animate-in' : ''}`;

    const bubble = document.createElement('div');
    bubble.className = `msg-bubble ${rol}-bubble`;

    if (rol === 'bot') {
      bubble.innerHTML = formatMarkdown(texto);
    } else {
      bubble.textContent = texto;
    }

    row.appendChild(bubble);
    messagesContainer.appendChild(row);
  }

  function scrollToBottom() {
    requestAnimationFrame(() => {
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    });
  }

  function saveHistory() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(history.slice(-12)));
    } catch {
      // Ignorar fallback
    }
  }

  // Inicialización segura: asegurar cerrado y loader inactivo al cargar
  setTyping(false);
  togglePanel(false);
  renderHistory();
</script>

<style>
  /* =========================================================================
     ESTILOS DEL BOTÓN FLOTANTE Y PANEL DE CHAT PYBOT (100% SOBRIO, SIN EMOJIS)
     ========================================================================= */

  .pybot-widget-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Botón circular flotante */
  .pybot-floating-circle {
    position: relative;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: linear-gradient(135deg, #1e3a5f 0%, #0d1e33 100%);
    border: 1.5px solid rgba(56, 189, 248, 0.45);
    color: #38bdf8;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45), 0 0 16px rgba(56, 189, 248, 0.2);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease, border-color 0.2s ease;
    outline: none;
  }

  .pybot-floating-circle:hover {
    transform: scale(1.08);
    border-color: #38bdf8;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5), 0 0 24px rgba(56, 189, 248, 0.35);
  }

  .circle-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease;
  }

  .close-icon {
    display: none;
  }

  .pybot-floating-circle.is-open .bot-icon {
    display: none;
  }

  .pybot-floating-circle.is-open .close-icon {
    display: block;
    color: #f1f5f9;
  }

  .online-indicator-dot {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 11px;
    height: 11px;
    background: #10b981;
    border: 2px solid #0B1120;
    border-radius: 50%;
  }

  /* Halo sutil de pulsación */
  .circle-halo {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid rgba(56, 189, 248, 0.25);
    pointer-events: none;
    animation: halo-pulse 3s infinite ease-out;
  }

  @keyframes halo-pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.15); opacity: 0; }
    100% { transform: scale(0.95); opacity: 0; }
  }

  /* Forzar que cualquier elemento con atributo hidden permanezca oculto */
  [hidden] {
    display: none !important;
  }

  /* Panel de chat flotante */
  .pybot-panel {
    position: fixed;
    bottom: 94px;
    right: 24px;
    width: 380px;
    max-width: calc(100vw - 36px);
    height: 530px;
    max-height: calc(100vh - 120px);
    background: #0B1120;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 1px rgba(255, 255, 255, 0.15);
    display: none; /* Oculto por defecto */
    flex-direction: column;
    overflow: hidden;
  }

  .pybot-panel.is-open {
    display: flex;
    animation: slide-up-fade 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pybot-panel[hidden] {
    display: none !important;
  }

  @keyframes slide-up-fade {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Header */
  .panel-header {
    background: #0e172a;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-profile {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .avatar-bubble {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    display: grid;
    place-items: center;
  }

  .header-text {
    display: flex;
    flex-direction: column;
  }

  .bot-name {
    font-size: 14px;
    font-weight: 700;
    color: #f8fafc;
    margin: 0;
    line-height: 1.2;
  }

  .bot-status {
    font-size: 11px;
    color: #94a3b8;
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .header-action-btn {
    background: transparent;
    border: none;
    color: #64748b;
    padding: 6px;
    border-radius: 6px;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .header-action-btn:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.06);
  }

  /* Banner de contexto de ejercicio */
  .context-banner {
    background: rgba(56, 189, 248, 0.08);
    border-bottom: 1px solid rgba(56, 189, 248, 0.15);
    padding: 6px 16px;
    font-size: 11px;
    color: #94a3b8;
    display: none;
    gap: 6px;
    align-items: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .context-banner.is-active {
    display: flex;
  }

  .context-tag {
    color: #38bdf8;
    font-weight: 600;
  }

  .context-name {
    color: #cbd5e1;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Área de mensajes */
  .messages-container {
    flex: 1;
