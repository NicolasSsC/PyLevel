---
// PyLevel brand and particle animation, used only for the preload phase.
---

<div id="pylevel-preload" class="pylevel-preload-overlay" hidden role="dialog" aria-modal="true" aria-label="Precarga de PyLevel">
  <!-- Fondo con degradado radial y destellos de particulas -->
  <canvas id="preload-canvas" class="preload-canvas"></canvas>

  <!-- Resplandor central detras del logo -->
  <div id="preload-radial-glow" class="preload-radial-glow" aria-hidden="true"></div>

  <!-- Contenedor del logotipo oficial + marca + subtitulo -->
  <div id="preload-stage" class="preload-stage">
    <div class="logo-wrapper">
      <img
        id="preload-svg-logo"
        class="preload-svg-logo"
        src="/pylevel-logo.svg"
        alt=""
        width="1000"
        height="1000"
        decoding="async"
        aria-hidden="true"
      />
    </div>

    <!-- Marca y Subtitulo tecnico de la plataforma -->
    <div id="preload-brand-group" class="preload-brand-group">
      <p class="preload-subtitle">
        Evaluaci&oacute;n de Competencias en Ingenier&iacute;a de Software &middot; Python
      </p>
      <div class="preload-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span class="badge-text">Entorno de Pr&aacute;ctica y Evaluaci&oacute;n T&eacute;cnica</span>
      </div>
    </div>
  </div>

  <!-- Boton de salto discreto -->
  <button
    id="preload-skip-btn"
    class="preload-skip-btn"
    type="button"
    aria-label="Saltar precarga (Esc)"
    title="Saltar animacion (Esc)"
  >
    <span>Saltar precarga</span>
    <span class="skip-arrow" aria-hidden="true">&rarr;</span>
  </button>
</div>

<style>
  .pylevel-preload-overlay[hidden] { display: none; }
  .pylevel-preload-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: radial-gradient(ellipse at 50% 48%, #132b3e 0%, #0b1120 72%, #060913 100%);
    opacity: 1;
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: all;
    user-select: none;
    overflow: hidden;
  }

  .pylevel-preload-overlay.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  .pylevel-preload-overlay.hidden-complete {
    display: none !important;
  }

  .preload-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .preload-radial-glow {
    position: absolute;
    width: clamp(260px, 45vw, 480px);
    height: clamp(260px, 45vw, 480px);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(55, 118, 171, 0.35) 0%,
      rgba(255, 212, 59, 0.18) 38%,
      rgba(11, 17, 32, 0) 70%
    );
    filter: blur(28px);
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 1s ease-out, transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .preload-radial-glow.visible {
    opacity: 1;
    transform: scale(1.15);
  }

  .preload-stage {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.5rem;
    padding: 1rem;
    max-width: 90vw;
  }

  .logo-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .preload-svg-logo {
    width: clamp(180px, 24vw, 240px);
    height: auto;
    opacity: 0;
    transform: scale(0.88);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 0 16px rgba(55, 118, 171, 0.45));
  }

  .preload-svg-logo.materialized {
    opacity: 1;
    transform: scale(1);
  }

  .preload-svg-logo.pulse {
    animation: logoBreathe 1.8s ease-in-out infinite alternate;
  }

  @keyframes logoBreathe {
    0% {
      filter: drop-shadow(0 0 14px rgba(55, 118, 171, 0.5))
              drop-shadow(0 0 20px rgba(255, 212, 59, 0.25));
      transform: scale(1);
    }
    100% {
      filter: drop-shadow(0 0 26px rgba(55, 118, 171, 0.85))
              drop-shadow(0 0 32px rgba(255, 212, 59, 0.55));
      transform: scale(1.03);
    }
  }

  .preload-brand-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s ease-out, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .preload-brand-group.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .preload-subtitle {
    margin: 0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(0.75rem, 1.6vw, 0.95rem);
    font-weight: 500;
    color: #94a3b8;
    letter-spacing: 0.03em;
    max-width: 44ch;
    line-height: 1.4;
  }

  .preload-badge {
    margin-top: 0.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: rgba(55, 118, 171, 0.12);
    border: 1px solid rgba(55, 118, 171, 0.35);
    font-family: 'Fira Code', monospace;
    font-size: 0.7rem;
    color: #cbd5e1;
    letter-spacing: 0.05em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
    animation: blinkDot 1.4s ease-in-out infinite;
  }

  @keyframes blinkDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .preload-skip-btn {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(148, 163, 184, 0.25);
    color: #94a3b8;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .preload-skip-btn:hover {
    color: #f1f5f9;
    border-color: rgba(96, 165, 250, 0.6);
    background: rgba(30, 41, 59, 0.85);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  .skip-arrow {
    font-size: 0.9rem;
    transition: transform 0.2s ease;
  }

  .preload-skip-btn:hover .skip-arrow {
    transform: translateX(3px);
  }

  .preload-skip-btn:focus-visible { outline: 3px solid #85c4ef; outline-offset: 5px; }

  /* Reduccion de movimiento para accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .pylevel-preload-overlay {
      transition: opacity 0.4s ease;
    }
    .preload-svg-logo.pulse {
      animation: none;
    }
    .badge-dot {
      animation: none;
    }
    .snake-path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>
