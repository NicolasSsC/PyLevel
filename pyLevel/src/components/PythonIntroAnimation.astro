---
// PythonIntroAnimation.astro
// Splash / Intro animada oficial para PyLevel (~5 segundos).
// - HTML5 Canvas 60 FPS con enjambre orbital y convergencia hacia el isotipo oficial de Python.
// - Geometria exacta del SVG oficial (dos serpientes simetricas + ojos circulares).
// - Trazo luminoso (stroke-dasharray), destello radial y efecto glow.
// - Marca "PyLevel" y subtitulo tecnico en plano final centrado con pulso luminoso.
// - Boton "Saltar intro ->" + tecla Escape.
// - Persistencia en sessionStorage ('pylevel_intro_seen'), anulable con ?intro=1.
// - Soporte estricto para prefers-reduced-motion: reduce.
---

<div id="pylevel-intro" class="pylevel-intro-overlay" hidden role="dialog" aria-modal="true" aria-label="Bienvenida a PyLevel">
  <!-- Fondo con degradado radial y destellos de particulas -->
  <canvas id="intro-canvas" class="intro-canvas"></canvas>

  <!-- Resplandor central detras del logo -->
  <div id="intro-radial-glow" class="intro-radial-glow" aria-hidden="true"></div>

  <!-- Contenedor del logotipo oficial + marca + subtitulo -->
  <div id="intro-stage" class="intro-stage">
    <div class="logo-wrapper">
      <svg
        id="intro-svg-logo"
        class="intro-svg-logo"
        viewBox="0 0 111 112"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="intro-blue-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#5a9fd4" />
            <stop offset="60%" stop-color="#3776ab" />
            <stop offset="100%" stop-color="#1f4b70" />
          </linearGradient>
          <linearGradient id="intro-yellow-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffe873" />
            <stop offset="50%" stop-color="#ffd43b" />
            <stop offset="100%" stop-color="#d4a317" />
          </linearGradient>

          <!-- Filtro de destello luminoso controlado -->
          <filter id="intro-glow" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <!-- Serpiente Azul (Superior-Izquierda) - Geometria Oficial PSF -->
        <path
          id="intro-snake-blue"
          class="snake-path snake-blue"
          fill="url(#intro-blue-grad)"
          stroke="#60a5fa"
          stroke-width="0.8"
          filter="url(#intro-glow)"
          d="M 54.918785,0.000919 C 50.335132,0.022217 45.957846,0.413137 42.106285,1.094669 C 30.760069,3.099173 28.700036,7.294771 28.700035,15.032169 v 10.21875 h 26.8125 v 3.40625 h -26.8125 -10.0625 c -7.792459,0 -14.6157588,4.683717 -16.7499998,13.59375 c -2.46181998,10.212966 -2.57101508,16.586023 0,27.25 c 1.9059283,7.937852 6.4575432,13.593748 14.2499998,13.59375 h 9.21875 v -12.25 c 0,-8.849902 7.657144,-16.656248 16.75,-16.65625 h 26.78125 c 7.454951,0 13.406253,-6.138164 13.40625,-13.625 v -25.53125 c 0,-7.2663386 -6.12998,-12.7247771 -13.40625,-13.9374997 C 64.281548,0.327944 59.502438,-0.020379 54.918785,0.000919 Z m -14.5,8.21875 c 2.769547,0 5.03125,2.298646 5.03125,5.124999 c -2e-6,2.816336 -2.261703,5.09375 -5.03125,5.09375 c -2.779476,-1e-6 -5.03125,-2.277415 -5.03125,-5.09375 c -10e-7,-2.826353 2.251774,-5.124999 5.03125,-5.124999 Z"
        />

        <!-- Serpiente Amarilla (Inferior-Derecha) - Geometria Oficial PSF -->
        <path
          id="intro-snake-yellow"
          class="snake-path snake-yellow"
          fill="url(#intro-yellow-grad)"
          stroke="#ffd43b"
          stroke-width="0.8"
          filter="url(#intro-glow)"
          d="M 85.637535,28.657169 v 11.90625 c 0,9.230755 -7.825895,16.999999 -16.75,17 h -26.78125 c -7.335833,0 -13.406249,6.278483 -13.40625,13.625 v 25.531247 c 0,7.266344 6.318588,11.540324 13.40625,13.625004 c 8.487331,2.49561 16.626237,2.94663 26.78125,0 c 6.750155,-1.95439 13.406253,-5.88761 13.40625,-13.625004 V 86.500919 h -26.78125 v -3.40625 h 26.78125 13.406254 c 7.792461,0 10.696251,-5.435408 13.406241,-13.59375 c 2.79933,-8.398886 2.68022,-16.475776 0,-27.25 c -1.92578,-7.757441 -5.60387,-13.59375 -13.406241,-13.59375 Z m -15.0625,64.65625 c 2.779478,3e-6 5.03125,2.277417 5.03125,5.093747 c -2e-6,2.826354 -2.251775,5.125004 -5.03125,5.125004 c -2.76955,0 -5.03125,-2.29865 -5.03125,-5.125004 c 2e-6,-2.81633 2.261697,-5.093747 5.03125,-5.093747 Z"
        />
      </svg>
    </div>

    <!-- Marca y Subtitulo tecnico de la plataforma -->
    <div id="intro-brand-group" class="intro-brand-group">
      <h1 class="intro-title">
        <span class="brand-py">Py</span><span class="brand-level">Level</span>
      </h1>
      <p class="intro-subtitle">
        Evaluaci&oacute;n de Competencias en Ingenier&iacute;a de Software &middot; Python
      </p>
      <div class="intro-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span class="badge-text">Entorno de Pr&aacute;ctica y Evaluaci&oacute;n T&eacute;cnica</span>
      </div>
    </div>
  </div>

  <!-- Boton de salto discreto -->
  <button
    id="intro-skip-btn"
    class="intro-skip-btn"
    type="button"
    aria-label="Saltar introduccion (Esc)"
    title="Saltar animacion (Esc)"
  >
    <span>Saltar intro</span>
    <span class="skip-arrow" aria-hidden="true">&rarr;</span>
  </button>
</div>

<style>
  .pylevel-intro-overlay[hidden] { display: none; }
  .pylevel-intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: radial-gradient(ellipse at 50% 48%, #132b3e 0%, #0b1120 72%, #060913 100%);
    opacity: 1;
    transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: all;
    user-select: none;
    overflow: hidden;
  }

  .pylevel-intro-overlay.fade-out {
    opacity: 0;
    pointer-events: none;
  }

  .pylevel-intro-overlay.hidden-complete {
    display: none !important;
  }

  .intro-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .intro-radial-glow {
    position: absolute;
    width: clamp(260px, 45vw, 480px);
    height: clamp(260px, 45vw, 480px);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(55, 118, 171, 0.35) 0%,
      rgba(255, 212, 59, 0.18) 38%,
      rgba(11, 17, 32, 0) 70%
    );
    filter: blur(28px);
    pointer-events: none;
    z-index: 2;
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 1s ease-out, transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .intro-radial-glow.visible {
    opacity: 1;
    transform: scale(1.15);
  }

  .intro-stage {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.5rem;
    padding: 1rem;
    max-width: 90vw;
  }

  .logo-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .intro-svg-logo {
    width: clamp(100px, 16vw, 150px);
    height: auto;
    opacity: 0;
    transform: scale(0.88);
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 0 16px rgba(55, 118, 171, 0.45));
  }

  .intro-svg-logo.materialized {
    opacity: 1;
    transform: scale(1);
  }

  .intro-svg-logo.pulse {
    animation: logoBreathe 1.8s ease-in-out infinite alternate;
  }

  @keyframes logoBreathe {
    0% {
      filter: drop-shadow(0 0 14px rgba(55, 118, 171, 0.5))
              drop-shadow(0 0 20px rgba(255, 212, 59, 0.25));
      transform: scale(1);
    }
    100% {
      filter: drop-shadow(0 0 26px rgba(55, 118, 171, 0.85))
              drop-shadow(0 0 32px rgba(255, 212, 59, 0.55));
      transform: scale(1.03);
    }
  }

  .snake-path {
    stroke-dasharray: 450;
    stroke-dashoffset: 450;
    transition: stroke-dashoffset 1.4s ease-out;
  }

  .intro-svg-logo.materialized .snake-path {
    stroke-dashoffset: 0;
  }

  .intro-brand-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s ease-out, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .intro-brand-group.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .intro-title {
    margin: 0;
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    font-size: clamp(2.2rem, 5.5vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .brand-py {
    color: #5a9fd4;
    text-shadow: 0 0 24px rgba(90, 159, 212, 0.5);
  }

  .brand-level {
    color: #ffd43b;
    text-shadow: 0 0 24px rgba(255, 212, 59, 0.45);
  }

  .intro-subtitle {
    margin: 0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(0.75rem, 1.6vw, 0.95rem);
    font-weight: 500;
    color: #94a3b8;
    letter-spacing: 0.03em;
    max-width: 44ch;
    line-height: 1.4;
  }

  .intro-badge {
    margin-top: 0.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: rgba(55, 118, 171, 0.12);
    border: 1px solid rgba(55, 118, 171, 0.35);
    font-family: 'Fira Code', monospace;
    font-size: 0.7rem;
    color: #cbd5e1;
    letter-spacing: 0.05em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 8px #38bdf8;
    animation: blinkDot 1.4s ease-in-out infinite;
  }

  @keyframes blinkDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .intro-skip-btn {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(15, 23, 42, 0.65);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(148, 163, 184, 0.25);
    color: #94a3b8;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .intro-skip-btn:hover {
    color: #f1f5f9;
    border-color: rgba(96, 165, 250, 0.6);
    background: rgba(30, 41, 59, 0.85);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }

  .skip-arrow {
    font-size: 0.9rem;
    transition: transform 0.2s ease;
  }

  .intro-skip-btn:hover .skip-arrow {
    transform: translateX(3px);
  }

  /* Reduccion de movimiento para accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .pylevel-intro-overlay {
      transition: opacity 0.4s ease;
    }
    .intro-svg-logo.pulse {
      animation: none;
    }
    .badge-dot {
      animation: none;
    }
    .snake-path {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>

<script>
(() => {
  const STORAGE_KEY = 'pylevel_intro_seen';
  const urlParams = new URLSearchParams(window.location.search);
  const forceIntro = urlParams.get('intro') === '1';

  // 1. Verificacion de sessionStorage (se salta si ya fue vista y no se fuerza con ?intro=1)
  let seen = false;
  try { seen = sessionStorage.getItem(STORAGE_KEY) === 'true'; } catch { /* Storage is optional. */ }
  if (!forceIntro && seen) {
    const overlay = document.getElementById('pylevel-intro');
    if (overlay) {
      overlay.classList.add('hidden-complete');
    }
    return;
  }

  const overlay    = document.getElementById('pylevel-intro');
  const canvas     = document.getElementById('intro-canvas') as HTMLCanvasElement | null;
  const glow       = document.getElementById('intro-radial-glow');
  const svgLogo    = document.getElementById('intro-svg-logo');
  const brandGroup = document.getElementById('intro-brand-group');
  const skipBtn    = document.getElementById('intro-skip-btn');

  if (!overlay || !canvas || !svgLogo || !brandGroup) return;

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const previousFocus = document.activeElement;
  const background = [document.getElementById('python-home'), document.getElementById('top-navbar')].filter((node): node is HTMLElement => !!node);
  const previousInert = background.map(node => node.inert);
  background.forEach(node => { node.inert = true; });
  overlay.hidden = false;
  skipBtn?.focus({ preventScroll: true });

  // Bloquear scroll de la pagina durante la introduccion
  const previousOverflow = document.body.style.overflow;
  document.body.style.overflow = 'hidden';

  let hasEnded = false;

  const finishIntro = () => {
    if (hasEnded) return;
    hasEnded = true;

    try { sessionStorage.setItem(STORAGE_KEY, 'true'); } catch { /* Finish even when storage is disabled. */ }
    overlay.classList.add('fade-out');

    window.removeEventListener('keydown', handleKey);
    window.removeEventListener('resize', resizeCanvas);

    setTimeout(() => {
      overlay.classList.add('hidden-complete');
      overlay.hidden = true;
      document.body.style.overflow = previousOverflow;
      background.forEach((node, i) => { node.inert = previousInert[i]; });
      if (previousFocus instanceof HTMLElement) previousFocus.focus({ preventScroll: true });
    }, 700);
  }

  function handleKey(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      finishIntro();
    }
  }

  window.addEventListener('keydown', handleKey);
  if (skipBtn) {
    skipBtn.addEventListener('click', finishIntro);
  }

  // Si el usuario tiene activo prefers-reduced-motion, saltar canvas y mostrar plano final con fade corto
  if (reducedMotion) {
    svgLogo.classList.add('materialized');
    brandGroup.classList.add('revealed');
    if (glow) glow.classList.add('visible');
    setTimeout(finishIntro, 1800);
    return;
  }

  // 2. Inicializacion del Canvas y Fisica de Particulas
  const ctx = canvas.getContext('2d');
  if (!ctx) {
    finishIntro();
    return;
  }

  function resizeCanvas() {
    if (!canvas) return;
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);

  // Muestreo denso de puntos de la silueta oficial de Python (coordenadas viewBox 0..111)
  // 36 puntos para la serpiente azul (mitad superior-izquierda)
  const BLUE_SNAKE_POINTS: [number, number][] = [
    [54.9, 0.0], [48.0, 0.2], [42.1, 1.1], [35.0, 3.5], [30.0, 8.0],
    [28.7, 15.0], [28.7, 20.0], [28.7, 25.2], [38.0, 25.2], [48.0, 25.2],
    [55.5, 25.2], [55.5, 28.6], [42.0, 28.6], [28.7, 28.6], [18.6, 28.6],
    [10.0, 32.0], [4.0, 37.0], [1.5, 43.0], [0.0, 52.0], [0.0, 62.0],
    [2.0, 69.2], [6.5, 76.0], [14.2, 82.8], [20.0, 82.8], [26.7, 82.8],
    [26.7, 76.0], [26.7, 70.6], [32.0, 64.0], [38.0, 58.0], [43.5, 53.9],
    [55.0, 53.9], [65.0, 53.9], [70.3, 53.9], [78.0, 48.0], [83.7, 40.3],
    [40.4, 13.3] // Ojo azul
  ];

  // 36 puntos para la serpiente amarilla (mitad inferior-derecha)
  const YELLOW_SNAKE_POINTS: [number, number][] = [
    [85.6, 28.7], [85.6, 35.0], [85.6, 40.6], [78.0, 48.0], [70.0, 55.0],
    [68.9, 57.6], [58.0, 57.6], [48.0, 57.6], [42.1, 57.6], [35.0, 62.0],
    [28.7, 71.2], [28.7, 80.0], [28.7, 90.0], [28.7, 96.7], [35.0, 104.0],
    [42.1, 110.3], [52.0, 110.3], [62.0, 110.3], [68.9, 110.3], [76.0, 105.0],
    [82.3, 96.7], [82.3, 90.0], [82.3, 86.5], [68.0, 86.5], [55.5, 86.5],
    [55.5, 83.1], [70.0, 83.1], [82.3, 83.1], [92.0, 83.1], [95.7, 83.1],
    [103.0, 78.0], [109.1, 69.5], [111.0, 58.0], [109.1, 42.3], [102.0, 33.0],
    [70.6, 97.9] // Ojo amarillo
  ];

  interface IntroParticle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    radius: number;
    alpha: number;
    color: string;
    accentColor: string;
    targetSvgX: number;
    targetSvgY: number;
    orbitAngle: number;
    orbitRadius: number;
    orbitSpeed: number;
    initialDistance: number;
  }

  const PARTICLES_PER_SNAKE = 130;

  function createParticles(
    points: [number, number][],
    baseColor: string,
    accentColor: string,
    spawnOriginX: number,
    spawnOriginY: number
  ): IntroParticle[] {
    const list: IntroParticle[] = [];
    for (let i = 0; i < PARTICLES_PER_SNAKE; i++) {
      const pt = points[i % points.length];
      const dist = Math.random() * 260 + 120;
      const angle = Math.random() * Math.PI * 2;
      list.push({
        x: spawnOriginX + Math.cos(angle) * dist,
        y: spawnOriginY + Math.sin(angle) * dist,
        vx: (Math.random() - 0.5) * 1.5,
        vy: (Math.random() - 0.5) * 1.5,
        radius: Math.random() * 2.2 + 0.8,
        alpha: Math.random() * 0.6 + 0.4,
        color: baseColor,
        accentColor,
        targetSvgX: pt[0],
        targetSvgY: pt[1],
        orbitAngle: angle,
        orbitRadius: dist,
        orbitSpeed: (Math.random() * 0.012 + 0.006) * (Math.random() < 0.5 ? 1 : -1),
        initialDistance: dist
      });
    }
    return list;
  }

  let blueSwarm: IntroParticle[]   = [];
  let yellowSwarm: IntroParticle[] = [];

  function setupSwarms() {
    if (!canvas) return;
    const w = canvas.width;
    const h = canvas.height;
    // Enjambre azul: nace hacia arriba a la izquierda
    blueSwarm = createParticles(BLUE_SNAKE_POINTS, '#3776ab', '#60a5fa', w * 0.22, h * 0.26);
    // Enjambre amarillo: nace hacia abajo a la derecha
    yellowSwarm = createParticles(YELLOW_SNAKE_POINTS, '#ffd43b', '#fde047', w * 0.78, h * 0.74);
  }
  setupSwarms();

  // Calcular la transformacion viewBox -> coordenadas de pantalla del SVG
  function getSvgMatrix() {
    if (!svgLogo || !canvas) return { ox: 0, oy: 0, scale: 1 };
    const rect = svgLogo.getBoundingClientRect();
    return {
      ox: rect.left,
      oy: rect.top,
      scale: rect.width / 111
    };
  }

  // Cronometria precisa (~5.0 segundos en total)
  const START_TIME        = performance.now();
  const T_ORBIT_PHASE     = 1800; // 0.0s - 1.8s: fisica orbital fluida
  const T_CONVERGE_END    = 3000; // 1.8s - 3.0s: atraccion hacia la silueta oficial
  const T_MATERIALIZE_SVG = 2800; // 2.8s: inicio de crossfade con SVG oficial y stroke
  const T_STAGE_REVEAL    = 3800; // 3.8s: marca "PyLevel" y subtitulo se revelan
  const T_PULSE_START     = 4200; // 4.2s - 5.0s: pulso luminoso centrado
  const T_AUTO_FINISH     = 5000; // 5.0s: inicio del fade-out automatico

  function easeInOutCubic(t: number): number {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  const render = (now: number) => {
    if (hasEnded) return;
    const elapsed = now - START_TIME;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const matrix = getSvgMatrix();

    // Fraccion de convergencia de particulas
    const convergeRaw = elapsed < T_ORBIT_PHASE
      ? 0
      : Math.min((elapsed - T_ORBIT_PHASE) / (T_CONVERGE_END - T_ORBIT_PHASE), 1);
    const convergeEased = easeInOutCubic(convergeRaw);

    // Desvanecimiento paulatino de particulas a medida que el SVG se materializa
    const particleOpacity = elapsed < T_MATERIALIZE_SVG
      ? 1
      : Math.max(0, 1 - (elapsed - T_MATERIALIZE_SVG) / 1000);

    // Dibujar enjambre
    const drawSwarm = (swarm: IntroParticle[]) => {
      for (let i = 0; i < swarm.length; i++) {
        const p = swarm[i];
        p.orbitAngle += p.orbitSpeed;

        // Trayectoria orbital con amortiguacion
        const currentOrbitR = p.initialDistance * (1 - convergeEased * 0.88);
        const orbX = p.x + Math.cos(p.orbitAngle) * currentOrbitR * 0.4;
        const orbY = p.y + Math.sin(p.orbitAngle) * currentOrbitR * 0.4;

        // Posicion objetivo en el logo oficial
        const targetX = matrix.ox + p.targetSvgX * matrix.scale;
        const targetY = matrix.oy + p.targetSvgY * matrix.scale;

        // Interpolacion suave
        const drawX = orbX + (targetX - orbX) * convergeEased;
        const drawY = orbY + (targetY - orbY) * convergeEased;

        const effectiveAlpha = p.alpha * particleOpacity;
        if (effectiveAlpha <= 0.01) continue;

        // Halo luminoso
        const glowRadius = p.radius * 4;
        const grad = ctx.createRadialGradient(drawX, drawY, 0, drawX, drawY, glowRadius);
        grad.addColorStop(0, p.accentColor);
        grad.addColorStop(1, 'transparent');

        ctx.save();
        ctx.globalAlpha = effectiveAlpha * 0.65;
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(drawX, drawY, glowRadius, 0, Math.PI * 2);
        ctx.fill();

        // Nucleo de la particula
        ctx.globalAlpha = effectiveAlpha;
        ctx.fillStyle = p.accentColor;
        ctx.beginPath();
        ctx.arc(drawX, drawY, p.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    }

    if (particleOpacity > 0) {
      drawSwarm(blueSwarm);
      drawSwarm(yellowSwarm);
    }

    // 3. Fases temporales del logotipo y tipografia
    if (elapsed >= T_MATERIALIZE_SVG && !svgLogo.classList.contains('materialized')) {
      svgLogo.classList.add('materialized');
      if (glow) glow.classList.add('visible');
    }

    if (elapsed >= T_STAGE_REVEAL && !brandGroup.classList.contains('revealed')) {
      brandGroup.classList.add('revealed');
    }

    if (elapsed >= T_PULSE_START && !svgLogo.classList.contains('pulse')) {
      svgLogo.classList.add('pulse');
    }

    // 4. Finalizacion automatica al cumplir los ~5 segundos
    if (elapsed >= T_AUTO_FINISH) {
      finishIntro();
      return;
    }

    requestAnimationFrame(render);
  }

  requestAnimationFrame(render);
})();
</script>
