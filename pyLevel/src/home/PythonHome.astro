</main>

<script>
  import { initHome } from './scroll';
  initHome();

  const replayLink = document.getElementById('replay-intro-link');
  if (replayLink) {
    replayLink.addEventListener('click', (e) => {
      try { sessionStorage.removeItem('pylevel_intro_seen'); } catch { /* The URL still forces replay. */ }
      if (window.location.search.includes('intro=1')) {
        e.preventDefault();
        window.location.reload();
      }
    });
  }

  // Navegación entre pantallas de PyLevel
  const homePage = document.querySelector<HTMLElement>('.home-page');

  if (homePage) {
    const screenSections = [...homePage.querySelectorAll<HTMLElement>('[data-screen]')];
    const storyCards = [...homePage.querySelectorAll<HTMLElement>('.use-story')];
    const screenLinks = [...homePage.querySelectorAll<HTMLAnchorElement>('[data-screen-target]')];

    function showScreen(screen: string) {
      const isTopic = storyCards.some(card => card.id === screen);
      const currentScreen = isTopic ? 'temas' : screen;

      if (!['inicio', 'aprender', 'temas', 'final'].includes(currentScreen)) return;

      homePage?.classList.toggle('screen-topic', isTopic);

      screenSections.forEach(section => {
        section.classList.toggle('screen-hidden', section.dataset.screen !== currentScreen);
      });

      storyCards.forEach(card => {
        card.classList.toggle('screen-selected', card.id === screen);
      });

      screenLinks.forEach(link => {
        const active = link.dataset.screenTarget === screen;
        if (active) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });

      window.scrollTo({ top: 0, behavior: 'auto' });
    }

    homePage.addEventListener('click', event => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const link = target.closest<HTMLAnchorElement>('[data-screen-target]');
      if (!link || !homePage.contains(link)) return;

      event.preventDefault();
      const screen = link.dataset.screenTarget;
      if (!screen) return;

      showScreen(screen);
      history.replaceState(null, '', screen === 'inicio' ? location.pathname : `#${screen}`);
    });

    showScreen('inicio');
  }

</script>

<style>
  .home-page { --home-blue: #3179b6; --home-yellow: #d5a815; --home-soft: #7d919f; --hero-drift: 0px; overflow: clip; background: var(--color-bg); color: var(--color-text-primary); }
  :global(html[data-theme='dark']) .home-page { --home-blue: #71b9ee; --home-yellow: #ffd343; --home-soft: #6d879e; }
  .home-container {
  width: min(1500px, calc(100% - 100px));
  margin-inline: auto;
}
