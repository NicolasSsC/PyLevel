  /* Refinamiento visual PyLevel */
  .home-hero {
    isolation: isolate;
    background:
      radial-gradient(ellipse at 82% 44%, color-mix(in srgb, var(--home-blue) 10%, transparent), transparent 38%),
      radial-gradient(ellipse at 8% 8%, color-mix(in srgb, var(--home-yellow) 7%, transparent), transparent 32%);
  }

  .hero-copy h1 {
    text-wrap: balance;
    text-shadow: 0 3px 24px color-mix(in srgb, var(--home-blue) 9%, transparent);
  }

  .home-button,
  .hero-intro-link {
    box-shadow: 0 5px 18px color-mix(in srgb, var(--home-blue) 9%, transparent);
  }

  .possibility-strip {
    backdrop-filter: blur(12px);
  }

  .home-why {
    position: relative;
  }

  .why-code {
    box-shadow: 0 22px 55px #10213318;
    transition: transform .25s ease, box-shadow .25s ease;
  }

  .why-code:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 60px #10213325;
  }

  .reason {
    padding: 22px 16px;
    border: 1px solid transparent;
    border-bottom-color: var(--color-border);
    border-radius: 9px;
    transition: background .2s ease, border-color .2s ease, transform .2s ease;
  }

  .reason:hover {
    background: color-mix(in srgb, var(--color-surface) 75%, transparent);
    border-color: color-mix(in srgb, var(--home-blue) 22%, transparent);
    transform: translateX(4px);
  }

  .use-story {
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-surface) 42%, transparent);
    box-shadow: 0 12px 35px #10213308;
    transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
  }

  .use-story:hover {
    border-color: color-mix(in srgb, var(--home-blue) 42%, var(--color-border));
    box-shadow: 0 18px 42px #10213312;
    transform: translateY(-3px);
  }

  .story-copy h3 {
    text-wrap: balance;
  }

  .story-tags > li {
    background: color-mix(in srgb, var(--color-surface) 75%, transparent);
    transition: border-color .2s ease, color .2s ease;
  }

  .story-tags > li:hover {
    border-color: var(--home-blue);
    color: var(--home-blue);
  }

  .home-finale {
    background:
      radial-gradient(ellipse at 50% 0%, #337eac55, transparent 60%),
      #132d45;
  }

  @media (max-width: 760px) {
    .reason:hover,
    .use-story:hover {
      transform: none;
    }

    .use-story {
      padding: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .why-code,
    .reason,
    .use-story,
    .story-tags > li {
      transition: none;
    }
  }


  
/* Menú lateral futurista PyLevel */
.home-page {
  margin-left: 220px;
}

.home-side-menu {
  --menu-navy: #101d30;
  --menu-blue: #2563eb;
  --menu-yellow: #facc15;
  --menu-gray: #aab6c7;

  position: fixed;
  z-index: 80;
  top: calc(var(--nav-height) + 18px);
  bottom: 18px;
  left: 30px;
  width: 190px;
  padding: 24px 13px 17px;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(ellipse at 0% 0%, #2563eb30, transparent 45%),
    linear-gradient(160deg, #172942 0%, #101d30 58%, #0b1728 100%);
  border: 1px solid #ffffff18;
  border-radius: 10px;
  box-shadow: 0 18px 45px #101d3040, inset 0 1px #ffffff12;
  overflow: hidden;
}

.home-side-menu::before {
  content: "";
  position: absolute;
  inset: 0;
  padding: 2px;
  border-radius: 10px;
  background: linear-gradient(
    120deg,
    #2563eb,
    #facc15,
    #2563eb,
    #facc15
  );
  background-size: 300% 300%;
  animation: led-border 5s linear infinite;

  -webkit-mask:
    linear-gradient(#fff 0 0) content-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

@keyframes led-border {
  0% { background-position: 0% 50%; }
  100% { background-position: 300% 50%; }
}

.side-menu-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  margin: 0 auto 18px;
  padding: 0;
  text-decoration: none;
}

.python-brand-icon {
  width: 43px;
  height: 43px;
  filter: drop-shadow(0 0 8px #2563eb80)
          drop-shadow(0 0 5px #facc1580);
  transition: transform .3s ease, filter .3s ease;
}

.side-menu-brand:hover .python-brand-icon {
  transform: scale(1.12) rotate(-5deg);
  filter: drop-shadow(0 0 12px #2563eb)
          drop-shadow(0 0 9px #facc15);
}
.side-menu-caption {
  display: block;
  padding: 0 11px;
  color: #7f96b5;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 2px;
}

.home-side-menu nav {
  display: flex;
  flex-direction: column;
  gap: 7px;
  margin-top: 16px;
}

.home-side-menu nav a {
  position: relative;
  display: flex;
  align-items: center;
  gap: 11px;
  min-height: 43px;
  padding: 8px 10px;
  border: 1px solid transparent;
  border-radius: 10px;
  color: #c6d2e2;
  font-size: 11px;
  font-weight: 650;
  text-decoration: none;
  transition: background .2s ease, border-color .2s ease, color .2s ease;
}

.home-side-menu nav a:hover,
.home-side-menu nav a:focus-visible {
  background: #ffffff0d;
  border-color: #ffffff18;
  color: #ffffff;
}

.side-menu-icon {
  display: inline-flex;
  flex: 0 0 29px;
  width: 29px;
  height: 29px;
  align-items: center;
  justify-content: center;
  border: 1px solid #ffffff14;
  border-radius: 8px;
  background: #ffffff0c;
  color: #facc15;
  font-size: 11px;
  font-weight: 900;
}

.home-page .home-side-menu nav a[aria-current="page"] {
  background: linear-gradient(100deg, #2563eb40, #2563eb12);
  border-color: #3b82f680;
  color: #ffffff;
  box-shadow: inset 3px 0 #facc15, 0 4px 14px #00000018;
}

.home-page .home-side-menu nav a[aria-current="page"] .side-menu-icon {
  background: #facc15;
  border-color: #facc15;
  color: #101d30;
}

.side-menu-footer {
  display: block;
  margin-top: auto;
  padding: 15px 9px 3px;
  border-top: 1px solid #ffffff16;
  color: #8295ae;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

/* Pantallas medianas */
@media (max-width: 1050px) {
  .home-page {
    margin-left: 178px;
  }

  .home-side-menu {
    left: 10px;
    width: 150px;
    padding-inline: 9px;
  }

  .home-side-menu nav a {
    gap: 7px;
    padding-inline: 7px;
    font-size: 10px;
  }

  .side-menu-icon {
    flex-basis: 25px;
    width: 25px;
    height: 25px;
  }
}

/* Pantallas pequeñas */
@media (max-width: 760px) {
  .home-page {
    margin-left: 0;
  }

  .home-side-menu {
    position: sticky;
    top: var(--nav-height);
    bottom: auto;
    left: auto;
    width: 100%;
    height: auto;
    min-height: 62px;
    padding: 7px 10px;
    border-radius: 0;
    border-inline: 0;
    flex-direction: row;
    align-items: center;
    gap: 9px;
  }

  .side-menu-brand {
    padding: 5px;
    font-size: 16px;
  }

  .side-menu-caption,
  .side-menu-footer {
    display: none;
  }

  .home-side-menu nav {
    flex-direction: row;
    gap: 5px;
    margin: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .home-side-menu nav::-webkit-scrollbar {
    display: none;
  }

  .home-side-menu nav a {
    flex: 0 0 auto;
    min-height: 36px;
    padding: 5px 7px;
    gap: 5px;
    font-size: 9px;
    white-space: nowrap;
  }

  .side-menu-icon {
    flex-basis: 21px;
    width: 21px;
    height: 21px;
    font-size: 9px;
  }
}



  /* Vistas independientes del menú lateral */
  .home-page .screen-hidden { display: none !important; }
  .home-page.screen-topic .uses-sidebar { display: none; }
  .home-page.screen-topic .home-possibilities { display: block; min-height: 70vh; }
  .home-page.screen-topic .use-story { display: none; }
  .home-page.screen-topic .use-story.screen-selected {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 55px;
    min-height: 60vh;
    padding: 25px 0;
    margin: 0;
    border: 0;
  }
  .home-page.screen-topic .use-story.screen-selected .story-copy { margin-top: 0; }
  .home-page .home-side-menu a[aria-current="page"] {
    color: var(--home-blue);
    background: color-mix(in srgb, var(--home-blue) 9%, transparent);
  }
  @media(max-width:760px) {
    .home-page.screen-topic .use-story.screen-selected {
      grid-template-columns: 1fr;
      gap: 25px;
