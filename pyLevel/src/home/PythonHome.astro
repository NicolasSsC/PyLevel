---
import UseCaseVisual from './UseCaseVisual.astro';

const uses = [
  { id: 'inteligencia-artificial', kind: 'ai' as const, number: '01', nav: 'Inteligencia artificial', heading: 'Enséñale al código a', accent: 'ver posibilidades.', description: 'Reconocer una imagen, encontrar patrones o construir un asistente. Con Python puedes explorar el aprendizaje automático y dar forma a sistemas que aprenden de los datos.', tags: ['Modelos de IA', 'Visión por computador', 'Asistentes'], note: 'De los datos a nuevas ideas.', source: 'https://pytorch.org/', library: 'Explora PyTorch' },
  { id: 'robotica', kind: 'robot' as const, number: '02', nav: 'Programación de robots', heading: 'Dale movimiento a', accent: 'tus ideas.', description: 'Conecta sensores, programa acciones y lleva tus proyectos al mundo físico. Un pequeño experimento puede ser el comienzo de tu próximo robot.', tags: ['Sensores', 'Movimiento', 'Automatización'], note: 'Tu código también puede moverse.', source: 'https://micropython.org/', library: 'Explora MicroPython' },
  { id: 'analisis-de-datos', kind: 'data' as const, number: '03', nav: 'Análisis de datos', heading: 'Encuentra historias', accent: 'entre los números.', description: 'Organiza información, crea visualizaciones y descubre lo que antes no era evidente. Convierte una tabla de datos en una perspectiva que ayude a tomar decisiones.', tags: ['Análisis', 'Visualización', 'Patrones'], note: 'Menos suposiciones. Más descubrimientos.', source: 'https://pandas.pydata.org/', library: 'Explora pandas' },
  { id: 'desarrollo', kind: 'web' as const, number: '04', nav: 'Desarrollo de aplicaciones', heading: 'Construye algo que', accent: 'alguien pueda usar.', description: 'Crea el motor de una aplicación, conecta servicios con una API o automatiza esa tarea que repites cada día. Lleva una idea del cuaderno a un proyecto que funcione.', tags: ['Aplicaciones web', 'APIs', 'Herramientas'], note: 'De «¿y si…?» a «ya funciona».', source: 'https://www.djangoproject.com/', library: 'Explora Django' },
];
const reasons = [
  { number: '01', title: 'Se entiende al leerlo.', text: 'Una sintaxis clara te ayuda a concentrarte en la lógica y a expresar tus ideas con menos distracciones.' },
  { number: '02', title: 'Crece con tus ideas.', text: 'Empieza con una función. Sigue con un proyecto. Combina herramientas y encuentra tu propio camino.' },
  { number: '03', title: 'No empiezas de cero.', text: 'Su comunidad y sus bibliotecas te acompañan: hay recursos para aprender, experimentar y seguir construyendo.' },
];
---
<main class="home-page" id="python-home">
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <section class="home-hero home-container" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="home-eyebrow"><span class="tiny-spark" aria-hidden="true">✳</span> UN LENGUAJE. MUCHOS CAMINOS.</p>
      <h1 id="home-title">Tu próxima<br/>gran idea empieza<br/>con <span class="python-word">Python<span class="gold-period">.</span></span></h1>
      <p class="hero-description">De tu primera línea de código a eso que todavía estás imaginando. Descubre un lenguaje para aprender, experimentar y crear.</p>
      <div class="hero-actions"><a href="/ejercicios/" class="home-button primary">Empieza a crear <span aria-hidden="true">↗</span></a><a href="#posibilidades" class="hero-discover">Descubre las posibilidades <span aria-hidden="true">↓</span></a></div>
      <div class="hero-footnote"><span class="mini-line" aria-hidden="true"></span><span>No necesitas tenerlo todo claro.<br/>Solo curiosidad y una primera idea.</span></div>
    </div>
    <div class="hero-art" aria-label="Logo de Python, rodeado de ideas para crear">
      <div class="hero-halo halo-blue"></div><div class="hero-halo halo-yellow"></div>
      <div class="orbit-stage" aria-hidden="true"><div class="orbit orbit-outer"></div><div class="orbit orbit-inner"></div><div class="orbit-axis"></div><span class="orbit-dot dot-blue"></span><span class="orbit-dot dot-yellow"></span><span class="orbit-cross cross-top">+</span><span class="orbit-cross cross-bottom">+</span></div>
      <div class="python-logo-wrap"><img src="/python-logo.svg" class="python-logo" alt="Python" width="290" height="351" fetchpriority="high" decoding="async" /></div>
      <div class="hero-tag tag-ai" aria-hidden="true"><span class="tag-icon">✳</span> inteligencia artificial</div>
      <div class="hero-tag tag-data" aria-hidden="true"><span class="tag-icon">▥</span> datos que cuentan historias</div>
      <div class="hero-code" aria-hidden="true"><div class="code-tab"><span></span> primera_idea.py <i>Python 3</i></div><code><span class="code-purple">print</span>(<span class="code-yellow">"Hola, posibilidades."</span>)<span class="code-cursor"></span></code></div>
      <span class="art-coordinate" aria-hidden="true">IMAGINAR → PROGRAMAR → CREAR</span>
    </div>
    <a href="#por-que-python" class="scroll-cue"><span class="scroll-line" aria-hidden="true"></span> SIGUE EXPLORANDO <span aria-hidden="true">↓</span></a>
  </section>

  <div class="possibility-strip"><div class="home-container strip-content"><span>Una misma base.<br/><strong>Muchos futuros posibles.</strong></span><div class="strip-links">{uses.map(use => <a href={`#${use.id}`}><span class="strip-star" aria-hidden="true">✳</span>{use.kind === 'ai' ? 'Inteligencia artificial' : use.kind === 'robot' ? 'Robótica' : use.kind === 'data' ? 'Datos' : 'Desarrollo'}</a>)}</div></div></div>

  <section id="por-que-python" class="home-why home-container" aria-labelledby="why-title">
    <div class="why-intro" data-reveal>
      <p class="home-eyebrow"><span class="section-index">01 /</span> POR QUÉ PYTHON</p>
      <h2 id="why-title">Las grandes ideas<br/>también empiezan<br/><span class="text-soft">con algo sencillo.</span></h2>
      <p>Python es un lenguaje de programación de propósito general. Puedes usarlo para resolver un problema cotidiano o para explorar un campo completamente nuevo.</p>
      <a href="/ejercicios/clasicos/" class="home-text-link">Empieza por los fundamentos <span aria-hidden="true">↗</span></a>
    </div>
    <div class="why-right">
      <div class="why-code" data-reveal><div class="why-code-title"><span class="small-python" aria-hidden="true">Py</span><span>A veces, todo empieza así.</span><span aria-hidden="true">↗</span></div><pre aria-label="Ejemplo de Python: recorrer las ideas imaginar, aprender y crear"><code><span class="code-muted"># Dale una oportunidad a tus ideas.</span>
ideas = [<span class="code-yellow">"imaginar"</span>, <span class="code-yellow">"aprender"</span>, <span class="code-yellow">"crear"</span>]

<span class="code-purple">for</span> idea <span class="code-purple">in</span> ideas:
    <span class="code-blue">print</span>(idea)</code></pre><div class="why-code-output"><span aria-hidden="true">↳</span><span>imaginar</span><span>aprender</span><span class="output-highlight">crear</span></div></div>
      <div class="reasons">{reasons.map(reason => <article class="reason" data-reveal><span>{reason.number}</span><div><h3>{reason.title}</h3><p>{reason.text}</p></div></article>)}</div>
    </div>
  </section>

  <section id="posibilidades" class="home-possibilities home-container" aria-labelledby="uses-title">
    <div class="uses-sidebar">
      <p class="home-eyebrow"><span class="section-index">02 /</span> PARA QUÉ SIRVE PYTHON</p>
      <h2 id="uses-title">Una herramienta.<br/><span class="text-soft">Mucho por<br/>imaginar.</span></h2>
      <p>Elige lo que despierta tu curiosidad. El mismo lenguaje puede llevarte por caminos muy diferentes.</p>
      <nav class="chapter-nav" aria-label="Usos de Python">{uses.map((use, i) => <a href={`#${use.id}`} data-chapter={use.id} aria-current={i === 0 ? 'location' : undefined}><span>{use.number}</span>{use.nav}<span class="chapter-arrow" aria-hidden="true">↗</span></a>)}</nav>
      <span class="sidebar-note"><span aria-hidden="true">↳</span> Desliza. Encuentra tu siguiente idea.</span>
    </div>
    <div class="use-stories">{uses.map(use => <article class:list={['use-story', `story-${use.kind}`]} id={use.id} data-scene={use.id} aria-labelledby={`title-${use.kind}`}>
      <div class="story-illustration" data-reveal><UseCaseVisual kind={use.kind} /></div>
      <div class="story-copy" data-reveal><div class="story-kicker"><span>{use.number} / {use.nav.toUpperCase()}</span><span aria-hidden="true">↗</span></div><h3 id={`title-${use.kind}`}>{use.heading}<br/><span>{use.accent}</span></h3><p>{use.description}</p><ul class="story-tags" aria-label="Posibilidades">{use.tags.map(tag => <li>{tag}</li>)}</ul><div class="story-bottom"><span>{use.note}</span><a href={use.source} target="_blank" rel="noopener noreferrer">{use.library} <span aria-hidden="true">↗</span><span class="sr-only"> (abre en otra pestaña)</span></a></div></div>
    </article>)}</div>
  </section>

  <section class="home-finale" aria-labelledby="finale-title">
    <div class="finale-grid" aria-hidden="true"></div><div class="finale-glow" aria-hidden="true"></div>
    <div class="home-container finale-content" data-reveal><span class="finale-star" aria-hidden="true">✳</span><p class="home-eyebrow">EL SIGUIENTE PASO ES TUYO</p><h2 id="finale-title">Con Python, construye<br/>lo que <span>te imagines.</span></h2><p>Un robot. Una aplicación. Una idea que todavía no tiene nombre.<br/>Todo puede empezar con una primera línea.</p><a href="/ejercicios/" class="home-button yellow">Dale forma a tu primera idea <span aria-hidden="true">↗</span></a><span class="finale-signature" aria-hidden="true">tu_idea + Python = posibilidades</span></div>
  </section>
  <footer class="home-footer home-container"><a href="/" class="footer-brand" aria-label="PyLevel, inicio">Py<span>Level.</span></a><p>Aprende. Practica. Construye.</p><div><a href="/ejercicios/">Ejercicios</a><a href="https://www.python.org/" target="_blank" rel="noopener noreferrer">Python.org ↗<span class="sr-only"> (abre en otra pestaña)</span></a></div><small>Python y su logo son marcas de la Python Software Foundation.</small></footer>
</main>

<script>
  import { initHome } from './scroll';
  initHome();
</script>

<style>
  .home-page { --home-blue: #3179b6; --home-yellow: #d5a815; --home-soft: #7d919f; --hero-drift: 0px; overflow: clip; background: var(--color-bg); color: var(--color-text-primary); }
  :global(html[data-theme='dark']) .home-page { --home-blue: #71b9ee; --home-yellow: #ffd343; --home-soft: #6d879e; }
  .home-container { width: min(1200px, calc(100% - 80px)); margin-inline: auto; }
  .home-page :global([id]) { scroll-margin-top: 105px; }
  .home-page a { text-decoration: none; }.home-page a:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 6px; border-radius: 4px; }
  .home-page .home-eyebrow { display: flex; align-items: center; gap: 9px; font: 600 10px var(--font-mono); letter-spacing: 1.8px; color: var(--color-text-secondary); margin: 0 0 25px; }
  .tiny-spark { color: var(--home-yellow); font-size: 21px; line-height: 1; }.section-index { color: var(--home-blue); letter-spacing: .5px; margin-right: 7px; }
  .reading-progress { position: fixed; top: var(--nav-height); left: 0; right: 0; z-index: 90; height: 2px; pointer-events: none; }.reading-progress span { display: block; height: 100%; background: linear-gradient(90deg, #3776ab, #ffd343); transform-origin: left; transform: scaleX(var(--reading-progress, 0)); }
  .home-hero { min-height: min(790px, calc(100svh - 68px)); display: grid; grid-template-columns: 1.12fr 1fr; align-items: center; position: relative; padding-block: 74px 108px; gap: 20px; }
  .hero-copy { position: relative; z-index: 2; }.hero-copy h1 { font-size: clamp(42px, 4.8vw, 65px); font-weight: 700; line-height: 1.09; letter-spacing: -3px; margin: 0; }.python-word { color: var(--home-blue); }.gold-period { color: var(--home-yellow); }
  .hero-description { max-width: 430px; font-size: 15px; line-height: 1.85; color: var(--color-text-secondary); margin: 25px 0 28px; }.hero-actions { display: flex; align-items: center; gap: 26px; flex-wrap: wrap; }
  .home-button { display: inline-flex; align-items: center; justify-content: center; gap: 30px; padding: 16px 21px; font: 600 12px var(--font-sans); border-radius: 7px; transition: transform .2s ease, box-shadow .2s ease; }.home-button:hover { transform: translateY(-3px); box-shadow: 0 8px 24px #285d8e25; }.home-button.primary { color: white; background: #3776ab; border: 1px solid #568cb857; }.home-button > span { font-size: 18px; font-weight: 400; }.home-button.yellow { background: #ffd343; color: #172c40; border: 1px solid #ffe78a; }
  .hero-discover { color: var(--color-text-secondary); font-size: 11px; display: flex; gap: 12px; align-items: center; }.hero-discover:hover { color: var(--color-text-primary); }.hero-discover > span { color: var(--home-blue); font-size: 17px; }
  .hero-footnote { margin-top: 42px; display: flex; align-items: flex-start; gap: 11px; color: var(--color-text-secondary); font-size: 10px; line-height: 1.8; }.mini-line { display: block; width: 23px; height: 1px; background: var(--home-yellow); margin-top: 9px; }
  .hero-art { position: relative; height: 470px; display: grid; place-items: center; transform: translateY(calc(var(--hero-drift) * -.45)); }.hero-halo { position: absolute; width: 300px; height: 300px; pointer-events: none; filter: blur(55px); border-radius: 50%; opacity: .12; }.halo-blue { background: #1f8cd8; left: 5%; top: 0; }.halo-yellow { background: #ffd343; right: 0; bottom: 45px; opacity: .09; }
  .orbit-stage { position: absolute; inset: 20px -20px 20px; }.orbit { position: absolute; border: 1px solid color-mix(in srgb, var(--home-blue) 16%, transparent); border-radius: 50%; aspect-ratio: 1; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(-25deg); }.orbit-outer { width: 96%; border-style: dashed; }.orbit-inner { width: 72%; border-color: color-mix(in srgb, var(--home-blue) 12%, transparent); }.orbit-axis { position: absolute; width: 108%; height: 1px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--home-blue) 20%, transparent), transparent); left: -4%; top: 51%; transform: rotate(-28deg); }.orbit-dot { width: 7px; height: 7px; border-radius: 50%; position: absolute; }.dot-blue { background: #6caee0; left: 12%; top: 20%; box-shadow: 0 0 16px #6caee040; }.dot-yellow { background: #ffd343; bottom: 21%; right: 12%; box-shadow: 0 0 16px #ffd34340; }.orbit-cross { position: absolute; font: 18px var(--font-mono); color: var(--home-soft); opacity: .45; }.cross-top { right: 21%; top: 8%; }.cross-bottom { left: 16%; bottom: 12%; }
  .python-logo-wrap { position: relative; width: 242px; transform: translateY(-8px); z-index: 1; }.python-logo { display: block; width: 100%; height: auto; filter: drop-shadow(0 22px 25px #172c4029); }.home-motion .python-logo-wrap { animation: logo-float 7s ease-in-out infinite; }
  .hero-tag { position: absolute; z-index: 2; font: 9px var(--font-mono); padding: 12px 15px; background: var(--color-surface); color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: 7px; display: flex; align-items: center; gap: 9px; box-shadow: var(--card-shadow); white-space: nowrap; }.tag-icon { font-size: 15px; color: var(--home-yellow); }.tag-ai { top: 38px; right: -7px; transform: rotate(4deg); }.tag-data { bottom: 98px; right: -20px; transform: rotate(-4deg); }.tag-data .tag-icon { color: var(--home-blue); }
  .hero-code { position: absolute; left: -35px; bottom: 20px; width: 295px; background: #122236; border: 1px solid #33495b; border-radius: 9px; transform: rotate(-4deg); z-index: 3; box-shadow: 0 20px 40px #0b17221a; overflow: hidden; }.code-tab { font: 8px var(--font-mono); color: #91abc0; display: flex; align-items: center; gap: 8px; padding: 10px 13px; border-bottom: 1px solid #33495b80; }.code-tab > span { width: 5px; height: 5px; border-radius: 50%; background: #ffd343; }.code-tab i { margin-left: auto; font-size: 7px; font-style: normal; color: #677e94; }.hero-code > code { display: block; padding: 20px 16px 22px; color: #d7e6f0; font: 11px var(--font-mono); }.code-purple { color: #c5a4f2; }.code-yellow { color: #f4cf72; }.code-blue { color: #77bbef; }.code-muted { color: #69869e; }.code-cursor { display: inline-block; vertical-align: text-bottom; height: 13px; width: 1px; background: #ffd343; margin-left: 4px; }.home-motion .code-cursor { animation: cursor-blink 1.3s steps(2, end) infinite; }.art-coordinate { position: absolute; bottom: -18px; right: 3%; font: 7px var(--font-mono); letter-spacing: 1.7px; color: var(--color-text-muted); }
  .scroll-cue { position: absolute; bottom: 31px; left: 0; display: flex; align-items: center; gap: 12px; color: var(--color-text-muted); font: 8px var(--font-mono); letter-spacing: 1.7px; }.scroll-line { height: 25px; width: 1px; background: linear-gradient(transparent, var(--home-blue)); }.scroll-cue > span:last-child { color: var(--home-blue); margin-left: 7px; }
  .possibility-strip { border-block: 1px solid var(--color-border); background: color-mix(in srgb, var(--color-surface) 55%, transparent); }.strip-content { display: flex; justify-content: space-between; align-items: center; gap: 22px; padding-block: 25px; }.strip-content > span { color: var(--color-text-secondary); font-size: 10px; line-height: 1.8; flex-shrink: 0; }.strip-content strong { font-weight: 500; color: var(--color-text-primary); }.strip-links { display: flex; gap: clamp(25px, 4vw, 65px); align-items: center; }.strip-links a { color: var(--color-text-secondary); font-size: 11px; display: flex; align-items: center; gap: 13px; }.strip-star { color: var(--home-yellow); font-size: 14px; }.strip-links a:hover { color: var(--home-blue); }
  .home-why { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; padding-block: 130px 125px; }.home-page h2 { font-size: clamp(30px, 3.3vw, 43px); line-height: 1.17; font-weight: 600; letter-spacing: -1.9px; margin: 0; }.text-soft { color: var(--home-soft); }.why-intro > p:not(.home-eyebrow), .uses-sidebar > p:not(.home-eyebrow) { color: var(--color-text-secondary); font-size: 13px; line-height: 1.95; max-width: 345px; margin: 26px 0; }.home-text-link { display: inline-flex; gap: 19px; align-items: center; font-size: 11px; color: var(--home-blue); margin-top: 3px; }.home-text-link > span { font-size: 18px; }
  .why-code { background: #122236; border: 1px solid #30495e; border-radius: 11px; overflow: hidden; box-shadow: 0 10px 30px #1021330d; }.why-code-title { display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #30495e80; padding: 14px 17px; font-size: 10px; color: #9db3c7; }.why-code-title > span:last-child { margin-left: auto; color: #6c89a0; }.small-python { background: #74b8ee1a; color: #8acafa; font: 600 10px var(--font-mono); width: 23px; height: 23px; display: grid; place-items: center; border-radius: 5px; }.why-code pre { padding: 22px; margin: 0; overflow-x: auto; color: #d0deea; font: 11px/1.9 var(--font-mono); }.why-code-output { display: flex; gap: 16px; padding: 13px 22px; border-top: 1px solid #30495e70; font: 9px var(--font-mono); color: #9bb3c8; }.why-code-output > span:first-child { color: #688398; }.output-highlight { color: #f4cf72; }
  .reasons { margin-top: 28px; }.reason { display: flex; gap: 17px; padding-block: 20px; border-bottom: 1px solid var(--color-border); }.reason:last-child { border: 0; padding-bottom: 0; }.reason > span { color: var(--home-blue); font: 10px var(--font-mono); padding-top: 2px; }.reason h3 { font-size: 14px; font-weight: 600; letter-spacing: -.2px; margin: 0 0 7px; }.reason p { color: var(--color-text-secondary); font-size: 11px; line-height: 1.8; margin: 0; max-width: 390px; }
