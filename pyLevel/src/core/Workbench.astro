---
import { catalogs, modePaths } from './catalog';
interface Props { mode?: 'classic' | 'contextual'; exerciseId: string }
const { mode = 'contextual', exerciseId } = Astro.props;
const exercises = catalogs[mode].filter(exercise => exercise.id === exerciseId);
const exercise = exercises[0];
const classic = mode === 'classic';
const briefing = exercise?.briefing;
---
<main data-mode={mode} data-exercise-id={exerciseId}>
  <div class="workbench-subbar">
    <div class="subbar-left">
      <a class="back" href={`/ejercicios/${modePaths[mode]}/`}>← Volver al listado</a>
      {!classic && briefing && (
        <button id="open-briefing-btn" class="briefing-pill-btn" type="button" aria-haspopup="dialog" aria-controls="briefing-dialog">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          <span>Contexto del problema</span>
        </button>
      )}
    </div>
    <span id="connection" role="status">Conectando ejecutor…</span>
  </div>

  <nav class="modes" aria-label="Modalidad">
    <a href="/ejercicios/clasicos/" aria-current={classic ? 'page' : undefined}>Ejercicios</a>
    <a href="/ejercicios/contextualizados/" aria-current={!classic ? 'page' : undefined}>Ejercicios contextualizados</a>
  </nav>

  <section class="intro">
    <div>
      <p class="eyebrow">{classic ? 'FUNDAMENTOS / PYTHON' : 'PROYECTOS / PYTHON'}</p>
      <h1>{classic ? 'Una función. Tu solución.' : 'Explora el proyecto. Resuelve el problema.'}</h1>
      <p>{classic ? 'Lee el enunciado, completa la función y pon a prueba tu lógica.' : 'Revisa los archivos, corrige su lógica y comprueba tu solución con pruebas.'}</p>
    </div>
    <div class="current-exercise">
      <span>{exercise.difficulty}</span>
      <strong>{exercise.title}</strong>
    </div>
  </section>

  <section class="workbench" aria-label="Proyecto Python">
    <aside class="files">
      <h2>ARCHIVOS</h2>
      <nav id="files" aria-label="Archivos del proyecto"></nav>
      <button id="reset" class="secondary">Restablecer ejercicio</button>
    </aside>
    <section class="editor-panel">
      <div class="editor-heading">
        <span id="filename">main.py</span>
        <span id="saved" role="status"></span>
      </div>
      <label class="sr-only" for="code">Código del archivo seleccionado</label>
      <textarea id="code" spellcheck="false" autocapitalize="off" autocomplete="off" wrap="off"></textarea>
      <div class="toolbar">
        <span id="level"></span>
        <button id="stop" class="secondary" disabled>Detener</button>
        <button id="test" class="secondary">Probar</button>
        <button id="run">▶ Ejecutar</button>
      </div>
    </section>
    <aside class="instructions">
      <h2 id="title"></h2>
      <details open>
        <summary>Enunciado</summary>
        <pre id="statement"></pre>
      </details>
      <details>
        <summary>Salida esperada</summary>
        <pre id="expected"></pre>
      </details>
    </aside>
    <section class="console">
      <div>
        <h2>CONSOLA</h2>
        <span id="result" role="status">Listo para ejecutar</span>
      </div>
      <pre id="output" tabindex="0">Selecciona un archivo y comienza a explorar.</pre>
    </section>
  </section>
  <footer>{classic ? 'Completa la función siguiendo las reglas del enunciado.' : 'Los proyectos contienen errores intencionales. Puedes editar todos sus archivos.'} Las pruebas públicas permiten comprobar tu trabajo; no constituyen una evaluación final.</footer>

  <!-- Context / Briefing Modal for Contextualized Exercises -->
  {!classic && briefing && (
    <dialog id="briefing-dialog" class="briefing-dialog" aria-labelledby="briefing-title">
      <div class="briefing-card-container">
        <!-- Header -->
        <header class="briefing-header">
          <div class="briefing-tags">
            <span class="briefing-badge">PROYECTO CONTEXTUALIZADO</span>
            <span class="briefing-difficulty">{exercise.difficulty}</span>
            <span class="briefing-topic">{exercise.topics.join(' · ')}</span>
          </div>
          <div class="briefing-title-row">
            <h2 id="briefing-title">{exercise.title}</h2>
            <button id="close-briefing-x" class="close-x-btn" type="button" aria-label="Cerrar ventana de contexto">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <p class="briefing-lead">{exercise.description}</p>
        </header>

        <!-- Body / 3 Columns -->
        <div class="briefing-body">
          <!-- 1. Situación y Contexto -->
          <section class="briefing-card card-situation">
            <div class="card-title-row">
              <div>
                <h3>1. Contexto y Situación</h3>
                <span class="card-subtitle">El problema en el entorno real</span>
              </div>
            </div>
            <p class="situation-text">{briefing.situacion}</p>
            <div class="question-callout">
              <div class="q-text">
                <strong>Pregunta a responder:</strong>
                <p>{briefing.pregunta}</p>
              </div>
            </div>
          </section>

          <!-- 2. Qué se tiene -->
          <section class="briefing-card card-inventory">
            <div class="card-title-row">
              <div>
                <h3>2. Qué se tiene</h3>
                <span class="card-subtitle">Archivos y estructura recibida</span>
              </div>
            </div>
            <p class="inventory-lead">El proyecto cuenta con varios archivos ya configurados:</p>
            <div class="files-list">
              {briefing.queSeTiene.map(file => (
                <div class:list={['file-pill', { 'is-main': file.isMain }]}>
                  <div class="file-pill-top">
                    <code class="file-pill-path">{file.path}</code>
                    {file.isMain && <span class="start-tag">Punto de partida</span>}
                  </div>
                  <p class="file-pill-desc">{file.role}</p>
                </div>
              ))}
            </div>
          </section>

          <!-- 3. Qué se espera -->
          <section class="briefing-card card-expectations">
            <div class="card-title-row">
              <div>
                <h3>3. Qué se espera</h3>
                <span class="card-subtitle">Reglas y solución esperada</span>
              </div>
            </div>
            <ul class="expectations-bullets">
              {briefing.queSeEspera.map(req => (
                <li>
                  <span class="check-bullet" aria-hidden="true">•</span>
                  <span>{req}</span>
                </li>
              ))}
            </ul>
            <div class="expected-callout">
              <strong>Salida esperada resumida:</strong>
              <p>{briefing.salidaResumen}</p>
            </div>
          </section>
        </div>

        <!-- Footer -->
        <footer class="briefing-footer">
          <div class="footer-hint">
            <span>Puedes volver a consultar este contexto en cualquier momento con el botón <strong>«Contexto del problema»</strong> arriba.</span>
          </div>
          <button id="start-project-btn" class="start-project-btn" type="button">
            <span>Comenzar a resolver proyecto</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </button>
        </footer>
      </div>
    </dialog>
  )}
</main>

<script>
  import { catalogs } from './catalog';
  import { execute, type Action } from './client';
  import { restore, save } from './workspace';
  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const editor = el<HTMLTextAreaElement>('code');
  const mode = document.querySelector('main')?.dataset.mode === 'classic' ? 'classic' : 'contextual';
  const exerciseId = document.querySelector('main')?.dataset.exerciseId;
  const exercises = catalogs[mode].filter(exercise => exercise.id === exerciseId);
  let exercise = exercises[0];
  let files: Record<string, string> = {};
  let selected = 'main.py';
  let controller: AbortController | null = null;
  let online = false;

  // Briefing Dialog Interaction
  const briefingDialog = el<HTMLDialogElement>('briefing-dialog');
  const openBriefingBtn = el<HTMLButtonElement>('open-briefing-btn');
  const closeBriefingX = el<HTMLButtonElement>('close-briefing-x');
  const startProjectBtn = el<HTMLButtonElement>('start-project-btn');

  if (briefingDialog) {
    // Show briefing automatically when opening a contextualized exercise
    briefingDialog.showModal();

    startProjectBtn?.addEventListener('click', () => {
      briefingDialog.close();
      editor.focus();
    });

    closeBriefingX?.addEventListener('click', () => {
      briefingDialog.close();
    });

    openBriefingBtn?.addEventListener('click', () => {
      briefingDialog.showModal();
    });

    // Close when clicking on backdrop
    briefingDialog.addEventListener('click', (event) => {
      const rect = briefingDialog.getBoundingClientRect();
      const inDialog = (
        rect.top <= event.clientY &&
        event.clientY <= rect.top + rect.height &&
        rect.left <= event.clientX &&
        event.clientX <= rect.left + rect.width
      );
      if (!inDialog) {
        briefingDialog.close();
      }
    });
  }

  function persist() {
    el('saved').textContent = save(exercise.id, files) ? 'Guardado en este navegador' : 'No se pudo guardar; copia tus cambios';
  }
  function showFile(path: string) {
    selected = path; editor.value = files[path];
    editor.readOnly = mode === 'classic' && path.startsWith('tests/');
    el('filename').textContent = path + (editor.readOnly ? ' · solo lectura' : '');
    for (const button of el('files').querySelectorAll('button')) button.setAttribute('aria-current', String(button.dataset.path === path));
  }
  function load() {
    files = restore(exercise.id, exercise.files);
    if (mode === 'classic') {
      for (const [path, source] of Object.entries(exercise.files)) if (path.startsWith('tests/')) files[path] = source;
    }
    el('files').replaceChildren();
    for (const path of Object.keys(files).sort()) {
      const button = document.createElement('button'); button.textContent = path; button.dataset.path = path;
      button.addEventListener('click', () => showFile(path)); el('files').append(button);
    }
    el('title').textContent = exercise.title; el('level').textContent = exercise.difficulty;
    el('statement').textContent = exercise.statement; el('expected').textContent = exercise.expected;
    el('output').textContent = mode === 'classic' ? 'Completa la función y ejecuta el ejemplo o las pruebas públicas.' : 'Ejecuta main.py para reproducir el problema o prueba el proyecto.';
    el('result').textContent = 'Listo para ejecutar'; el('saved').textContent = '';
    showFile('main.py');
  }
  function controls(busy: boolean) {
    for (const id of ['run', 'test']) el<HTMLButtonElement>(id).disabled = busy || !online;
    el<HTMLButtonElement>('stop').disabled = !busy;
    el<HTMLButtonElement>('reset').disabled = busy;
  }
  async function run(action: Action) {
    controller = new AbortController(); controls(true);
    el('result').textContent = action === 'test' ? 'Ejecutando pruebas…' : 'Ejecutando programa…';
    el('output').textContent = '';
    try {
      const result = await execute({ ...files }, action, controller.signal);
      el('output').textContent = result.output || '(Sin salida)';
      const labels: Record<string, string> = { timeout: 'Tiempo máximo excedido', output_limit: 'Límite de salida excedido', cleanup_failed: 'Error de limpieza del ejecutor' };
      el('result').textContent = result.status === 'completed'
        ? (result.exit_code === 0 ? 'Finalizado · código 0' : `Finalizado con errores · código ${result.exit_code}`)
        : labels[result.status] || result.status;
    } catch (error) {
      el('result').textContent = controller.signal.aborted ? 'Ejecución cancelada' : 'No se pudo ejecutar';
      el('output').textContent = controller.signal.aborted ? 'Se solicitó detener el entorno de ejecución.' : error instanceof Error ? error.message : String(error);
    } finally { controller = null; controls(false); }
  }
  editor.addEventListener('input', () => { files[selected] = editor.value; persist(); });
  editor.addEventListener('keydown', event => {
    if (event.key === 'Tab' && !editor.readOnly) {
      event.preventDefault(); editor.setRangeText('    ', editor.selectionStart, editor.selectionEnd, 'end');
      files[selected] = editor.value; persist();
    }
  });
  el('run').addEventListener('click', () => run('run')); el('test').addEventListener('click', () => run('test'));
  el('stop').addEventListener('click', () => controller?.abort());
  el('reset').addEventListener('click', () => {
    if (confirm('¿Restablecer los archivos de este ejercicio? Se perderán tus cambios.')) {
      files = { ...exercise.files }; persist(); load();
    }
  });
  load(); controls(false);
  async function health() {
    try { const response = await fetch('/api/health'); online = response.ok && (await response.json()).status === 'online'; }
    catch { online = false; }
    el('connection').textContent = online ? '● Ejecutor conectado' : '○ Ejecutor no disponible';
    controls(controller !== null);
  }
  health(); setInterval(health, 10000);
</script>

<style>
