  :global(html.dark) .current-exercise span{color:#ffd343}
  .back{color:var(--color-text-secondary);text-decoration:none;font-size:12px;display:inline-flex;align-items:center;gap:6px;transition:color .15s}.back:hover{color:var(--color-primary)}
  .modes{display:flex;gap:28px;padding-top:24px;border-bottom:1px solid var(--color-border)}.modes a{color:var(--color-text-secondary);text-decoration:none;font-size:13px;padding:0 0 14px}.modes a[aria-current=page]{color:var(--modes-active, var(--color-primary));border-bottom:3px solid var(--modes-active, var(--color-primary));font-weight:600}.modes a:focus-visible,.back:focus-visible{outline:2px solid var(--color-primary);outline-offset:4px}.intro{gap:24px}.intro h1{max-width:650px;color:var(--color-text-primary)}@media(max-width:650px){header{flex-wrap:wrap;gap:12px;height:auto;padding:20px 0}.back{order:3;width:100%}.modes{gap:16px}.modes a{font-size:12px}.intro label{min-width:0}select{min-width:0;width:100%}}
  :global(*){box-sizing:border-box} main{max-width:1600px;margin:auto;padding:0 32px}
  .workbench-subbar{display:flex;align-items:center;justify-content:space-between;height:52px;border-bottom:1px solid var(--color-border);margin-bottom:6px}
  .subbar-left{display:flex;align-items:center;gap:18px}
  .briefing-pill-btn{display:inline-flex;align-items:center;gap:7px;background:var(--color-primary-light);border:1px solid var(--color-border);color:var(--color-primary);font-size:12px;font-weight:600;padding:5px 12px;border-radius:20px;cursor:pointer;transition:all .15s ease}
  .briefing-pill-btn:hover{filter:brightness(0.95);transform:translateY(-1px)}
  :global(html.dark) .briefing-pill-btn{background:rgba(255,211,67,0.12);border-color:rgba(255,211,67,0.35);color:#ffd343}
  :global(html.dark) .briefing-pill-btn:hover{background:rgba(255,211,67,0.22);border-color:#ffd343}
  .briefing-pill-btn .btn-icon{font-size:14px}
  .tag,.eyebrow{font-size:11px;letter-spacing:2px;color:var(--eyebrow-color, var(--color-primary));font-weight:700}#connection{margin-left:auto;font-size:12px;color:var(--color-text-muted)}
  .intro{display:flex;justify-content:space-between;align-items:center;padding:32px 0}.intro h1{font-size:36px;line-height:1.16;margin:12px 0;color:var(--color-text-primary)}.intro p:not(.eyebrow){color:var(--color-text-secondary);font-size:14px}.intro label{display:grid;gap:10px;color:var(--color-text-secondary);font-size:13px}select{max-width:100%;background:var(--card-bg);color:var(--color-text-primary);border:1px solid var(--color-border);padding:12px;border-radius:8px;min-width:280px}.workbench{display:grid;grid-template-columns:210px minmax(300px,1fr) 330px;border:1px solid #2c384c;border-radius:12px;overflow:hidden;background:#152f44}h2{font-size:12px;letter-spacing:1px;margin:0 0 20px}.workbench>section,.workbench>aside{min-width:0}.files{padding:20px 12px;border-right:1px solid #2c384c}.files h2{padding-left:8px;color:#8e9db2}.files nav{display:grid;gap:5px}:global(.files nav button){background:transparent;border:0;color:#a8b6ca;text-align:left;word-break:break-word;font:12px ui-monospace,monospace;padding:10px 8px}:global(.files nav button[aria-current=true]){background:#243646;color:#ffd343;border-radius:5px}.files #reset{margin-top:24px;font-size:11px}.editor-panel{min-width:0;display:flex;flex-direction:column}.editor-heading{display:flex;justify-content:space-between;gap:10px;padding:15px 18px;background:#203e56;font:12px ui-monospace,monospace}#saved{font-size:10px;color:#91a5ba}textarea{width:100%;min-height:430px;flex:1;resize:vertical;background:#152f44;color:#d8e6f7;border:0;padding:22px;font:13px/1.8 ui-monospace,SFMono-Regular,Consolas,monospace;tab-size:4;outline-offset:-3px}.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:14px;background:#1b374e}.toolbar span{margin-right:auto;font-size:12px;color:#91a5ba}button{cursor:pointer;border:0;border-radius:6px;padding:10px 15px;background:#ffd343;color:#20394d;font-weight:650}button:disabled{opacity:.4;cursor:not-allowed}button.secondary{background:#305574;color:#e6edf6}button:focus-visible,select:focus-visible{outline:2px solid #ffd343;outline-offset:2px}.instructions{padding:22px;border-left:1px solid #2c384c;max-height:540px;overflow:auto}.instructions h2{font-size:18px;letter-spacing:0}summary{cursor:pointer;font-size:13px;padding:12px 0;color:#ffd343}.instructions pre{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.8 system-ui;color:#acbbce}.console{grid-column:1/-1;border-top:1px solid #2c384c}.console>div{display:flex;justify-content:space-between;padding:16px 20px;background:#1b374e}.console h2{margin:0;color:#91a5ba}#result{font-size:12px;color:#ffd343}#output{margin:0;padding:20px;min-height:150px;max-height:300px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.8 ui-monospace,monospace}footer{padding:22px 0;color:var(--color-text-muted);font-size:12px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:1100px){.workbench{grid-template-columns:180px minmax(0,1fr)}.instructions{grid-column:1/-1;border-left:0;border-top:1px solid #2c384c;max-height:280px}.intro h1{font-size:28px}}@media(max-width:650px){main{padding:0 12px}.tag{display:none}.intro{display:block}.intro label{margin-top:24px}.workbench{grid-template-columns:1fr}.files{border-right:0;border-bottom:1px solid #2c384c}.files nav{display:flex;overflow:auto}:global(.files nav button){white-space:nowrap}.files #reset{margin-top:10px}.editor-heading{flex-wrap:wrap}textarea{min-height:350px}.toolbar{flex-wrap:wrap}}

  /* Briefing Modal Styles */
  .briefing-dialog {
    border: none;
    padding: 0;
    background: transparent;
    max-width: 1040px;
    width: min(1040px, calc(100vw - 32px));
    max-height: 90vh;
    border-radius: 18px;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.7);
    overflow: hidden;
  }
  .briefing-dialog::backdrop {
    background: rgba(7, 16, 26, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .briefing-card-container {
    background: #142334;
    color: #e6edf6;
    border: 1px solid #2a435c;
    border-radius: 18px;
    display: flex;
    flex-direction: column;
    max-height: 90vh;
    overflow: hidden;
  }

  /* Briefing Header */
  .briefing-header {
    padding: 24px 28px 18px;
    background: #182a3e;
    border-bottom: 1px solid #283e54;
  }
  .briefing-tags {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }
  .briefing-badge {
    font-size: 10px;
    letter-spacing: 1.5px;
    font-weight: 700;
    color: #ffd343;
    background: rgba(255, 211, 67, 0.12);
    padding: 3px 8px;
    border-radius: 5px;
  }
  .briefing-difficulty {
    font-size: 11px;
    font-weight: 700;
    color: #38bdf8;
  }
  .briefing-topic {
    font-size: 11px;
    color: #8da6bd;
  }
  .briefing-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .briefing-title-row h2 {
    margin: 0;
    font-size: 24px;
    font-weight: 750;
    letter-spacing: -0.5px;
    color: #f1f6fa;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .briefing-emoji {
    font-size: 24px;
  }
  .close-x-btn {
    border: none;
    background: rgba(255, 255, 255, 0.08);
    color: #cbdce8;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: grid;
    place-items: center;
    font-size: 16px;
    cursor: pointer;
    transition: all .15s ease;
  }
  .close-x-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff;
  }
  .briefing-lead {
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: #a3bad0;
  }

  /* Briefing Body Grid */
  .briefing-body {
    padding: 24px 28px;
    overflow-y: auto;
    display: grid;
    grid-template-columns: 1.15fr 1.05fr 1.1fr;
    gap: 20px;
    align-items: stretch;
  }

  .briefing-card {
    background: #192e42;
    border: 1px solid #29455f;
    border-radius: 14px;
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
  }
  .card-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid #2a4660;
  }
  .card-icon {
    font-size: 20px;
  }
  .card-title-row h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: #ffd343;
    letter-spacing: -0.2px;
  }
  .card-subtitle {
    display: block;
    font-size: 10px;
    color: #8da4b9;
    margin-top: 1px;
  }

  /* Situation Card */
  .situation-text {
