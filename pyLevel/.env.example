# Base local. Railway recibe DATABASE_URL mediante una referencia al servicio Postgres.
DATABASE_URL="postgresql://postgres:tu_password@127.0.0.1:5432/pylevel_db"
# Prioridad: DATABASE_URL > PG* > DB*. No hace falta definir los tres grupos.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=tu_password
# PGDATABASE=pylevel_db

# Automático: sin TLS en loopback, require en *.railway.internal, verify-full fuera.
# disable/false: solo loopback o red privada de Railway.
# require: TLS compatible con el certificado autofirmado de la plantilla Railway.
# verify-full/true: TLS con validación de certificado y nombre de servidor.
# DB_SSL=verify-full
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
DB_POOL_MAX=5

# URL pública exacta de PyLevel antes de compilar para producción (HTTPS).
# APP_ORIGIN=https://pylevel.example.com
# Escuchar en todas las interfaces dentro del contenedor de Railway.
# HOST=0.0.0.0
# Railway proporciona PORT automáticamente.

# Desarrollo local; en producción apunta al ejecutor de Python alojado en Azure.
# PYLEVEL_RUNNER_URL=http://127.0.0.1:8787
# Producción: https://runner.pylevel.site, con la misma credencial privada que Azure.
# PYLEVEL_RUNNER_TOKEN=clave_privada_de_al_menos_32_caracteres
RUNNER_REQUESTS_PER_MINUTE=20
RUNNER_REQUESTS_PER_DAY=200

# Solo en el servidor de Railway; nunca usar prefijo PUBLIC_ para la clave.
# GEMINI_API_KEY=tu_clave_privada
PYBOT_REQUESTS_PER_MINUTE=10
PYBOT_REQUESTS_PER_DAY=100

