# ==========================================
# Configuración de Base de Datos PostgreSQL
# ==========================================

# URL de conexión completa (ideal para ORMs como Drizzle, Prisma, etc.)
# Formato: postgresql://[usuario]:[contraseña]@[host]:[puerto]/[nombre_bd]
DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/pylevel_db?schema=public"

# Parámetros individuales (para clientes como 'pg', node-postgres o Python)
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="tu_password"
DB_NAME="pylevel_db"
DB_SSL="false"
# Tamaño del pool (5 por defecto; la suite Playwright fija 1 para PGlite).
# DB_POOL_MAX=5

# Variables de entorno estándar de PostgreSQL (compatibles con libpq / CLI de postgres)
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="tu_password"
PGDATABASE="pylevel_db"



# URL pública exacta antes de compilar para producción (HTTPS).
# APP_ORIGIN=https://pylevel.example.com
# Ejecutor de Python accesible desde el servidor de Astro.
# PYLEVEL_RUNNER_URL=http://127.0.0.1:8787

